# OCR & ASR Service 环境变量示例
# 部署时复制为 .env 并填入真实值. 切勿把含真实密钥的 .env 提交到 git.

# ========== 必填 ==========
# 接口鉴权令牌: 调用方请求头 X-Internal-Token 必须与此一致 (自己随机生成一串即可)
INTERNAL_TOKEN=

# 火山方舟 ARK (豆包) - OCR 视觉识别 + 会议纪要大模型共用
# 控制台: https://console.volcengine.com/ark  (开通后拿 API Key)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 视觉 OCR 模型 ID (默认豆包 1.5 vision pro; 按控制台开通的视觉模型填)
OCR_VISION_MODEL_ID=doubao-1-5-vision-pro-32k-250115
# 会议纪要/行动建议用的文本大模型 ID (只用 OCR/ASR 可不填; 用纪要功能必填)
ARK_MODEL_ID=

# ========== 语音识别 ASR (火山引擎大模型流式语音, 不用语音可全部留空并设 ENABLED=false) ==========
# 控制台: https://console.volcengine.com/speech  (大模型流式语音识别 sauc)
VOLC_ASR_ENABLED=false
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_TOKEN=
VOLC_ASR_SECRET_KEY=
VOLC_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
VOLC_ASR_MODEL_NAME=bigmodel

# ========== 可选 (一般用默认即可) ==========
PORT=8003
LOG_LEVEL=INFO
LLM_REASONING_EFFORT=minimal
# ASR 音频参数 (与 ffmpeg 转码对齐, 非必要不要改)
VOLC_ASR_SAMPLE_RATE=16000
VOLC_ASR_BITS=16
VOLC_ASR_CHANNEL=1
VOLC_ASR_FORMAT=pcm
VOLC_ASR_CODEC=raw
VOLC_ASR_ENABLE_PUNC=true
VOLC_ASR_MAX_FILE_SIZE_BYTES=6291456
VOLC_ASR_CHUNK_SIZE_BYTES=3200
VOLC_ASR_CONNECT_TIMEOUT_MS=10000
VOLC_ASR_READ_TIMEOUT_MS=60000
# 本机 ffmpeg 绝对路径 (装了但不在 PATH 时填; Docker 内无需填)
# FFMPEG_BIN=
