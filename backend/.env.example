# Backend local-dev secrets template (safe to commit; placeholder values only).
# Usage: copy to backend/.env and fill in real values; dev-start.ps1 auto-loads it.
# backend/.env is gitignored so real secrets never enter version control.
# English comments only (PowerShell 5.1 Get-Content mis-decodes UTF-8 Chinese).

# Database password (application.yml uses ${DB_PASSWORD}; missing = backend won't start)
DB_PASSWORD=your-db-password

# JWT signing key (HS256, >=256bit random string; missing = backend won't start)
JWT_SECRET=change-me-to-a-random-secret-at-least-256-bits-long

# Doubao ASR (audio recognition); empty = feature disabled (does not block startup)
DOUBAO_ASR_APP_KEY=
DOUBAO_ASR_ACCESS_TOKEN=
DOUBAO_ASR_SECRET_KEY=

# Doubao LLM (Ark)
DOUBAO_LLM_API_KEY=

# OCR internal service token
OCR_SERVICE_TOKEN=

# Volc TOS object storage
STORAGE_TOS_ACCESS_KEY=
STORAGE_TOS_SECRET_KEY=

# Meeting todo -> external ticket system
EXTERNAL_TICKET_ENABLED=false
EXTERNAL_TICKET_BASE_URL=https://communityhub.slaicreativity.com
EXTERNAL_TICKET_UID=
EXTERNAL_TICKET_COMMUNITY_CODE=COMM_BL
EXTERNAL_TICKET_REPORTER_NAME=业委会会议
