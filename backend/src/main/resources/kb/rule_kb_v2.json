[
  {
    "field": "金额",
    "type": "regex",
    "patterns": [
      "\\d+(\\.\\d+)?\\s*万元",
      "\\d+(\\.\\d+)?\\s*万",
      "\\d+(\\.\\d+)?\\s*元",
      "预算[为是约大概]*\\s*\\d+(\\.\\d+)?",
      "报价[为是约大概]*\\s*\\d+(\\.\\d+)?",
      "费用[为是约大概]*\\s*\\d+(\\.\\d+)?"
    ],
    "examples": [
      "预算15万元",
      "报价为8.6万",
      "维修费用30000元"
    ]
  },
  {
    "field": "时间",
    "type": "regex",
    "patterns": [
      "\\d{4}年\\d{1,2}月\\d{1,2}日",
      "\\d{1,2}月\\d{1,2}日",
      "\\d{1,2}月底前",
      "本月底",
      "下周",
      "一周内",
      "三天内",
      "尽快",
      "月底前"
    ],
    "examples": [
      "6月20日前完成",
      "月底前整改",
      "一周内处理"
    ]
  },
  {
