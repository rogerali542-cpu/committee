<view class="tab-bar">
  <view class="tab-item {{selected===0?'active':''}}" bindtap="switchTab" data-index="0" data-path="/pages/community-home/community-home">
    <text class="tab-icon">🏠</text>
    <text class="tab-text">小区首页</text>
  </view>
  <view class="tab-item {{selected===1?'active':''}}" bindtap="switchTab" data-index="1" data-path="/pages/main/main">
    <text class="tab-icon">🏛️</text>
    <text class="tab-text">业委专区</text>
  </view>
  <view class="tab-item {{selected===2?'active':''}}" bindtap="switchTab" data-index="2" data-path="/pages/profile/profile">
    <text class="tab-icon">👤</text>
    <view wx:if="{{unread>0}}" class="tab-badge">{{unread>99?'99+':unread}}</view>
    <text class="tab-text">个人中心</text>
  </view>
</view>
