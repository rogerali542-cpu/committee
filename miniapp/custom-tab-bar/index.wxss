.tab-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  height: 56px;
  background: #fff;
  display: flex;
  border-top: 1px solid #f0f0f0;
  padding-bottom: env(safe-area-inset-bottom);
}
.tab-item {
  flex: 1; position: relative;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 3px;
}
.tab-icon { font-size: 44rpx; }
.tab-text { font-size: 26rpx; color: #999; }
.tab-item.active .tab-text { color: #FFA800; font-weight: 600; }
.tab-badge {
  position: absolute; top: 4px; right: 50%; margin-right: -24px;
  min-width: 18px; height: 18px; line-height: 18px; text-align: center;
  background: #E74C3C; color: #fff; font-size: 26rpx; font-weight: 700;
  border-radius: 9px; padding: 0 5px;
}
