.page { min-height: 100vh; background: #f5f5f5; padding: 12px; }

.hd-card {
  background: #fff; border-radius: 14px; padding: 16px;
  margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.hd-title { font-size: 17px; font-weight: 700; color: #333; display: block; }
.hd-sub { font-size: 12px; color: #999; display: block; margin-top: 6px; }
.hd-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
.hd-tag { font-size: 11px; color: #B8860B; background: #FFF3DC; border-radius: 8px; padding: 2px 9px; }

.sec {
  background: #fff; border-radius: 14px; padding: 14px;
  margin-bottom: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.sec-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
.sec-title { font-size: 13px; font-weight: 600; color: #888; display: block; margin-bottom: 8px; }
.sec-head .sec-title { margin-bottom: 0; }
.sec-action { font-size: 12px; color: #FFA800; font-weight: 700; background: #FFF6E5; border-radius: 12px; padding: 3px 9px; flex-shrink: 0; }
.sec-text { font-size: 14px; color: #444; line-height: 1.6; }

.doc-row {
  display: flex; align-items: center; gap: 8px;
  padding: 10px; background: #fafafa; border: 1px solid #f0f0f0;
  border-radius: 10px; margin-top: 6px;
}
.doc-icon {
  width: 34px; height: 26px; border-radius: 7px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: #f0f0f0; color: #777; font-size: 9px; font-weight: 700;
}
.doc-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.doc-name { flex: 1; font-size: 13px; color: #444; word-break: break-all; }
.doc-meta { font-size: 11px; color: #999; line-height: 1.4; }
.doc-size { font-size: 11px; color: #aaa; }
.doc-arrow { font-size: 16px; color: #B8860B; }
.doc-row.supplement { background: #FFFDF7; border-color: #FFE8B8; }
.empty-line { display: block; font-size: 12px; color: #aaa; padding: 8px 0 2px; }

/* 归档管理 */
.life-state { display: block; font-size: 13px; color: #444; font-weight: 600; }
.life-reason { display: block; font-size: 12px; color: #E67E22; margin-top: 4px; }
.life-hint { display: block; font-size: 12px; color: #999; margin-top: 4px; line-height: 1.5; }
.life-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.life-actions .btn { margin: 0; }
.life-log { margin-top: 14px; border-top: 1px solid #f0f0f0; padding-top: 10px; }
.life-log-title { display: block; font-size: 12px; color: #999; margin-bottom: 6px; }
.life-log-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; padding: 4px 0; }
.llr-action { font-size: 12px; color: #E74C3C; font-weight: 600; }
.llr-meta { font-size: 11px; color: #bbb; }
.llr-reason { font-size: 12px; color: #666; width: 100%; }
