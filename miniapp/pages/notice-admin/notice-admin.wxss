.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 80rpx;
}

/* ── 顶部 ── */
.page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.page-sub {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}
.head-btn {
  background: #FFA800;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 0 36rpx;
  margin: 0;
  line-height: 2.4;
}
.head-btn::after { border: none; }

/* ── 公告卡片 ── */
.notice-list { display: flex; flex-direction: column; gap: 24rpx; }
.notice-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04);
}
.nc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.nc-date { font-size: 26rpx; color: #666; }
.nc-status {
  font-size: 26rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 40rpx;
}
.nc-status.on  { background: #E8F8EF; color: #27AE60; }
.nc-status.off { background: #f0f0f0; color: #666; }
.nc-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.45;
}
.nc-detail {
  display: block;
  font-size: 30rpx;
  color: #555;
  line-height: 1.6;
  margin-top: 12rpx;
}
.nc-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 28rpx;
}

.empty-emoji { font-size: 80rpx; margin-bottom: 20rpx; }

/* ── 弹窗 ── */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.form-sheet {
  width: 100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  max-height: 88vh;
  overflow-y: auto;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.sheet-title { font-size: 36rpx; font-weight: 700; color: #1a1a1a; }
.sheet-close { font-size: 52rpx; color: #999; line-height: 1; padding: 0 12rpx; }

.form-group { margin-bottom: 32rpx; }
.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}
.form-input {
  background: #f6f6f8;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  font-size: 32rpx;
  color: #1a1a1a;
}
.form-textarea {
  background: #f6f6f8;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  font-size: 32rpx;
  color: #1a1a1a;
  width: 100%;
  min-height: 240rpx;
  height: 240rpx;
}
.picker-field {
  background: #f6f6f8;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  font-size: 32rpx;
  color: #1a1a1a;
}
.input-placeholder { color: #999; }

.form-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 16rpx;
}
.form-hint {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

.sheet-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}
.sheet-actions .btn { flex: 1; line-height: 2.6; font-size: 32rpx; }
