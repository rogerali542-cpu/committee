.page { min-height: 100vh; background: #f5f5f5; padding: 12px; padding-bottom: 80px; }

/* 头部 */
.detail-head {
  background: #fff; border-radius: 14px; padding: 16px; margin-bottom: 10px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
}
.dh-title { font-size: 16px; font-weight: 700; color: #333; line-height: 1.4; flex: 1; }

/* 信息卡片 */
.info-card { background: #fff; border-radius: 14px; padding: 14px 16px; margin-bottom: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
.field-row {
  display: flex; align-items: flex-start; gap: 12px;
  padding: 10px 0; border-bottom: 1px solid #f5f5f5;
}
.field-row:last-child { border-bottom: none; }
.field-label { font-size: 13px; color: #999; width: 64px; flex-shrink: 0; line-height: 1.5; }
.field-val { font-size: 14px; color: #333; flex: 1; line-height: 1.5; }
.field-val.tag {
  font-size: 11px; font-weight: 600; padding: 2px 10px; border-radius: 8px;
  display: inline-block; width: auto; flex: none;
}
.field-val.tag.internal { background: #F5EEF8; color: #9B59B6; }
.field-val.tag.street { background: #EBF5FB; color: #2980B9; }
.field-val.tag.special { background: #FDF2E9; color: #E67E22; }

/* 进度卡片 */
.progress-card { background: #fff; border-radius: 14px; padding: 14px; margin-bottom: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
.pr-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.pr-label { font-size: 12px; color: #888; }
.pr-pct { font-size: 14px; font-weight: 700; color: #9B59B6; }
.pr-bar { background: #f0f0f0; border-radius: 4px; height: 8px; overflow: hidden; }
.pr-fill { height: 100%; border-radius: 4px; background: linear-gradient(90deg, #BB8FCE, #9B59B6); }

/* 内容说明 */
.content-card { background: #fff; border-radius: 14px; padding: 14px 16px; margin-bottom: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
.cc-label { font-size: 12px; color: #999; display: block; margin-bottom: 8px; }
.cc-text { font-size: 14px; color: #444; line-height: 1.8; }

/* 签到 */
.sign-card { background: #fff; border-radius: 14px; padding: 14px 16px; margin-bottom: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
.sign-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.sign-title { font-size: 13px; font-weight: 600; color: #333; }
.sign-stat { font-size: 12px; color: #9B59B6; font-weight: 600; }
.sign-stat.ok { color: #27AE60; }
.sign-list { display: flex; flex-direction: column; gap: 2px; margin-bottom: 6px; }
.sign-row { display: flex; align-items: center; justify-content: space-between; padding: 6px 8px; border-radius: 6px; }
.sign-row.done { background: #f9f9f9; }
.sign-name { font-size: 13px; color: #333; }
.sign-status { font-size: 11px; font-weight: 600; }
.sign-status.ok { color: #27AE60; }
.sign-status.wait { color: #ccc; }
.sign-my { padding-top: 8px; border-top: 1px solid #f0f0f0; text-align: center; }
.btn-signin {
  width: 100%; height: 42px; line-height: 42px; border-radius: 21px;
  background: #fff; color: #9B59B6; border: 1px solid #9B59B6;
  font-size: 14px; font-weight: 600; margin: 0;
}
.btn-signin::after { border: none; }

/* 佐证 */
.ev-card { background: #fff; border-radius: 14px; padding: 14px 16px; margin-bottom: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
.ev-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.ev-title { font-size: 13px; font-weight: 600; color: #333; }
.ev-add { font-size: 13px; color: #9B59B6; font-weight: 600; }
.ev-list { display: flex; flex-direction: column; gap: 4px; }
.ev-item { display: flex; align-items: center; justify-content: space-between; padding: 8px 10px; background: #fafafa; border-radius: 8px; font-size: 13px; color: #444; }
.ev-name { flex: 1; min-width: 0; word-break: break-all; }
.ev-del { font-size: 16px; color: #ccc; margin-left: 8px; flex-shrink: 0; }
.ev-empty { font-size: 12px; color: #ccc; text-align: center; padding: 8px 0; }

/* 操作区 */
.action-card { background: #fff; border-radius: 14px; padding: 16px; margin-bottom: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); text-align: center; }
.ac-hint { font-size: 13px; color: #999; display: block; margin-bottom: 14px; }
.btn-primary {
  width: 100%; height: 48px; line-height: 48px; border-radius: 24px;
  background: linear-gradient(135deg, #BB8FCE, #9B59B6); color: #fff;
  font-size: 15px; font-weight: 600; border: none; margin: 0;
}
.btn-primary.finish { background: linear-gradient(135deg, #5DADE2, #2E86C1); }
.btn-primary::after { border: none; }

/* 无权限 / 已完成 */
.perm-note {
  background: #FFF8E8; border: 1px solid #FFE0A3; border-radius: 12px;
  padding: 12px 14px; margin-bottom: 10px;
  font-size: 13px; color: #9A7600; text-align: center;
}
.done-card {
  background: #E8F7EE; border-radius: 14px; padding: 20px;
  text-align: center; margin-bottom: 10px;
}
.done-text { font-size: 14px; color: #27AE60; font-weight: 600; }

/* 删除 */
.delete-area { text-align: center; padding: 16px 0; }
.delete-link { font-size: 13px; color: #E74C3C; }

/* 复用 */
.empty-state { padding: 40px; text-align: center; color: #ccc; font-size: 13px; }
.stage-pill { font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px; white-space: nowrap; }
.stage-pill.preparing { background: #FFF3E0; color: #E67E22; }
.stage-pill.ongoing { background: #EBF5FB; color: #2980B9; }
.stage-pill.ended { background: #F0F0F0; color: #888; }
