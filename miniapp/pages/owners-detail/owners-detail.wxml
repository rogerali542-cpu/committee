<scroll-view scroll-y class="page">
  <view wx:if="{{detail}}">
    <!-- 基本信息 -->
    <view class="info-card">
      <view class="info-row"><text class="k">📅</text>{{detail.meetingDate}} {{detail.meetingTime}}</view>
      <view class="info-row"><text class="k">📍</text>{{detail.location}}</view>
      <view class="info-row"><text class="k">👥</text>{{detail.totalOwners}} 户 · {{detail.areaWan}} 万m²</view>
      <view class="info-row"><text class="k">📋</text>{{detail.description || '（无）'}}</view>
    </view>

    <!-- ══════ 准备阶段：主席视图 ══════ -->
    <block wx:if="{{userView === 'chair' && detail.stage === 'preparing'}}">
      <!-- 通知草稿 -->
      <view class="notice-draft-card" wx:if="{{detail.noticeDraft}}">
        <view class="nd-head">
          <text class="nd-title">会议通知草稿</text>
          <text class="nd-status">待确认</text>
        </view>
        <text class="nd-content">{{detail.noticeDraft.content}}</text>
        <text class="nd-edit-btn" bindtap="editNoticeDraft">编辑通知</text>
      </view>

      <!-- 会前通知（15日） -->
      <view class="notice-block card" wx:if="{{detail.notifyInfo}}">
        <view class="notice-banner {{detail.notifyInfo.pct >= 100 && detail.notifyInfo.announced ? 'done' : (detail.notifyInfo.daysLeft < 0 ? 'overdue' : (detail.notifyInfo.daysLeft <= 3 ? 'urgent' : 'normal'))}}">
          <text>{{detail.notifyInfo.pct >= 100 && detail.notifyInfo.announced ? '✓ 通知已覆盖' : detail.notifyInfo.daysLeft < 0 ? '! 已逾期'+detail.notifyInfo.absDaysLeft+'天' : '还有'+detail.notifyInfo.daysLeft+'天'}}</text>
        </view>
        <text class="nb-sub">会前通知（须提前15日 · 截止 {{detail.notifyInfo.deadlineStr}}）</text>
        <view class="notify-stats">
          <view class="ns-item"><text class="ns-num">{{detail.totalOwners}}</text><text class="ns-label">总户数</text></view>
          <view class="ns-item"><text class="ns-num" style="color:#FFA800;">{{detail.notifyInfo.sent}}</text><text class="ns-label">已通知</text></view>
          <view class="ns-item"><text class="ns-num" style="color:{{detail.notifyInfo.pct >= 100 ? '#27AE60' : '#E74C3C'}};">{{detail.notifyInfo.pct}}%</text><text class="ns-label">覆盖率</text></view>
        </view>
        <view class="np-row">
          <text class="np-label">📨 通知覆盖</text>
          <progress percent="{{detail.notifyInfo.pct}}" stroke-width="6" activeColor="#FFA800"/>
          <text class="np-count">{{detail.notifyInfo.sent}}/{{detail.totalOwners}}</text>
        </view>
        <text class="send-all" bindtap="notifyAll" wx:if="{{detail.notifyInfo.pct < 100}}">标记全部已通知（写入通知记录）</text>
      </view>

      <!-- 会议材料 -->
      <view class="card">
        <view class="section-title-row">
          <text class="card-title">会议材料（{{detail.materials ? detail.materials.length : 0}}）</text>
          <text class="add-link" bindtap="uploadMaterial">+ 上传材料</text>
        </view>
        <view wx:if="{{detail.materials && detail.materials.length}}">
          <view wx:for="{{detail.materials}}" wx:key="name" class="mt-item" bindtap="previewMaterial" data-index="{{index}}">
            <text class="mt-name">{{item.name}}</text>
            <text class="mt-size">{{item.sizeText || ''}}</text>
            <text class="mt-arrow">›</text>
            <text class="mt-del" catchtap="removeMaterial" data-index="{{index}}">×</text>
          </view>
        </view>
        <view wx:else class="mt-empty">
          <text>暂未上传材料</text>
        </view>
      </view>

      <!-- 表决票送达（7日） -->
      <view class="card" wx:if="{{detail.needsVote && detail.ballotInfo}}">
        <text class="card-title">🗳️ 表决票送达（须提前7日）</text>
        <text class="card-deadline" style="color:{{detail.ballotInfo.pct >= 100 ? '#27AE60' : (detail.ballotInfo.daysLeft < 0 ? '#E74C3C' : '#888')}};">
          {{detail.ballotInfo.pct >= 100 ? '已全部送达' : (detail.ballotInfo.daysLeft < 0 ? '已逾期'+(-detail.ballotInfo.daysLeft)+'天' : '截止 '+detail.ballotInfo.deadlineStr+' · 剩'+detail.ballotInfo.daysLeft+'天')}}
        </text>
        <view class="np-row">
          <text class="np-label">📨 送达进度</text>
          <progress percent="{{detail.ballotInfo.pct}}" stroke-width="6" activeColor="#2980B9"/>
          <text class="np-count">{{detail.ballotInfo.delivered}}/{{detail.totalOwners}}</text>
        </view>
        <text class="send-all blue" bindtap="ballotAll" wx:if="{{detail.ballotInfo.pct < 100}}">标记全部已送达</text>
        <view class="toggle-row">
          <text>📑 送达记录、凭证完整</text>
          <switch checked="{{detail.ballotInfo.recordsComplete}}" color="#FFA800" bindchange="toggleBallot" data-field="records"/>
        </view>
        <view class="toggle-row">
          <text>📢 非当面送达公告</text>
          <switch checked="{{detail.ballotInfo.nonFaceAnnounce}}" color="#FFA800" bindchange="toggleBallot" data-field="nonFaceAnnounce"/>
        </view>
      </view>

      <view class="card" wx:if="{{!detail.needsVote}}" style="background:#F4F6F7;">
        <text style="color:#888;">ℹ️ 本次大会无表决事项，无需送达表决票</text>
      </view>

      <view class="action-row">
        <button class="btn btn-ghost" size="mini" bindtap="removeMeeting">取消</button>
        <button class="btn btn-ghost" size="mini" bindtap="openEdit">编辑</button>
        <button class="btn {{detail.notifyInfo.pct >= 100 ? 'btn-primary' : 'btn-disabled'}}" size="mini" bindtap="advance" data-action="start">开始大会</button>
      </view>
    </block>

    <!-- ══════ 准备阶段：业主视图 ══════ -->
    <block wx:if="{{userView === 'owner' && detail.stage === 'preparing'}}">
      <view class="my-card" wx:if="{{detail.notifyInfo}}">
        <text class="my-title">📨 业主大会通知</text>
        <text class="my-status {{detail.notifyInfo.pct >= 100 ? 'ok' : ''}}">{{detail.notifyInfo.pct >= 100 ? '通知已发布，等待大会开始' : '通知发布中，请关注公告'}}</text>
        <text class="my-meta">已覆盖 {{detail.notifyInfo.sent}}/{{detail.totalOwners}} 户（{{detail.notifyInfo.pct}}%）</text>
      </view>

      <view class="my-card" wx:if="{{detail.noticeDraft && detail.notifyInfo.pct >= 100}}">
        <text class="my-title">会议通知</text>
        <text class="my-content">{{detail.noticeDraft.content}}</text>
      </view>

      <view class="my-card" wx:if="{{detail.materials && detail.materials.length}}">
        <text class="my-title">📎 会议材料（{{detail.materials.length}}份）</text>
        <view wx:for="{{detail.materials}}" wx:key="name" class="mt-item" bindtap="previewMaterial" data-index="{{index}}">
          <text class="mt-name">{{item.name}}</text>
          <text class="mt-size">{{item.sizeText || ''}}</text>
          <text class="mt-arrow">›</text>
        </view>
      </view>

      <view class="my-card" wx:if="{{detail.needsVote && detail.ballotInfo}}">
        <text class="my-title">🗳️ 表决票</text>
        <text class="my-status {{detail.ballotInfo.pct >= 100 ? 'ok' : ''}}">{{detail.ballotInfo.pct >= 100 ? '表决票已全部送达' : '表决票送达中'}}</text>
        <text class="my-meta">已送达 {{detail.ballotInfo.delivered}}/{{detail.totalOwners}} 户</text>
      </view>
    </block>

    <!-- ══════ 进行中：进入「大会进行」向导页 ══════ -->
    <block wx:if="{{userView === 'owner' && detail.stage === 'ongoing' && detail.recordInfo}}">
      <view class="live-entry" bindtap="enterLive">
        <view class="live-entry-main">
          <text class="live-entry-title">大会进行中</text>
          <text class="live-entry-sub" wx:if="{{quickMode}}">快速会议·全程录音生成纪要，点击进入</text>
          <text class="live-entry-sub" wx:elif="{{!detail.needsVote}}">本次大会无需投票</text>
          <text class="live-entry-sub" wx:elif="{{!detail.isRepresentative}}">你不是户代表，点击查看表决进展</text>
          <text class="live-entry-sub" wx:elif="{{detail.ownerAllVoted}}">你的投票已完成，点击查看</text>
          <text class="live-entry-sub" wx:else>还有 {{detail.ownerVoteTotal - detail.ownerVoteDoneCount}} 项待表决，点击进入投票</text>
        </view>
        <text class="live-entry-arrow">进入 ›</text>
      </view>
    </block>

    <!-- ══════ 进行中：主席管理 ══════ -->
    <block wx:if="{{userView === 'chair' && detail.stage === 'ongoing' && detail.recordInfo}}">
      <view class="live-entry" bindtap="enterLive">
        <view class="live-entry-main">
          <text class="live-entry-title">大会进行中</text>
          <text class="live-entry-sub">按引导主持：出席核验 → 逐项表决 → 结束公示</text>
        </view>
        <text class="live-entry-arrow">进入 ›</text>
      </view>
      <!-- 我的投票（主任本人也是户代表时，可给自己所代表的户投票；快速模式无逐项表决，隐藏） -->
      <view class="card" wx:if="{{!quickMode && detail.needsVote && detail.isRepresentative && detail.ownerVoteTotal > 0}}">
        <text class="card-title">🗳️ 我的投票（代表 {{detail.myUnits.length}} 户）</text>
        <text style="font-size:11px;color:#999;display:block;margin-bottom:6px;">你本人作为户代表的投票，与下方会议管理操作互不影响。</text>
        <view wx:for="{{detail.recordInfo.topics}}" wx:key="id" style="padding:8px 0;border-bottom:1px solid #f5f5f5;">
          <text style="font-size:13px;font-weight:600;display:block;">{{index+1}}. {{item.title}}</text>
          <view wx:if="{{item.myChoiceLabel}}" class="self-voted">已投：{{item.myChoiceLabel}}</view>
          <view wx:else class="vote-btns">
            <text class="vbtn for" bindtap="submitVote" data-topic-id="{{item.id}}" data-choice="for">同意</text>
            <text class="vbtn ag" bindtap="submitVote" data-topic-id="{{item.id}}" data-choice="against">不同意</text>
            <text class="vbtn ab" bindtap="submitVote" data-topic-id="{{item.id}}" data-choice="abstain">弃权</text>
          </view>
        </view>
        <text class="guide-progress">已完成 {{detail.ownerVoteDoneCount}}/{{detail.ownerVoteTotal}} 项</text>
      </view>

      <!-- 实时投票概况（快速模式无逐项表决，隐藏） -->
      <view class="card" wx:if="{{!quickMode}}">
        <text class="card-title">📊 实时投票概况</text>
        <view wx:for="{{detail.recordInfo.topics}}" wx:key="id" style="padding:8px 0;border-bottom:1px solid #f5f5f5;">
          <text style="font-size:13px;font-weight:600;display:block;">{{index+1}}. {{item.title}}</text>
          <view class="vote-summary-row">
            <text class="vs-item">赞 {{item.forOwners}}户 / {{item.forAreaWan}}万㎡</text>
            <text class="vs-item">反 {{item.agOwners}}户 / {{item.agAreaWan}}万㎡</text>
            <text class="vs-item">弃 {{item.abOwners}}户 / {{item.abAreaWan}}万㎡</text>
          </view>
          <view class="np-row" style="margin-top:4px;">
            <text class="np-label">户数</text>
            <progress percent="{{item.pctForOwners + item.pctAgOwners + item.pctAbOwners}}" stroke-width="4" activeColor="#FFA800"/>
            <text class="np-count">{{item.forOwners + item.agOwners + item.abOwners}}/{{detail.totalOwners}}</text>
          </view>
          <view class="np-row" style="margin-top:2px;">
            <text class="np-label">面积</text>
            <progress percent="{{item.pctForArea + item.pctAgArea + item.pctAbArea}}" stroke-width="4" activeColor="#2980B9"/>
            <text class="np-count">{{item.forArea + item.agArea + item.abArea}}/{{detail.totalArea}}</text>
          </view>
        </view>
      </view>

      <!-- 代录入口（快速模式下隐藏） -->
      <view class="card" wx:if="{{!quickMode}}">
        <view style="display:flex;justify-content:space-between;align-items:center;">
          <view>
            <text class="card-title" style="margin-bottom:4px;">✍️ 线下补录</text>
            <text style="font-size:11px;color:#999;">为交纸质票的业主手动录入投票（仅限未投票户）</text>
          </view>
          <button style="background:#E67E22;color:#fff;border-radius:16px;font-size:12px;padding:6px 16px;" size="mini" bindtap="openProxyVote">补录</button>
        </view>
      </view>

      <!-- 每户投票状态 -->
      <view class="card" wx:if="{{voteStatusList && voteStatusList.length}}">
        <text class="card-title">🗳️ 每户投票状态（{{voteStatusList.length}}户）</text>
        <view style="max-height:260px;overflow-y:auto;">
          <view wx:for="{{voteStatusList}}" wx:key="unitId" class="vote-unit-row {{item.allVoted ? 'done' : ''}}">
            <view class="vu-info">
              <text class="vu-name">{{item.building}}{{item.unitNo}} {{item.representativeName}}</text>
              <text class="vu-meta">{{item.area}}㎡</text>
            </view>
            <view class="vu-status">
              <text wx:if="{{item.allVoted}}" class="vu-tag ok">✓ 已投</text>
              <text wx:else class="vu-tag no">✗ 未投</text>
              <text wx:if="{{item.votes}}" class="vu-detail" wx:for="{{item.votedTopics}}" wx:for-item="tid" wx:key="*this">
                {{item.votes[tid].proxy ? '代录' : '线上'}}
              </text>
            </view>
          </view>
        </view>
      </view>

      <!-- 双过半核查 -->
      <view class="card">
        <text class="card-title">双过半法定人数核查</text>
        <text class="quorum-status {{detail.recordInfo.quorumOk ? 'ok' : (detail.recordInfo.okOwners || detail.recordInfo.okArea ? 'partial' : 'no')}}">
          {{detail.recordInfo.quorumOk ? '✓ 双过半·达到法定人数' : (!detail.recordInfo.okOwners && !detail.recordInfo.okArea ? '人数和面积均未过半' : (detail.recordInfo.okOwners ? '人数已过半·面积未过半' : '面积已过半·人数未过半'))}}
        </text>
        <view class="qm-row">
          <text class="qm-label">到场人数</text>
          <progress percent="{{detail.recordInfo.pctOwners}}" stroke-width="6" activeColor="{{detail.recordInfo.okOwners ? '#27AE60' : '#E74C3C'}}"/>
          <text class="qm-val">{{detail.recordInfo.presentOwners}}/{{detail.totalOwners}} 户</text>
        </view>
        <view class="qm-row">
          <text class="qm-label">到场面积</text>
          <progress percent="{{detail.recordInfo.pctArea}}" stroke-width="6" activeColor="{{detail.recordInfo.okArea ? '#27AE60' : '#E74C3C'}}"/>
          <text class="qm-val">{{detail.recordInfo.presentAreaWan}}/{{detail.recordInfo.totalAreaWan}}万</text>
        </view>

        <!-- 到场登记（点击标记） -->
        <view class="card">
          <view class="section-title-row">
            <text class="card-title">📋 到场登记</text>
            <text class="add-link" bindtap="loadAttendance">刷新</text>
          </view>
          <view class="att-summary">
            <text>已到场 <text style="color:#27AE60;font-weight:700;">{{detail.recordInfo.presentOwners}}</text> 户 · 面积 <text style="color:#27AE60;font-weight:700;">{{detail.recordInfo.presentAreaWan}}</text> 万㎡</text>
          </view>
          <view wx:if="{{attendanceList && attendanceList.length}}" style="max-height:200px;overflow-y:auto;margin-top:8px;">
            <view wx:for="{{attendanceList}}" wx:key="unitId" class="att-unit {{item.present ? 'on' : ''}}" bindtap="toggleAttendance" data-unit-id="{{item.unitId}}">
              <view class="att-check">{{item.present ? '✓' : ''}}</view>
              <text class="att-name">{{item.building}}{{item.unitNo}} {{item.representativeName}}</text>
              <text class="att-area">{{item.area}}㎡</text>
            </view>
          </view>
        </view>

        <!-- 监督员签字 -->
        <view class="sv-row">
          <view class="sv-info">
            <text class="sv-label">监督员（街道办/居委会）</text>
            <text class="sv-name">{{detail.recordInfo.supervisorName}}</text>
          </view>
          <text class="fu-chip {{detail.recordInfo.supervisorSigned ? 'on' : ''}}" bindtap="toggleSupervisor">{{detail.recordInfo.supervisorSigned ? '✓ 已签字' : '签字'}}</text>
        </view>

        <!-- 投票流程 -->
        <block wx:if="{{detail.needsVote}}">
          <text class="card-title" style="margin-top:12px;">🗳️ 投票·监票·唱票·统票</text>
          <view class="proc-grid">
            <view class="proc-item {{detail.recordInfo.process.designated ? 'on' : ''}}" bindtap="toggleProcess" data-key="designated">
              <text class="proc-check">{{detail.recordInfo.process.designated ? '✓' : ''}}</text>指定时间地点投票
            </view>
            <view class="proc-item {{detail.recordInfo.process.monitor ? 'on' : ''}}" bindtap="toggleProcess" data-key="monitor">
              <text class="proc-check">{{detail.recordInfo.process.monitor ? '✓' : ''}}</text>现场监票
            </view>
            <view class="proc-item {{detail.recordInfo.process.callout ? 'on' : ''}}" bindtap="toggleProcess" data-key="callout">
              <text class="proc-check">{{detail.recordInfo.process.callout ? '✓' : ''}}</text>公开唱票
            </view>
            <view class="proc-item {{detail.recordInfo.process.tally ? 'on' : ''}}" bindtap="toggleProcess" data-key="tally">
              <text class="proc-check">{{detail.recordInfo.process.tally ? '✓' : ''}}</text>当场统票
            </view>
          </view>

          <!-- 议题表决（快速模式下隐藏：议题改由结束时录音识别+人工确认） -->
          <block wx:if="{{!quickMode}}">
          <view class="section-title-row">
            <text class="card-title" style="margin-top:12px;">议题表决（{{detail.recordInfo.topics.length}}）</text>
            <text class="add-link" bindtap="addTopic">+ 添加议题</text>
          </view>
          <view wx:for="{{detail.recordInfo.topics}}" wx:key="id" class="om-topic">
            <view class="tp-head">
              <text class="tp-type {{item.type === 'major' ? 'major' : 'ordinary'}}">{{item.type === 'major' ? '重大事项' : '普通决议'}}</text>
              <text class="tp-title">{{item.title}}</text>
            </view>
            <text class="tp-status-om {{item.passed ? 'pass' : ''}}">
              {{item.passed ? '✓ 决议通过' : '赞成户数/面积未达门槛'}}
            </text>
            <view class="dual-row">
              <text class="dual-label">按户数赞成</text>
              <progress percent="{{item.pctForOwners}}" stroke-width="5" activeColor="{{item.passOwners ? '#27AE60' : '#E74C3C'}}"/>
              <text class="dual-val">{{item.forOwners}}{{item.passOwners ? '✓' : '✕'}}</text>
            </view>
            <view class="dual-row">
              <text class="dual-label">按面积赞成</text>
              <progress percent="{{item.pctForArea}}" stroke-width="5" activeColor="{{item.passArea ? '#27AE60' : '#E74C3C'}}"/>
              <text class="dual-val">{{item.forAreaWan}}万{{item.passArea ? '✓' : '✕'}}</text>
            </view>
            <view class="vote-adj">
              <text class="va-counts">户：赞{{item.forOwners}} 反{{item.agOwners}} 弃{{item.abOwners}} | 面积：赞{{item.forAreaWan}}万 反{{item.agAreaWan}}万 弃{{item.abAreaWan}}万</text>
            </view>
          </view>
          </block>
          <view class="evidence-box">
            <view class="section-title-row">
              <text class="card-title">线下纸质佐证</text>
              <text class="add-link" bindtap="addEvidence">+ 上传</text>
            </view>
            <view wx:if="{{detail.recordInfo.evidences.length}}">
              <view class="ev-row" wx:for="{{detail.recordInfo.evidences}}" wx:key="id">
                <text>{{item.type}}</text>
                <text>{{item.name}}</text>
                <text class="tp-del" bindtap="removeEvidence" data-ev-id="{{item.id}}">×</text>
              </view>
            </view>
            <text wx:else class="ev-empty">可上传签到册、投票单、现场照片等佐证</text>
          </view>
        </block>
      </view>

      <view class="action-row">
        <button class="btn btn-ghost" size="mini" bindtap="viewOwnerMinutes">查看记录</button>
        <button class="btn {{detail.recordInfo.quorumOk ? 'btn-primary' : 'btn-danger'}}" size="mini" bindtap="advance" data-action="end">结束大会</button>
      </view>
    </block>

    <!-- ══════ 结束：业主简洁结论 ══════ -->
    <block wx:if="{{userView === 'owner' && detail.stage === 'ended'}}">
      <view class="my-card {{detail.compliance}}">
        <view style="display:flex;align-items:center;gap:12px;">
          <text style="font-size:40px;">{{detail.compliance === 'valid' ? '✓' : detail.compliance === 'invalid' ? '✕' : '!'}}</text>
          <view>
            <text style="display:block;font-size:15px;font-weight:700;">{{detail.title}}</text>
            <text style="display:block;font-size:12px;color:#888;margin-top:4px;">{{detail.meetingDate}} {{detail.meetingTime}} · {{detail.location}}</text>
            <text style="display:block;font-size:13px;margin-top:4px;">{{detail.compliance === 'valid' ? '大会有效' : detail.compliance === 'flawed' ? '有效（带说明）' : '大会无效'}} · {{detail.publishInfo && detail.publishInfo.published ? '已公示归档' : (detail.publishInfo && detail.publishInfo.withdrawn ? '已撤回公示' : (detail.compliance === 'invalid' ? '已作废' : '待公示'))}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- ══════ 结束：主席完整归档 ══════ -->
    <block wx:if="{{userView === 'chair' && detail.stage === 'ended'}}">
      <view class="ar-card {{detail.compliance}}">
        <view class="arc-head">
          <view class="arch-icon">{{detail.compliance === 'valid' ? '✓' : detail.compliance === 'flawed' ? '!' : '✕'}}</view>
          <view class="arch-info">
            <text class="arch-title">{{detail.title}}</text>
            <text class="arch-sub">{{detail.meetingDate}} {{detail.meetingTime}} · {{detail.location}}</text>
            <text class="arch-result">{{detail.compliance === 'valid' ? '大会有效' : detail.compliance === 'flawed' ? '有效（带说明）' : '大会无效'}} · {{detail.publishInfo && detail.publishInfo.published ? '已公示归档' : '待公示'}}</text>
          </view>
        </view>
        <!-- 合规判定修正 -->
        <view class="arc-fix">
          <text class="arcf-label">判定有误？</text>
          <text class="arcf-chip {{detail.compliance === 'valid' ? 'on' : ''}}" bindtap="markCompliance" data-status="valid">有效</text>
          <text class="arcf-chip {{detail.compliance === 'flawed' ? 'on' : ''}}" bindtap="markCompliance" data-status="flawed">瑕疵</text>
          <text class="arcf-chip {{detail.compliance === 'invalid' ? 'on' : ''}}" bindtap="markCompliance" data-status="invalid">无效</text>
        </view>

        <!-- 资料清单 -->
        <view class="arc-list">
          <view class="arcl-row" bindtap="editNoticeDraft" wx:if="{{detail.noticeDraft}}">
            <view class="arcl-icon notice">📄</view>
            <view class="arcl-info"><text class="arcl-name">大会通知</text><text class="arcl-meta">创建时自动生成</text></view>
            <text class="arcl-arrow">›</text>
          </view>
          <view class="arcl-row" wx:if="{{detail.notifyInfo}}">
            <view class="arcl-icon sign">📋</view>
            <view class="arcl-info"><text class="arcl-name">通知记录</text><text class="arcl-meta">{{detail.notifyInfo.sent}}/{{detail.totalOwners}} 户已通知</text></view>
          </view>
          <view class="arcl-row" wx:if="{{detail.ballotInfo}}">
            <view class="arcl-icon ballot">🗳️</view>
            <view class="arcl-info"><text class="arcl-name">表决票送达</text><text class="arcl-meta">{{detail.ballotInfo.delivered}}/{{detail.totalOwners}} 户已送达</text></view>
          </view>
          <view wx:if="{{detail.recordInfo && detail.recordInfo.topics && detail.recordInfo.topics.length}}">
            <view wx:for="{{detail.recordInfo.topics}}" wx:key="id" class="arcl-row">
              <view class="arcl-icon vote">📊</view>
              <view class="arcl-info">
                <text class="arcl-name">{{item.title}}</text>
                <text class="arcl-meta">{{item.passed ? '✓ 通过' : '✕ 未通过'}} · 赞{{item.forOwners}}户/{{item.forAreaWan}}万㎡</text>
              </view>
            </view>
          </view>
          <view class="arcl-row" wx:if="{{detail.materials && detail.materials.length}}" bindtap="previewArchiveMaterials">
            <view class="arcl-icon mat">📎</view>
            <view class="arcl-info"><text class="arcl-name">会议材料</text><text class="arcl-meta">{{detail.materials.length}} 份附件</text></view>
            <text class="arcl-arrow">›</text>
          </view>
          <view class="arcl-row" bindtap="openOwnerMinutes">
            <view class="arcl-icon min">📝</view>
            <view class="arcl-info"><text class="arcl-name">会议纪要</text><text class="arcl-meta">点击查看全文，可编辑确认</text></view>
            <text class="arcl-arrow">›</text>
          </view>
          <view class="arcl-row" wx:for="{{detail.archiveExtras}}" wx:for-item="ae" wx:key="id" wx:if="{{detail.archiveExtras && detail.archiveExtras.length}}">
            <view class="arcl-icon extra">📎</view>
            <view class="arcl-info"><text class="arcl-name">{{ae.fileName}}</text><text class="arcl-meta">补充归档</text></view>
            <text class="arcl-del" bindtap="removeArchiveExtra" data-ae-id="{{ae.id}}">×</text>
          </view>
        </view>
        <view class="arc-add" bindtap="addArchiveExtra"><text>+ 补充归档材料</text></view>
      </view>

      <!-- 公示/归档 -->
      <view class="ar-publish" wx:if="{{detail.compliance !== 'invalid'}}">
        <view wx:if="{{detail.publishInfo && detail.publishInfo.published}}" class="arp-done">
          <text class="arp-check">✓</text>
          <text>已于 {{detail.publishInfo.publishDate}} 公示{{detail.publishInfo.publishedBy ? '（' + detail.publishInfo.publishedBy + '）' : ''}}，归档完成</text>
          <view class="arp-actions">
            <text class="ar-skip" bindtap="viewMinutesRevisions">版本历史</text>
            <text class="ar-skip danger" bindtap="withdrawPublish">撤回公示</text>
          </view>
        </view>
        <view wx:elif="{{detail.publishInfo && detail.publishInfo.withdrawn}}" class="arp-done withdrawn">
          <text>⚠ 公示已撤回{{detail.publishInfo.withdrawnBy ? '（' + detail.publishInfo.withdrawnBy + '）' : ''}}{{detail.publishInfo.withdrawReason ? '：' + detail.publishInfo.withdrawReason : ''}}</text>
          <button class="btn btn-primary" style="width:100%;margin-top:8px;" bindtap="publishNow">修订后重新公示</button>
          <text class="ar-skip" bindtap="viewMinutesRevisions">版本历史</text>
        </view>
        <view wx:elif="{{detail._archived}}" class="arp-done">
          <text class="arp-check">✓</text><text>已归档（未公示）</text>
        </view>
        <block wx:else>
          <button class="btn btn-primary" style="width:100%;" bindtap="publishNow">发起公示</button>
          <text class="ar-skip" bindtap="archiveDirect">直接归档，不公示</text>
        </block>
      </view>
      <view class="ar-publish invalid" wx:else><text>大会无效，无需公示，资料留档备查</text></view>
    </block>
  </view>

  <!-- 添加议题弹窗 -->
  <view wx:if="{{topicFormVisible}}" class="modal-mask" bindtap="closeTopicForm">
    <view class="form-sheet" catchtap="noop" style="padding-bottom:calc(18px + env(safe-area-inset-bottom));">
      <view class="sheet-head">
        <text class="sheet-title">新增表决议题</text>
        <text class="sheet-close" bindtap="closeTopicForm">×</text>
      </view>
      <view class="form-group">
        <text class="form-label">议题名称 *</text>
        <input class="form-input large" value="{{newTopicForm.title}}" bindinput="onTopicInput" placeholder="请输入议题名称" placeholder-class="input-placeholder" />
      </view>
      <view class="form-group">
        <text class="form-label">议题类型</text>
        <view class="topic-type-row">
          <text class="topic-type-chip {{newTopicForm.type === 'ordinary' ? 'on' : ''}}" bindtap="pickTopicType" data-type="ordinary">普通决议</text>
          <text class="topic-type-chip {{newTopicForm.type === 'major' ? 'on' : ''}}" bindtap="pickTopicType" data-type="major">重大事项</text>
        </view>
      </view>
      <view class="sheet-actions">
        <button class="btn btn-ghost" bindtap="closeTopicForm">取消</button>
        <button class="btn btn-primary" loading="{{topicSubmitting}}" bindtap="submitTopic">确认添加</button>
      </view>
    </view>
  </view>

  <!-- 补录投票弹窗 -->
  <view wx:if="{{proxyVisible}}" class="modal-mask" bindtap="closeProxyVote">
    <view class="form-sheet proxy-sheet" catchtap="noop" style="padding-bottom:calc(18px + env(safe-area-inset-bottom));">
      <view class="sheet-head">
        <text class="sheet-title">线下补录</text>
        <text class="sheet-close" bindtap="closeProxyVote">×</text>
      </view>

      <!-- 选户 -->
      <view class="form-group">
        <text class="form-label">选择房屋</text>
        <scroll-view scroll-y style="max-height:180px;background:#f5f5f5;border-radius:10px;padding:8px;">
          <view wx:for="{{proxyUnits}}" wx:key="unitId" class="proxy-unit {{proxyUnitId === item.unitId ? 'on' : ''}} {{item.disabled ? 'disabled' : ''}}" bindtap="{{item.disabled ? '' : 'pickProxyUnit'}}" data-unit-id="{{item.unitId}}">
            <view class="pu-info">
              <text class="pu-name">{{item.building}}{{item.unitNo}} {{item.representativeName}}</text>
              <text class="pu-meta">{{item.area}}㎡ {{item.allVoted ? '· 已投' : '· 未投'}}</text>
            </view>
            <text wx:if="{{proxyUnitId === item.unitId}}" class="pu-check">✓</text>
          </view>
        </scroll-view>
      </view>

      <!-- 选议题 -->
      <view class="form-group" wx:if="{{proxyUnitId}}">
        <text class="form-label">选择议题</text>
        <view wx:for="{{proxyTopics}}" wx:key="id" class="proxy-topic {{proxyTopicId === item.id ? 'on' : ''}}" bindtap="pickProxyTopic" data-topic-id="{{item.id}}">
          <text>{{item.title}}</text>
          <text wx:if="{{proxyVotedTopics.indexOf(item.id) >= 0}}" style="font-size:11px;color:#27AE60;">已投</text>
        </view>
      </view>

      <!-- 选投票 -->
      <view class="form-group" wx:if="{{proxyTopicId}}">
        <text class="form-label">投票</text>
        <view class="proxy-choice-row">
          <text class="proxy-choice for {{proxyChoice === 'for' ? 'on' : ''}}" bindtap="pickProxyChoice" data-choice="for">赞成</text>
          <text class="proxy-choice ag {{proxyChoice === 'against' ? 'on' : ''}}" bindtap="pickProxyChoice" data-choice="against">反对</text>
          <text class="proxy-choice ab {{proxyChoice === 'abstain' ? 'on' : ''}}" bindtap="pickProxyChoice" data-choice="abstain">弃权</text>
        </view>
      </view>

      <!-- 凭证 -->
      <view class="form-group" wx:if="{{proxyChoice}}">
        <text class="form-label">代录凭证（必传）</text>
        <view class="proof-picker" bindtap="pickProxyProof">
          <text class="proof-main">{{proxyProofName || '上传纸质票照片或授权凭证'}}</text>
          <text class="proof-action">{{proxyProofName ? '重新选择' : '选择图片'}}</text>
        </view>
      </view>

      <view class="sheet-actions" wx:if="{{proxyChoice}}">
        <button class="btn btn-ghost" bindtap="closeProxyVote">取消</button>
        <button class="btn btn-primary" loading="{{proxySubmitting}}" bindtap="submitProxyVote">提交补录</button>
      </view>
    </view>
  </view>

  <!-- 会议纪要查看/编辑弹窗 -->
  <view wx:if="{{minutesVisible}}" class="modal-mask" bindtap="closeMinutes">
    <view class="form-sheet" catchtap="noop" style="padding-bottom:calc(18px + env(safe-area-inset-bottom));">
      <view class="sheet-head">
        <text class="sheet-title">会议纪要</text>
        <text class="sheet-close" bindtap="closeMinutes">×</text>
      </view>
      <block wx:if="{{!minutesEditing}}">
        <text style="display:block;font-size:13px;color:#555;line-height:1.7;white-space:pre-wrap;margin-bottom:16px;">{{minutesText || '加载中...'}}</text>
        <view class="sheet-actions">
          <button class="btn btn-ghost" bindtap="closeMinutes">关闭</button>
          <button wx:if="{{detail.canEditMinutes}}" class="btn btn-primary" bindtap="editMinutes">编辑纪要</button>
        </view>
      </block>
      <block wx:else>
        <view class="form-group">
          <text class="form-label">纪要正文</text>
        <textarea class="form-textarea" style="min-height:280px;height:280px;" value="{{minutesEditText}}" bindinput="onMinutesInput" placeholder="会议纪要..." placeholder-class="input-placeholder" />
        </view>
        <view class="sheet-actions">
          <button class="btn btn-ghost" bindtap="cancelEditMinutes">取消</button>
          <button class="btn btn-primary" bindtap="confirmMinutes">确认保存</button>
        </view>
      </block>
    </view>
  </view>

  <!-- 编辑大会弹窗 -->
  <view wx:if="{{editVisible}}" class="modal-mask" bindtap="closeEdit">
    <view class="form-sheet" catchtap="noop" style="padding-bottom:calc(18px + env(safe-area-inset-bottom));">
      <view class="sheet-head">
        <text class="sheet-title">编辑大会</text>
        <text class="sheet-close" bindtap="closeEdit">×</text>
      </view>
      <view class="form-group">
        <text class="form-label">大会标题 *</text>
        <input class="form-input large" value="{{editForm.title}}" data-field="title" bindinput="onEditInput" placeholder="大会标题" placeholder-class="input-placeholder" />
      </view>
      <view class="form-row">
        <view class="form-group half">
          <text class="form-label">会议日期 *</text>
          <picker mode="date" value="{{editForm.meetingDate}}" bindchange="onEditDateChange">
            <view class="picker-field">{{editForm.meetingDate || '选择日期'}}</view>
          </picker>
        </view>
        <view class="form-group half">
          <text class="form-label">开始时间 *</text>
          <picker mode="time" value="{{editForm.meetingTime}}" bindchange="onEditTimeChange">
            <view class="picker-field">{{editForm.meetingTime || '选择时间'}}</view>
          </picker>
        </view>
      </view>
      <view class="form-group">
        <text class="form-label">会议地点</text>
        <view class="quick-grid">
          <text wx:for="{{locationOptions}}" wx:key="*this" class="quick-chip {{editForm.location === item ? 'on' : ''}}" bindtap="pickEditLocation" data-location="{{item}}">{{item}}</text>
        </view>
        <input class="form-input" value="{{editForm.location}}" data-field="location" bindinput="onEditInput" placeholder="也可手动输入" placeholder-class="input-placeholder" />
      </view>
      <view class="form-group">
        <text class="form-label">补充说明</text>
        <textarea class="form-textarea" style="min-height:72px;height:72px;" value="{{editForm.description}}" data-field="description" bindinput="onEditInput" placeholder="其他需要记录的事项" placeholder-class="input-placeholder" />
      </view>
      <view class="sheet-actions">
        <button class="btn btn-ghost" bindtap="closeEdit">取消</button>
        <button class="btn btn-primary" bindtap="submitEdit">保存修改</button>
      </view>
    </view>
  </view>

  <!-- 编辑通知草稿弹窗 -->
  <view wx:if="{{noticeEditVisible}}" class="modal-mask" bindtap="closeNoticeEdit">
    <view class="form-sheet" catchtap="noop" style="padding-bottom:calc(18px + env(safe-area-inset-bottom));">
      <view class="sheet-head">
        <text class="sheet-title">编辑通知</text>
        <text class="sheet-close" bindtap="closeNoticeEdit">×</text>
      </view>
      <view class="form-group">
        <text class="form-label">通知标题</text>
        <input class="form-input large" value="{{noticeEditForm.title}}" data-field="title" bindinput="onNoticeEditInput" placeholder="通知标题" placeholder-class="input-placeholder" />
      </view>
      <view class="form-group">
        <text class="form-label">通知正文</text>
        <textarea class="form-textarea" style="min-height:200px;height:200px;" value="{{noticeEditForm.content}}" data-field="content" bindinput="onNoticeEditInput" placeholder="通知正文" placeholder-class="input-placeholder" />
      </view>
      <view class="sheet-actions">
        <button class="btn btn-ghost" bindtap="closeNoticeEdit">取消</button>
        <button class="btn btn-primary" bindtap="submitNoticeEdit">保存通知</button>
      </view>
    </view>
  </view>
</scroll-view>
