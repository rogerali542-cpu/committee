<scroll-view scroll-y class="live-page" wx:if="{{detail}}">

  <page-nav title="会议进行" style="display:block;margin:-24rpx -24rpx 0;"></page-nav>

  <view class="lp-stepper">
    <block wx:for="{{steps}}" wx:for-item="s" wx:key="key">
      <view class="lp-step {{currentStep > index + 1 ? 'done' : (currentStep === index + 1 ? 'active' : 'locked')}}">
        <text class="lp-step-num">{{currentStep > index + 1 ? '✓' : index + 1}}</text>
        <text class="lp-step-label">{{s.label}}</text>
      </view>
      <view wx:if="{{index < steps.length - 1}}" class="lp-step-line {{currentStep > index + 1 ? 'done' : ''}}"></view>
    </block>
  </view>

  <view class="lp-info-card">
    <text class="lp-info-title">{{detail.title}}</text>
    <view class="lp-info-row"><text class="lp-info-k">时间</text><text class="lp-info-v">{{detail.meetingDate}} {{detail.meetingTime}}</text></view>
    <view class="lp-info-row"><text class="lp-info-k">地点</text><text class="lp-info-v">{{detail.location}}</text></view>
    <view wx:if="{{detail.description}}" class="lp-info-row"><text class="lp-info-k">说明</text><text class="lp-info-v">{{detail.description}}</text></view>
    <view class="lp-info-row top"><text class="lp-info-k">议题</text>
      <view class="lp-agenda">
        <block wx:if="{{detail.record.topics.length}}">
          <view class="lp-agenda-item" wx:for="{{detail.record.topics}}" wx:key="id">
            <text class="lp-agenda-idx">{{index + 1}}</text>
            <text class="lp-agenda-title">{{item.title}}</text>
            <text class="lp-agenda-tag {{item.type === 'major' ? 'major' : (item.voteRequired ? 'vote' : '')}}">{{item.type === 'major' ? '重大' : (item.voteRequired ? '表决' : '通报')}}</text>
          </view>
        </block>
        <text wx:else class="lp-agenda-empty">暂无议题</text>
      </view>
    </view>
  </view>

  <view class="lp-card" wx:if="{{currentStep === 1}}">
    <text class="lp-card-step">第 1 步，共 4 步</text>
    <text class="lp-card-title">入会签到</text>
    <text class="lp-card-desc">确认参会后再进行录音，会议有效性会以确认参会人数为基础核查。</text>
    <view class="qk-sign-card {{signedIn ? 'on' : ''}}">
      <text class="qk-sign-main">{{signedIn ? '已确认参会' : '待确认参会'}}</text>
      <text class="qk-sign-sub">{{selfAttendance ? selfAttendance.name + ' · ' + selfAttendance.role : '当前登录身份'}}</text>
    </view>
    <button class="lp-primary-btn" bindtap="confirmSignIn">{{signedIn ? '进入录音' : '确认参会'}}</button>
  </view>

  <view class="lp-card" wx:if="{{currentStep === 2}}">
    <text class="lp-card-step">第 2 步，共 4 步</text>
    <text class="lp-card-title">会议录音</text>
    <text class="lp-card-desc">录音后上传保存，多条录音皆可留存。主任在下一步统一选一条作为纪要依凭。</text>

    <!-- 录音控件：任意已签到参会人可用 -->
    <view class="qk-recorder">
      <view class="qk-rec-dot {{recording ? 'on' : ''}}"></view>
      <text class="qk-rec-time">{{timeText}}</text>
      <text class="qk-rec-status">{{recording ? '录音中' : (tempFilePath ? '录音已保存，待上传' : (hasRecording ? '已暂停' : '尚未开始'))}}</text>
    </view>
    <button class="lp-primary-btn" bindtap="toggleRecord" disabled="{{uploading || polling || extracting}}">
      {{recording ? '暂停录音' : (recorderStarted ? '继续录音' : (tempFilePath ? '重新录音' : '开始录音'))}}
    </button>
    <button class="lp-ghost-btn" bindtap="finishRecord" disabled="{{uploading || polling || extracting}}">
      结束录音并上传
    </button>
    <view class="qk-divider"><text class="qk-divider-text">或</text></view>
    <button class="lp-ghost-btn" bindtap="chooseAudioFile" disabled="{{uploading || polling || extracting}}">
      选择已有录音文件上传
    </button>
    <view class="qk-note">上传后只保存不自动转写，需在下一步选片。</view>

    <!-- 会议资料：人人可传/可看 -->
    <view class="qk-grp-title">会议资料（{{materials.length}}）<text class="qk-link" bindtap="uploadMaterial">+ 上传资料</text></view>
    <view wx:if="{{materials.length === 0}}" class="lp-empty">暂无资料，任意参会人都可上传共享</view>
    <view wx:else>
      <view class="qk-mat-item" wx:for="{{materials}}" wx:key="name" bindtap="previewMaterial" data-index="{{index}}">
        <text class="qk-mat-name">{{item.name}}</text>
        <text class="qk-mat-meta">{{item.uploaderName || ''}}{{item.sizeText ? ' · ' + item.sizeText : ''}}</text>
        <text class="qk-mat-arrow">›</text>
      </view>
    </view>

    <!-- 实时添加议题（主任/副主任）-->
    <view wx:if="{{isChair}}" class="qk-rr-transfer"><text class="qk-link" bindtap="openAddTopic">+ 实时添加议题</text></view>
  </view>

  <view class="lp-card" wx:if="{{currentStep === 3}}">
    <text class="lp-card-step">第 3 步，共 4 步</text>
    <text class="lp-card-title">选片转写</text>
    <text class="lp-card-desc">选择一条已上传的录音，触发语音转写，为议题匹配提供文本底稿。</text>

    <!-- 已上传录音列表 -->
    <view wx:if="{{recordings.length}}" class="qk-pick-list">
      <view class="qk-pick-item {{item.id === _transcribingRecordingId ? 'transcribing' : ''}}" wx:for="{{recordings}}" wx:key="id">
        <view class="qk-pick-info">
          <text class="qk-pick-name">{{item.uploaderName || '未知'}} · {{item.fileName || '录音'}}</text>
          <text class="qk-pick-meta">{{item.createdAt || ''}} · {{item.asrStatus === 'done' ? '已转写' : item.asrStatus === 'processing' ? '转写中' : '已保存'}}</text>
        </view>
        <button wx:if="{{item.asrStatus !== 'done' && item.asrStatus !== 'processing'}}" class="lp-ghost-btn" bindtap="transcribeRecording" data-recording-id="{{item.id}}" disabled="{{polling}}">转写</button>
        <text wx:elif="{{item.asrStatus === 'done'}}" class="qk-pick-done">✓ 已转写</text>
        <text wx:else class="qk-pick-ing">转写中...</text>
      </view>
    </view>
    <view wx:else class="lp-empty">暂无录音，请返回上一步录制或上传</view>

    <!-- 转写状态 -->
    <view class="qk-gen" wx:if="{{polling || extracting}}">
      <view class="qk-spinner"></view>
      <text class="qk-gen-text">{{processText}}</text>
    </view>

    <view class="qk-gen" wx:if="{{generated}}">
      <view class="qk-gen-icon">✓</view>
      <text class="qk-gen-text">{{finishText}}</text>
    </view>

    <view wx:if="{{generated}}" class="qk-transcript-card">
      <view class="qk-transcript-head">
        <view>
          <text class="qk-transcript-title">语音转录文本</text>
          <text class="qk-transcript-meta">{{transcript.length}} 段 · {{transcriptCharCount}} 字</text>
        </view>
        <text class="qk-transcript-action" bindtap="openTranscript" data-mode="short">查看</text>
      </view>
      <text class="qk-transcript-preview">{{transcriptPreview || '暂无可预览的转写文本'}}</text>
    </view>

    <view wx:if="{{asrStatus === 'failed'}}" class="qk-note">转写失败，可重新选片或返回上一步录制新音频。</view>
    <view wx:if="{{asrStatus === 'empty'}}" class="qk-note warn">未检测到有效语音：这条录音可能是静音、杂音或太短。请换一条录音，或返回上一步重新录音。</view>
    <button wx:if="{{asrStatus === 'failed' || asrStatus === 'empty'}}" class="lp-ghost-btn" bindtap="retryToStep2">返回录音</button>

    <button class="lp-primary-btn" bindtap="goConfirm" disabled="{{!generated}}">下一步：匹配议题并生成纪要依据</button>
  </view>

  <view class="lp-card" wx:if="{{currentStep === 4}}">
    <text class="lp-card-step">最后一步</text>
    <text class="lp-card-title">整理会议纪要</text>
    <text class="lp-card-desc">AI 已根据录音识别各议题的表决结果。请核对下面标注「待核对」的项目，然后用 AI 生成会议纪要。</text>

    <view class="qk-transcript-card compact">
      <view class="qk-transcript-head">
        <view>
          <text class="qk-transcript-title">转录文本底稿</text>
          <text class="qk-transcript-meta">{{transcript.length}} 段 · 用于议题匹配</text>
        </view>
        <text class="qk-transcript-action" bindtap="openTranscript" data-mode="short">查看文本</text>
      </view>
      <text class="qk-transcript-preview">{{transcriptPreview || '暂无可预览的转写文本'}}</text>
    </view>

    <view class="qk-grp-title">议题与表决结果（AI 识别）</view>
    <view wx:if="{{presetTopics.length === 0}}" class="lp-empty">未读取到预设议题，请返回会议详情检查创建信息</view>
    <view class="qk-rev {{t.needsReview ? 'warn' : ''}}" wx:for="{{presetTopics}}" wx:for-item="t" wx:for-index="ti" wx:key="id">
      <view class="qk-rev-head">
        <text class="qk-rev-no">{{ti + 1}}</text>
        <view class="qk-rev-main">
          <text class="qk-rev-title">{{t.title}}</text>
          <view class="qk-rev-meta">
            <text class="qk-tag-type">{{t.typeLabel}}</text>
            <block wx:if="{{t.voteRequired}}">
              <text class="qk-rev-result {{t.result}}">{{t.resultLabel}}</text>
              <text class="qk-rev-counts">同意{{t.voteFor}}·反对{{t.voteAgainst}}·弃权{{t.voteAbstain}}</text>
            </block>
            <text wx:else class="qk-rev-result recorded">已记录</text>
          </view>
        </view>
        <text wx:if="{{isChair && t.voteRequired}}" class="qk-rev-btn" catchtap="toggleReview" data-idx="{{ti}}">{{t._reviewOpen ? '收起' : '核对'}}</text>
      </view>
      <text wx:if="{{t.needsReview && !t._reviewOpen}}" class="qk-rev-tip">⚠ AI 未能确定结果，请点「核对」确认票数</text>

      <view wx:if="{{t._reviewOpen}}" class="qk-rev-box">
        <text wx:if="{{t.aiVoteLabel}}" class="qk-vote-ai">AI 识别来源：{{t.aiVoteLabel}}</text>
        <text class="qk-vote-rule">实到 {{voteTotal}} 人，过半需 {{voteNeed}} 票</text>
        <view class="qk-vote-counts">
          <view class="qk-vote-counter">
            <text>同意</text>
            <view><text catchtap="changeVoteCount" data-group="preset" data-idx="{{ti}}" data-field="voteFor" data-delta="-1">-</text><text>{{t.voteFor}}</text><text catchtap="changeVoteCount" data-group="preset" data-idx="{{ti}}" data-field="voteFor" data-delta="1">+</text></view>
          </view>
          <view class="qk-vote-counter">
            <text>反对</text>
            <view><text catchtap="changeVoteCount" data-group="preset" data-idx="{{ti}}" data-field="voteAgainst" data-delta="-1">-</text><text>{{t.voteAgainst}}</text><text catchtap="changeVoteCount" data-group="preset" data-idx="{{ti}}" data-field="voteAgainst" data-delta="1">+</text></view>
          </view>
          <view class="qk-vote-counter">
            <text>弃权</text>
            <view><text catchtap="changeVoteCount" data-group="preset" data-idx="{{ti}}" data-field="voteAbstain" data-delta="-1">-</text><text>{{t.voteAbstain}}</text><text catchtap="changeVoteCount" data-group="preset" data-idx="{{ti}}" data-field="voteAbstain" data-delta="1">+</text></view>
          </view>
        </view>
        <view class="qk-result-pick">
          <text class="{{t.result === 'passed' ? 'on' : ''}}" catchtap="pickTopicResult" data-group="preset" data-idx="{{ti}}" data-result="passed">通过</text>
          <text class="{{t.result === 'rejected' ? 'on' : ''}}" catchtap="pickTopicResult" data-group="preset" data-idx="{{ti}}" data-result="rejected">未通过</text>
          <text class="{{t.result === 'unclear' ? 'on' : ''}}" catchtap="pickTopicResult" data-group="preset" data-idx="{{ti}}" data-result="unclear">待定</text>
        </view>
      </view>
    </view>

    <!-- AI 额外发现（议程外的疑似新议题，默认折叠不打扰） -->
    <view wx:if="{{aiTopics.length}}" class="qk-extra">
      <view class="qk-extra-head" bindtap="toggleExtra">
        <text>AI 额外发现 · {{aiTopics.length}} 项可能的新议题</text>
        <text class="qk-extra-toggle">{{extraOpen ? '收起 ▲' : '展开 ▼'}}</text>
      </view>
      <view wx:if="{{extraOpen}}" class="qk-extra-list">
        <view class="qk-extra-item" wx:for="{{aiTopics}}" wx:for-item="c" wx:for-index="ci" wx:key="id">
          <text class="qk-extra-title">{{c.title}}</text>
          <view class="qk-extra-acts" wx:if="{{isChair}}">
            <text class="qk-cand-btn primary" catchtap="adoptCandidate" data-idx="{{ci}}">采纳</text>
            <text class="qk-cand-btn" catchtap="ignoreCandidate" data-idx="{{ci}}">忽略</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 居委会签字（重大事项时，合规所需，保留） -->
    <view wx:if="{{detail.record.hasMajorIssue}}" class="qk-juwei">
      <text class="qk-juwei-name">居委会委员：{{detail.record.juweiName}}</text>
      <text class="qk-juwei-chip {{detail.record.juweiSigned ? 'on' : ''}}" bindtap="toggleJuwei">{{detail.record.juweiSigned ? '✓ 已签字' : '签字'}}</text>
    </view>

    <!-- 生成纪要 / 结束会议 -->
    <block wx:if="{{isChair}}">
      <button wx:if="{{!minutesGenerated}}" class="lp-primary-btn" bindtap="generateMinutes" disabled="{{generatingMinutes}}">{{generatingMinutes ? 'AI 生成中…请稍候' : '用 AI 生成会议纪要（推荐）'}}</button>
      <view wx:if="{{!minutesGenerated}}" class="qk-minor-links">
        <text class="qk-minor-link" bindtap="writeMinutes">手写会议纪要</text>
        <text class="qk-minor-link" bindtap="endThenSupplement">先结束会议，纪要后续补充</text>
      </view>

      <block wx:else>
        <view class="qk-gen"><view class="qk-gen-icon">✓</view><text class="qk-gen-text">AI 会议纪要已生成，可在纪要页核对 / 编辑</text></view>
        <view class="qk-sub-actions">
          <text class="qk-sub-link" bindtap="viewMinutes">在纪要页查看 / 编辑</text>
          <text class="qk-sub-sep">·</text>
          <text class="qk-sub-link" bindtap="generateMinutes">重新生成</text>
        </view>
        <button class="lp-primary-btn" bindtap="confirmEndMeeting" disabled="{{ending}}">{{ending ? '结束中…' : '确认无误，结束会议'}}</button>
      </block>
    </block>
    <view wx:else class="qk-wait-tip">表决核对与结束会议由主任/副主任拍板，请等待主持人操作。</view>
  </view>

  <view class="lp-nav">
    <button class="lp-nav-btn ghost" bindtap="exitLive">退出</button>
    <button wx:if="{{isChair}}" class="lp-nav-btn ghost" bindtap="exportAttendance">导出签到名单</button>
  </view>

  <!-- 转录文本查看 -->
  <view wx:if="{{transcriptVisible}}" class="qk-modal-mask" bindtap="closeTranscript">
    <view class="qk-transcript-sheet" catchtap="noop">
      <view class="qk-sheet-head">
        <text class="qk-modal-title">语音转录文本</text>
        <text class="qk-sheet-close" bindtap="closeTranscript">×</text>
      </view>
      <view class="qk-transcript-tabs">
        <text class="qk-transcript-tab {{transcriptMode === 'short' ? 'on' : ''}}" bindtap="switchTranscriptMode" data-mode="short">摘要</text>
        <text class="qk-transcript-tab {{transcriptMode === 'full' ? 'on' : ''}}" bindtap="switchTranscriptMode" data-mode="full">全文</text>
      </view>
      <scroll-view scroll-y class="qk-transcript-scroll">
        <view wx:if="{{transcriptMode === 'short'}}">
          <text class="qk-transcript-body">{{transcriptPreview || '暂无摘要文本'}}</text>
          <view class="qk-note">摘要用于快速判断转写是否完成；正式匹配仍以全文分段为依据。</view>
        </view>
        <view wx:else>
          <view wx:if="{{transcript.length === 0}}" class="lp-empty">暂无转写原文</view>
          <view class="qk-tr-list" wx:else>
            <view class="qk-tr-seg" wx:for="{{transcript}}" wx:for-item="seg" wx:key="id">
              <view class="qk-tr-meta"><text class="qk-tr-spk">{{seg.speaker}}</text><text class="qk-tr-time">{{seg.time}}</text></view>
              <text class="qk-tr-text">{{seg.text}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 实时添加议题弹窗 -->
  <view wx:if="{{addTopicVisible}}" class="qk-modal-mask" bindtap="closeAddTopic">
    <view class="qk-modal" catchtap="noop">
      <text class="qk-modal-title">实时添加议题</text>
      <input class="qk-modal-input" placeholder="议题名称" value="{{newTopicForm.title}}" bindinput="onTopicFormInput" data-field="title" />
      <view class="qk-modal-types">
        <text class="qk-type {{newTopicForm.decisionType === 'simple' ? 'on' : ''}}" bindtap="pickDecisionType" data-type="simple">赞成/反对</text>
        <text class="qk-type {{newTopicForm.decisionType === 'multi_choice' ? 'on' : ''}}" bindtap="pickDecisionType" data-type="multi_choice">多选一</text>
      </view>
      <textarea wx:if="{{newTopicForm.decisionType === 'multi_choice'}}" class="qk-modal-area" placeholder="每行一个选项" value="{{newTopicForm.optionsText}}" bindinput="onTopicFormInput" data-field="optionsText" />
      <view class="qk-modal-btns">
        <button class="lp-ghost-btn" bindtap="closeAddTopic">取消</button>
        <button class="lp-primary-btn" bindtap="submitAddTopic">添加</button>
      </view>
      <text class="qk-modal-note">重大事项不可现场新增，请列入会前通知或下次会议。</text>
    </view>
  </view>

</scroll-view>
