.login-page {
  min-height: 100vh;
  background: #f4f5f7;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ── 橙色头部 ── */
.login-header {
  background: linear-gradient(160deg, #FFC23D, #FFA800);
  padding-bottom: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.login-logo {
  width: 168rpx;
  height: 168rpx;
  background: rgba(255, 255, 255, 0.45);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  margin-top: 16rpx;
}
.login-icon { font-size: 88rpx; }
.login-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 24rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}
.login-sub {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 10rpx;
}

/* ── 身份选择卡片（上移咬住头部） ── */
.login-card {
  margin: -72rpx 36rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.08);
}
.login-opt {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 8rpx;
  border-bottom: 2rpx solid #f2f3f5;
}
.login-opt:last-child { border-bottom: none; }
.login-opt:active { background: #fafbfc; }

.login-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #FFF3DC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFA800;
  flex-shrink: 0;
}
.login-avatar.rec { background: #F5EEF8; color: #9B59B6; }

.login-info { flex: 1; }
.login-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2329;
  display: flex;
  align-items: center;
}
.login-role-tag {
  font-size: 26rpx;
  font-weight: 600;
  background: #FFF3DC;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-left: 16rpx;
  color: #C77800;
}
.login-desc {
  font-size: 28rpx;
  color: #666;
  margin-top: 8rpx;
}
.login-arrow {
  font-size: 48rpx;
  color: #999;
  font-weight: 300;
}
