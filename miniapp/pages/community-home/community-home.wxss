page { background: #f4f5f7; }

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ── Header ── */
.header {
  padding: 8rpx 36rpx 14rpx;
  background: linear-gradient(160deg, #FFC23D, #FFA800);
}
.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}
.header-sub {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 2rpx;
  display: block;
}

/* ── 版块标签（轻微暗示可切换） ── */
.section-tabs {
  display: flex;
  background: #fff;
  margin: 0 24rpx;
  border-radius: 20rpx 20rpx 0 0;
  padding: 18rpx 16rpx 0;
  gap: 8rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.03);
}
.s-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #b3bcc6;
  padding: 14rpx 0 18rpx;
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
}
.s-tab.on {
  color: #C77800;
  font-weight: 700;
  border-bottom-color: #FFA800;
}

/* ── Swiper ── */
.card-swiper {
  flex: 1;
  height: 0;  /* flex:1 配合 height:0 让 swiper 撑满剩余高度 */
}

.card-scroll {
  height: 100%;
  padding: 0 24rpx 0;
  box-sizing: border-box;
}

/* ── 卡片容器 ── */
.card {
  background: #fff;
  border-radius: 0 0 24rpx 24rpx;
  padding: 20rpx 32rpx 40rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.06);
  min-height: 100%;
  box-sizing: border-box;
}

.card-head {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}
.card-head-icon {
  font-size: 48rpx;
  margin-right: 14rpx;
}
.card-head-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2329;
}

/* ── 筛选标签 ── */
.filter-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 28rpx;
}
.f-pill {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #6b7785;
  background: #f4f5f7;
  border-radius: 18rpx;
  padding: 16rpx 0;
  font-weight: 500;
}
.f-pill.active {
  background: #FFF3DC;
  color: #C77800;
  font-weight: 700;
}

/* ── 小区公告列表 ── */
.notice-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.notice-item {
  background: #fafbfc;
  border-radius: 18rpx;
  padding: 28rpx 26rpx;
  border-left: 8rpx solid #FFA800;
}

.notice-date-badge {
  display: inline-block;
  background: #FFF3DC;
  color: #B8860B;
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 14rpx;
}

.notice-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
  display: block;
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.notice-detail {
  font-size: 30rpx;
  color: #6b7785;
  display: block;
  line-height: 1.7;
}

/* ── 物业事项列表 ── */
.prop-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.prop-card {
  background: #fafbfc;
  border-radius: 18rpx;
  padding: 26rpx 26rpx;
}

.prop-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.prop-tag {
  font-size: 24rpx;
  background: #E8F0FE;
  color: #3B5998;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

.prop-status {
  font-size: 26rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}
.prop-status.pending {
  background: #FDECEA;
  color: #E74C3C;
}
.prop-status.processing {
  background: #FFF3DC;
  color: #E67E22;
}
.prop-status.done {
  background: #E8F7EE;
  color: #27AE60;
}

.prop-content {
  font-size: 32rpx;
  color: #1f2329;
  line-height: 1.6;
  display: block;
  margin-bottom: 12rpx;
}

.prop-date {
  font-size: 26rpx;
  color: #9aa6b2;
  display: block;
}

.prop-reply {
  font-size: 30rpx;
  color: #333;
  line-height: 1.7;
  background: #E8F7EE;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-top: 16rpx;
  border-left: 6rpx solid #2ECC71;
}

.prop-reply-label {
  font-weight: 700;
  color: #27AE60;
}

/* ── 会议纪要列表 ── */
.minutes-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.minutes-item {
  background: #fafbfc;
  border-radius: 18rpx;
  padding: 28rpx 26rpx;
  border-left: 8rpx solid #5DADE2;
}
.minutes-item:active {
  background: #f0f2f5;
}

.minutes-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
  display: block;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.minutes-desc {
  font-size: 28rpx;
  color: #6b7785;
  line-height: 1.6;
  margin-bottom: 14rpx;
  /* 最多两行 */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.minutes-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.minutes-date {
  font-size: 26rpx;
  color: #9aa6b2;
}

.minutes-arrow {
  font-size: 30rpx;
  color: #FFA800;
  font-weight: 600;
}

/* ── 空状态 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #b3bcc6;
}
