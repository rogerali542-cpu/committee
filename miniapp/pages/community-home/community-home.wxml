<view class="page">
  <!-- Header -->
  <view class="header" style="padding-top: {{statusBarHeight + 2}}px;">
    <text class="header-title">阳光家园</text>
    <text class="header-sub">幸福路88号</text>
  </view>

  <!-- 版块标签（轻微提示可左右滑动） -->
  <view class="section-tabs">
    <view class="s-tab {{currentCard === 0 ? 'on' : ''}}" bindtap="switchCard" data-index="0">
      <text>📢 小区公告</text>
    </view>
    <view class="s-tab {{currentCard === 1 ? 'on' : ''}}" bindtap="switchCard" data-index="1">
      <text>🏗️ 物业事项</text>
    </view>
    <view class="s-tab {{currentCard === 2 ? 'on' : ''}}" bindtap="switchCard" data-index="2">
      <text>📋 会议公示</text>
    </view>
  </view>

  <!-- Swiper 横滑三卡片 -->
  <swiper class="card-swiper" current="{{currentCard}}" bindchange="onSwiperChange"
          indicator-dots="{{false}}">

    <!-- 卡片1: 小区公告 -->
    <swiper-item>
      <scroll-view scroll-y class="card-scroll" enhanced show-scrollbar="{{false}}">
        <view class="card">
          <view class="card-head">
            <text class="card-head-icon">📢</text>
            <text class="card-head-title">小区公告</text>
          </view>
          <view class="notice-list">
            <view class="notice-item" wx:for="{{notices}}" wx:key="id">
              <view class="notice-date-badge">{{item.date}}</view>
              <text class="notice-title">{{item.title}}</text>
              <text class="notice-detail">{{item.detail}}</text>
            </view>
          </view>
          <view wx:if="{{notices.length === 0}}" class="empty-state">
            <text class="empty-emoji">📭</text>
            <text class="empty-text">暂无公告</text>
          </view>
        </view>
      </scroll-view>
    </swiper-item>

    <!-- 卡片2: 物业事项公示 -->
    <swiper-item>
      <scroll-view scroll-y class="card-scroll" enhanced show-scrollbar="{{false}}">
        <view class="card">
          <view class="card-head">
            <text class="card-head-icon">🏗️</text>
            <text class="card-head-title">物业事项公示</text>
          </view>
          <!-- 状态筛选 -->
          <view class="filter-row">
            <view class="f-pill {{propFilter === 'all' ? 'active' : ''}}"
                  bindtap="filterProperty" data-filter="all">全部</view>
            <view class="f-pill {{propFilter === 'processing' ? 'active' : ''}}"
                  bindtap="filterProperty" data-filter="processing">处理中</view>
            <view class="f-pill {{propFilter === 'done' ? 'active' : ''}}"
                  bindtap="filterProperty" data-filter="done">已处理</view>
          </view>
          <view wx:if="{{filteredProperties.length > 0}}" class="prop-list">
            <view class="prop-card" wx:for="{{filteredProperties}}" wx:key="id">
              <view class="prop-head">
                <text class="prop-tag">物业事项</text>
                <text class="prop-status {{item.statusKey}}">{{item.statusLabel}}</text>
              </view>
              <text class="prop-content">{{item.content}}</text>
              <text class="prop-date">📅 反映日期 {{item.date}}</text>
              <view wx:if="{{item.propertyReply}}" class="prop-reply">
                <text class="prop-reply-label">物业处理结果：</text>
                <text>{{item.propertyReply}}</text>
              </view>
            </view>
          </view>
          <view wx:elif="{{!propLoading}}" class="empty-state">
            <text class="empty-emoji">🏗️</text>
            <text class="empty-text">暂无物业事项</text>
          </view>
          <view wx:else class="empty-state">
            <text class="empty-text">加载中...</text>
          </view>
        </view>
      </scroll-view>
    </swiper-item>

    <!-- 卡片3: 会议纪要公示 -->
    <swiper-item>
      <scroll-view scroll-y class="card-scroll" enhanced show-scrollbar="{{false}}">
        <view class="card">
          <view class="card-head">
            <text class="card-head-icon">📋</text>
            <text class="card-head-title">会议纪要公示</text>
          </view>
          <view wx:if="{{publicMinutes.length > 0}}" class="minutes-list">
            <view class="minutes-item" wx:for="{{publicMinutes}}" wx:key="id"
                  bindtap="openMinutes" data-id="{{item.id}}">
              <text class="minutes-title">{{item.title}}</text>
              <text class="minutes-desc" wx:if="{{item.description}}">{{item.description}}</text>
              <view class="minutes-meta">
                <text class="minutes-date">📅 {{item.date}}</text>
                <text class="minutes-arrow">查看 ›</text>
              </view>
            </view>
          </view>
          <view wx:elif="{{!minutesLoading}}" class="empty-state">
            <text class="empty-emoji">📋</text>
            <text class="empty-text">暂无公示的会议纪要</text>
          </view>
          <view wx:else class="empty-state">
            <text class="empty-text">加载中...</text>
          </view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>
</view>
