<view class="page">
  <text class="intro">业委会会议纪要及决定，依规在作出后三日内向全体业主公示。</text>
  <block wx:if="{{items.length}}">
    <view class="info-card" wx:for="{{items}}" wx:key="id" bindtap="viewDetail" data-id="{{item.id}}" data-type="{{item.type}}">
      <text class="ic-tag">{{item.type === 'committee' ? '会议公示' : '大会决议'}}</text>
      <text class="ic-title">{{item.title}}</text>
      <view class="ic-meta">
        <text>会议日期 {{item.date}}</text>
        <text>公示于 {{item.publishDate}}</text>
      </view>
      <text class="ic-desc">{{item.description}}</text>
    </view>
  </block>
  <view wx:else class="empty-state"><text>暂无已公示的会议公告</text></view>
</view>
