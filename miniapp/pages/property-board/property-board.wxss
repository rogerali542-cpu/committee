.page { min-height: 100vh; background: #f5f5f5; padding: 12px; }
.intro { font-size: 12px; color: #aaa; display: block; margin-bottom: 12px; text-align: center; }

.filter-tabs { display: flex; gap: 8px; margin-bottom: 12px; }
.f-tab {
  flex: 1; text-align: center; font-size: 13px; color: #666;
  background: #fff; border-radius: 10px; padding: 8px 0; border: 1px solid #eee;
}
.f-tab.active { background: #FFF3DC; color: #B8860B; border-color: #FFCC44; font-weight: 600; }
.f-count { font-size: 11px; color: #bbb; }
.f-tab.active .f-count { color: #B8860B; }

.board-card {
  background: #fff; border-radius: 14px; padding: 14px;
  margin-bottom: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.bc-head { display: flex; justify-content: space-between; align-items: center; }
.bc-tag { font-size: 10px; background: #FFF3DC; color: #B8860B; padding: 2px 8px; border-radius: 8px; }
.status-pill { font-size: 11px; padding: 2px 9px; border-radius: 10px; }
.status-pill.pending { background: #FDECEA; color: #E74C3C; }
.status-pill.processing { background: #FFF3DC; color: #E67E22; }
.status-pill.done { background: #E8F7EE; color: #27AE60; }
.bc-content { font-size: 14px; color: #333; line-height: 1.6; margin: 8px 0; }
.bc-meta { font-size: 12px; color: #999; }
.bc-reply {
  font-size: 13px; color: #444; line-height: 1.6;
  background: #E8F7EE; border-radius: 8px; padding: 9px 11px; margin-top: 10px;
  border-left: 3px solid #2ECC71;
}
.bc-reply-label { font-weight: 600; color: #27AE60; }
.bc-reply-time { display: block; font-size: 11px; color: #aaa; margin-top: 4px; }

.empty-state {
  display: flex; flex-direction: column; align-items: center;
  color: #bbb; font-size: 14px; padding-top: 80px;
}
.empty-emoji { font-size: 40px; margin-bottom: 12px; }
