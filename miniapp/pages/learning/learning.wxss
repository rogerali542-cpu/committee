.page { min-height: 100vh; background: #f5f5f5; padding: 12px; padding-bottom: 80px; }

/* 类型标签 */
.type-tabs { display: flex; gap: 10px; margin-bottom: 10px; }
.type-tab { flex: 1; padding: 10px; text-align: center; background: #fff; border-radius: 12px; font-size: 13px; color: #888; box-shadow: 0 1px 4px rgba(0,0,0,0.04); }
.type-tab.active { background: #9B59B6; color: #fff; font-weight: 600; }

/* 年度目标 */
.learn-target {
  margin: 0 0 10px; background: #fff; border-radius: 14px; padding: 16px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.lt-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.lt-title { font-size: 13px; font-weight: 600; color: #333; }
.lt-badge { font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 8px; }
.lt-badge.done { background: #E8F7EE; color: #27AE60; }
.lt-badge.warn { background: #FFF3E0; color: #E67E22; }
.lt-body { display: flex; align-items: center; gap: 16px; }
.lt-ring-wrap { position: relative; width: 72px; height: 72px; flex-shrink: 0; overflow: hidden; }
.lt-canvas { width: 72px; height: 72px; }
.lt-ring-center {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.lt-ring-num { font-size: 22px; font-weight: 700; color: #333; }
.lt-ring-unit2 { font-size: 13px; font-weight: 400; color: #aaa; }
.lt-ring-label { font-size: 10px; color: #aaa; }
.lt-info { flex: 1; }
.lt-info-row { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #666; margin-bottom: 6px; }
.lt-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.lt-bar-wrap { flex: 1; background: #f0f0f0; border-radius: 3px; height: 8px; overflow: hidden; }
.lt-bar-fill { height: 100%; border-radius: 3px; }
.lt-num { font-weight: 600; color: #333; }
.lt-rule { font-size: 10px; color: #ccc; margin-top: 4px; display: block; }

/* 培训子分类卡片 */
.train-sub-tabs { display: flex; gap: 10px; margin-bottom: 10px; }
.tsc-card {
  flex: 1; background: #fff; border-radius: 14px; padding: 14px 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 2px solid transparent;
  position: relative;
}
.tsc-card.active { border-color: #9B59B6; background: #FDFAFF; }
.tsc-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 8px; font-size: 20px; }
.tsc-title { font-size: 13px; font-weight: 600; color: #333; display: block; margin-bottom: 3px; }
.tsc-desc { font-size: 10px; color: #aaa; line-height: 1.4; display: block; }
.tsc-badge {
  position: absolute; top: 10px; right: 10px;
  font-size: 10px; font-weight: 700; background: #F5EEF8; color: #9B59B6;
  min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
}

/* 筛选标签 */
.filter-tabs { display: flex; gap: 0; margin-bottom: 10px; background: #fff; border-radius: 12px; padding: 4px; }
.f-tab { flex: 1; padding: 8px 4px; text-align: center; font-size: 12px; color: #999; border-radius: 8px; display: flex; align-items: center; justify-content: center; gap: 4px; }
.f-tab.active { background: linear-gradient(135deg, #BB8FCE, #9B59B6); color: #fff; font-weight: 600; }
.f-count { font-size: 10px; opacity: 0.8; }

/* 学习卡片 */
.learn-list { display: flex; flex-direction: column; gap: 10px; }
.learn-card { background: #fff; border-radius: 14px; padding: 14px; padding-right: 36px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); position: relative; }
.lc-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 8px; }
.lc-title { font-size: 14px; font-weight: 600; color: #333; flex: 1; padding-right: 8px; }
.lc-pill { font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 20px; flex-shrink: 0; white-space: nowrap; }
.lc-pill.preparing { background: #FFF3E0; color: #E67E22; }
.lc-pill.ongoing { background: #EBF5FB; color: #2980B9; }
.lc-pill.ended { background: #F0F0F0; color: #888; }
.lc-meta { display: flex; flex-direction: column; gap: 4px; margin-bottom: 8px; }
.lc-meta-line { font-size: 12px; color: #888; display: flex; align-items: center; gap: 6px; }
.lc-progress { display: flex; align-items: center; gap: 8px; margin: 4px 0 8px; }
.lc-progress-bar { flex: 1; background: #f0f0f0; border-radius: 4px; height: 6px; overflow: hidden; }
.lc-progress-fill { height: 100%; border-radius: 4px; background: linear-gradient(90deg, #BB8FCE, #9B59B6); }
.lc-progress-text { font-size: 11px; color: #9B59B6; font-weight: 600; flex-shrink: 0; }
.lc-footer { display: flex; justify-content: flex-end; gap: 8px; margin-top: 10px; border-top: 1px solid #f5f5f5; padding-top: 10px; }
.lc-arrow { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-size: 22px; color: #ccc; }
.lc-btn {
  min-height: 36px; line-height: 36px; padding: 0 18px;
  border-radius: 20px; border: none; font-size: 13px; font-weight: 600;
  margin: 0; display: flex; align-items: center; justify-content: center;
}
.lc-btn::after { border: none; }
.lc-btn.start { background: linear-gradient(135deg, #BB8FCE, #9B59B6); color: #fff; }
.lc-btn.finish { background: linear-gradient(135deg, #5DADE2, #2E86C1); color: #fff; }
.undo-toast {
  position: fixed;
  left: 18px;
  right: 18px;
  bottom: 24px;
  z-index: 40;
  background: rgba(45,45,45,0.94);
  color: #fff;
  border-radius: 14px;
  padding: 11px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 13px;
  box-shadow: 0 6px 18px rgba(0,0,0,0.2);
}
.undo-btn { color:#F4D03F; font-weight:700; padding-left:14px; }

/* ===== FAB ===== */
.fab {
  position: fixed; bottom: 30px; right: 20px;
  width: 50px; height: 50px;
  background: linear-gradient(135deg, #BB8FCE, #9B59B6);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 14px rgba(155,89,182,0.45);
  z-index: 30;
}
.fab-icon { font-size: 28px; color: #fff; font-weight: 300; }

/* ===== 创建弹窗 ===== */
.modal-mask {
  position: fixed; inset: 0; z-index: 50;
  background: rgba(0,0,0,0.36);
  display: flex; align-items: flex-end;
}
.form-sheet {
  width: 100%; max-height: 88vh; overflow: auto;
  background: #fff; border-radius: 18px 18px 0 0;
  padding: 18px 16px calc(18px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.sheet-title { font-size: 17px; font-weight: 700; color: #333; }
.sheet-close {
  width: 32px; height: 32px; line-height: 30px; text-align: center;
  border-radius: 16px; font-size: 22px; color: #999; background: #f5f5f5; flex-shrink: 0;
}
.type-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
.type-chip {
  min-height: 32px; line-height: 18px; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; color: #888; background: #f5f5f5;
  padding: 6px 12px; border-radius: 16px;
}
.type-chip.on { color: #fff; background: #9B59B6; font-weight: 600; }
.form-row { display: flex; gap: 10px; align-items: flex-start; }
.form-group { margin-bottom: 12px; min-width: 0; }
.form-group.half { flex: 1; min-width: 0; }
.form-label { display: block; font-size: 12px; color: #777; margin-bottom: 7px; line-height: 1.45; }
.form-input, .form-textarea {
  width: 100%; box-sizing: border-box; background: #fff;
  border-radius: 12px; font-size: 14px; color: #333; border: 1px solid #eeeeee;
}
.form-input { height: 44px; min-height: 44px; line-height: normal; padding: 0 12px; }
.form-input.large { height: 48px; min-height: 48px; font-size: 15px; font-weight: 600; }
.input-placeholder { color: #bbb; font-size: 13px; }
.picker-field {
  min-height: 44px; box-sizing: border-box; background: #fff;
  border: 1px solid #eeeeee; border-radius: 12px;
  padding: 0 12px; font-size: 14px; color: #333;
  line-height: normal; display: flex; align-items: center;
}
.form-textarea { min-height: 80px; height: 80px; line-height: 1.5; padding: 11px 12px; }
.sheet-actions { display: flex; gap: 10px; padding-top: 6px; }
.sheet-actions .btn {
  flex: 1; min-width: 0; height: 44px; line-height: 44px;
  border-radius: 22px; font-size: 14px; font-weight: 600;
  padding: 0 16px; margin: 0; border: 0;
  display: flex; align-items: center; justify-content: center; box-sizing: border-box;
}
.sheet-actions .btn::after { border: 0; }
.btn-ghost { color: #777; background: #f5f5f5; }
.btn-primary { color: #fff; background: linear-gradient(135deg, #BB8FCE, #9B59B6); }
