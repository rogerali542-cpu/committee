.page { min-height: 100vh; background: #f5f5f5; padding: 12px; }

.tabs { display: flex; gap: 8px; margin-bottom: 12px; }
.tab {
  flex: 1; text-align: center; font-size: 13px; color: #666;
  background: #fff; border-radius: 10px; padding: 9px 0; border: 1px solid #eee;
}
.tab.active { background: #FFF3DC; color: #B8860B; border-color: #FFCC44; font-weight: 600; }
.tab-count { font-size: 11px; color: #bbb; }
.tab.active .tab-count { color: #B8860B; }

.lib-card {
  background: #fff; border-radius: 14px; padding: 14px;
  margin-bottom: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  display: flex; align-items: center; justify-content: space-between;
}
.lc-main { flex: 1; min-width: 0; }
.lc-title { font-size: 15px; font-weight: 600; color: #333; display: block; }
.lc-meta { font-size: 12px; color: #999; margin-top: 4px; display: flex; gap: 5px; }
.lc-dot { color: #ddd; }
.lc-right { display: flex; align-items: center; gap: 6px; margin-left: 10px; }
.lc-status {
  font-size: 11px; color: #27AE60; background: #E8F7EE;
  border-radius: 8px; padding: 2px 8px; white-space: nowrap;
}
.lc-arrow { font-size: 18px; color: #ccc; }

.empty-state {
  display: flex; flex-direction: column; align-items: center;
  color: #bbb; font-size: 14px; padding-top: 80px;
}
.empty-emoji { font-size: 40px; margin-bottom: 12px; }
