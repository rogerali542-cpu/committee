.page { height: 100vh; background: #f5f5f5; }

.head-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 14px 16px; background: #fff; border-bottom: 1rpx solid #eee;
}
.hb-title { font-size: 14px; font-weight: 600; }
.hb-action { font-size: 13px; color: #FFA800; }

.noti-item {
  display: flex; align-items: center; padding: 14px 16px;
  background: #fff; border-bottom: 1rpx solid #f0f0f0;
}
.noti-item.unread { background: #FFF9ED; }
.ni-dot {
  width: 8px; height: 8px; border-radius: 50%; background: #FFA800;
  margin-right: 10px; flex-shrink: 0;
}
.noti-item.unread .ni-dot { background: #E74C3C; }
.ni-body { flex: 1; min-width: 0; }
.ni-head { display: flex; justify-content: space-between; margin-bottom: 4px; }
.ni-type { font-size: 11px; padding: 1px 6px; border-radius: 3px; }
.ni-type.notice { background: #E8F5E9; color: #2E7D32; }
.ni-type.material { background: #E3F2FD; color: #1565C0; }
.ni-time { font-size: 11px; color: #999; }
.ni-title { font-size: 14px; font-weight: 600; display: block; margin-bottom: 2px; }
.ni-content { font-size: 12px; color: #666; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ni-arrow { color: #ccc; font-size: 16px; flex-shrink: 0; margin-left: 8px; }
.noti-item.unread .ni-arrow { color: #FFA800; }

.empty-state { text-align: center; padding: 80px 0; color: #999; font-size: 14px; }
