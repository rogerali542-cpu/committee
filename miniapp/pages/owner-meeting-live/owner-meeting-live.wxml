<scroll-view scroll-y class="live-page" wx:if="{{detail}}">

  <!-- 步骤指示器 -->
  <view class="lp-stepper">
    <block wx:for="{{steps}}" wx:for-item="s" wx:key="key">
      <view class="lp-step {{currentStep > index + 1 ? 'done' : (currentStep === index + 1 ? 'active' : 'locked')}}"
            bindtap="goStep" data-step="{{index + 1}}">
        <text class="lp-step-num">{{currentStep > index + 1 ? '✓' : index + 1}}</text>
        <text class="lp-step-label">{{s.label}}</text>
      </view>
      <view wx:if="{{index < steps.length - 1}}" class="lp-step-line {{currentStep > index + 1 ? 'done' : ''}}"></view>
    </block>
  </view>

  <!-- 引导提示（只提示，不强制） -->
  <view class="lp-hint">
    <text class="lp-hint-icon">💡</text>
    <text class="lp-hint-text">{{hint}}</text>
  </view>

  <!-- 大会简介 -->
  <view class="lp-brief">
    <text class="lp-brief-title">{{detail.title}}</text>
    <text class="lp-brief-meta">{{detail.meetingDate}} {{detail.meetingTime}} · {{detail.location}}</text>
  </view>

  <!-- ═══ 主席·步骤1：出席与法定人数 ═══ -->
  <view class="lp-card" wx:if="{{steps[currentStep-1].key === 'attend'}}">
    <text class="lp-card-step">第 1 步，共 {{stepTotal}} 步</text>
    <text class="lp-card-title">出席与法定人数</text>
    <text class="lp-card-desc">业主大会需「人数过半 且 专有面积过半」方达法定人数。</text>

    <view class="lp-quorum">
      <view class="lp-q-row">
        <text class="lp-q-label">出席人数</text>
        <view class="lp-q-bar"><view class="lp-q-fill {{quorum.okOwners ? 'ok' : 'no'}}" style="width:{{quorum.pctOwners}}%"></view></view>
        <text class="lp-q-num {{quorum.okOwners ? 'ok' : 'no'}}">{{quorum.presentOwners}}/{{quorum.needOwners}}</text>
      </view>
      <view class="lp-q-row">
        <text class="lp-q-label">专有面积</text>
        <view class="lp-q-bar"><view class="lp-q-fill {{quorum.okArea ? 'ok' : 'no'}}" style="width:{{quorum.pctArea}}%"></view></view>
        <text class="lp-q-num {{quorum.okArea ? 'ok' : 'no'}}">{{quorum.pctArea}}%</text>
      </view>
      <view class="lp-q-verdict {{quorum.quorumOk ? 'ok' : 'no'}}">{{quorum.quorumOk ? '✓ 已达法定人数' : '尚未达法定人数'}}</view>
    </view>

    <button class="lp-ghost-btn" bindtap="backToDetail">去详情页登记出席 / 补录纸质票</button>
  </view>

  <!-- ═══ 表决（主席 & 户代表共用，逐项）═══ -->
  <view class="lp-card" wx:if="{{steps[currentStep-1].key === 'vote'}}">
    <text class="lp-card-step">{{userView === 'chair' ? '第 2 步，共 ' + stepTotal + ' 步' : '逐项表决'}}</text>
    <text class="lp-card-title">大会事项表决</text>

    <!-- 无需表决 -->
    <view wx:if="{{!needsVote}}" class="lp-empty">本次大会无需表决。</view>
    <!-- 非户代表 -->
    <block wx:elif="{{!isRepresentative}}">
      <view class="lp-note">你不是户代表，没有表决权。以下为各事项当前进展：</view>
      <view class="lp-topic" wx:for="{{topics}}" wx:for-item="t" wx:key="id">
        <text class="lp-topic-title">{{t.title}}</text>
        <view class="lp-prog">
          <text class="lp-prog-line">同意人数 {{t.pctForOwners}}% · 同意面积 {{t.pctForArea}}%</text>
          <text class="lp-prog-tag {{t.passed ? 'ok' : 'no'}}">{{t.passed ? '已通过' : '未通过'}}</text>
        </view>
      </view>
    </block>
    <!-- 户代表：逐项 -->
    <block wx:elif="{{topicTotal === 0}}">
      <view class="lp-empty">暂无表决事项。</view>
    </block>
    <block wx:else>
      <view class="lp-topic-nav">
        <text class="lp-tn-btn {{topicIndex === 0 ? 'disabled' : ''}}" bindtap="prevTopic">‹ 上一项</text>
        <text class="lp-tn-pos">第 {{topicIndex + 1}} / {{topicTotal}} 项</text>
        <text class="lp-tn-btn {{topicIndex >= topicTotal - 1 ? 'disabled' : ''}}" bindtap="nextTopic">下一项 ›</text>
      </view>

      <view class="lp-topic" wx:for="{{topics}}" wx:for-item="t" wx:key="id" wx:if="{{index === topicIndex}}">
        <view class="lp-topic-head">
          <text class="lp-topic-type {{t.type === 'major' ? 'major' : 'ordinary'}}">{{t.type === 'major' ? '重要事项' : '普通事项'}}</text>
          <text class="lp-topic-title">{{t.title}}</text>
        </view>

        <view wx:if="{{!t.myChoice}}" class="lp-vote-btns">
          <text class="lp-vbtn for" bindtap="submitVote" data-topic-id="{{t.id}}" data-choice="for">同意</text>
          <text class="lp-vbtn ag" bindtap="submitVote" data-topic-id="{{t.id}}" data-choice="against">不同意</text>
          <text class="lp-vbtn ab" bindtap="submitVote" data-topic-id="{{t.id}}" data-choice="abstain">弃权</text>
        </view>
        <view wx:else class="lp-vote-locked">已选择：{{t.myChoiceLabel}}（不可修改）</view>

        <view class="lp-prog">
          <text class="lp-prog-line">同意：人数 {{t.forOwners}}/{{t.needOwners}} · 面积 {{t.forAreaWan}}/{{t.needAreaWan}} 万㎡</text>
          <text class="lp-prog-tag {{t.passed ? 'ok' : 'no'}}">{{t.passed ? '已双过半通过' : '待通过'}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- ═══ 户代表·完成 ═══ -->
  <view class="lp-card" wx:if="{{steps[currentStep-1].key === 'done'}}">
    <view class="lp-complete">
      <view class="lp-complete-icon">✓</view>
      <text class="lp-complete-title">{{isRepresentative ? '你代表的房屋已完成投票' : '大会进行中'}}</text>
      <text class="lp-complete-sub" wx:if="{{isRepresentative}}">已完成 {{topicTotal}} 项表决</text>
      <text class="lp-complete-tip">等待主持人结束大会并公示结果</text>
    </view>
  </view>

  <!-- ═══ 主席·结束公示 ═══ -->
  <view class="lp-card" wx:if="{{steps[currentStep-1].key === 'end'}}">
    <text class="lp-card-step">最后一步</text>
    <text class="lp-card-title">结束大会并公示</text>
    <text class="lp-card-desc">下面是结束前的参考情况，未完成项不影响结束。</text>

    <view class="lp-ready">
      <view class="lp-ready-row" wx:for="{{readiness}}" wx:key="label">
        <text class="lp-ready-icon {{item.ok ? 'ok' : 'no'}}">{{item.ok ? '✓' : '!'}}</text>
        <text class="lp-ready-label">{{item.label}}</text>
        <text class="lp-ready-detail {{item.ok ? 'ok' : 'no'}}">{{item.detail}}</text>
      </view>
    </view>

    <button class="lp-ghost-btn" bindtap="viewMinutes">查看纪要草稿</button>
    <button class="lp-primary-btn {{readyAllOk ? '' : 'warn'}}" bindtap="endMeeting" disabled="{{ending}}">
      {{ending ? '结束中…' : '结束大会并公示'}}
    </button>
  </view>

  <!-- 底部步骤导航 -->
  <view class="lp-nav">
    <button class="lp-nav-btn ghost" wx:if="{{currentStep > 1}}" bindtap="prevStep">上一步</button>
    <button class="lp-nav-btn ghost" wx:else bindtap="exitLive">退出</button>
    <button class="lp-nav-btn primary" wx:if="{{currentStep < stepTotal}}" bindtap="nextStep">下一步</button>
    <button class="lp-nav-btn ghost" wx:else bindtap="exitLive">返回大会详情</button>
  </view>

</scroll-view>
