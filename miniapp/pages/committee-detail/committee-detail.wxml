<scroll-view scroll-y class="page">
  <view wx:if="{{detail}}">
    <!-- 任务横幅（结束阶段隐藏；主任准备阶段用步骤条替代） -->
    <view class="task-banner {{detail.taskLevel}}" wx:if="{{detail.stage !== 'ended' && !(userView === 'chair' && detail.stage === 'preparing')}}">
      <text class="tb-title">{{detail.taskTitle}}</text>
      <text class="tb-items" wx:if="{{detail.taskItemsText}}">{{detail.taskItemsText}}</text>
      <text class="tb-flow">当前：{{detail.flowNodeText}}</text>
      <text class="tb-hint" wx:if="{{detail.taskHint}}">{{detail.taskHint}}</text>
    </view>

    <!-- ══════════ 主任准备阶段（卡片流布局） ══════════ -->
    <block wx:if="{{userView === 'chair' && detail.stage === 'preparing' && !noticePackageVisible}}">

      <!-- 会议头部 -->
      <view class="prep-head">
        <view class="ph-main">
          <text class="ph-title">{{detail.title}}</text>
          <view class="ph-meta">
            <text class="ph-meta-item"><text class="mi-k">时间</text>{{detail.meetingDate}} {{detail.meetingTime}}</text>
            <text class="ph-meta-item"><text class="mi-k">地点</text>{{detail.location}}</text>
          </view>
        </view>
        <view class="ph-actions">
          <text class="ph-action" bindtap="openEdit">编辑会议</text>
          <text class="ph-action danger" bindtap="removeMeeting">取消会议</text>
        </view>
      </view>

      <!-- 步骤条 -->
      <view class="prep-steps">
        <view class="prep-step {{item.state}}" wx:for="{{prepareSteps}}" wx:key="label">
          <view class="prep-dot">{{item.state === 'done' ? '✓' : index + 1}}</view>
          <text class="prep-lbl">{{item.label}}</text>
        </view>
      </view>

      <!-- 通知内容（草稿） -->
      <view class="prep-card">
        <view class="pc-head">
          <text class="pc-title">通知内容（草稿）</text>
          <view class="pc-head-actions">
            <text class="pc-badge {{detail.noticeDraft.status === 'edited' ? 'ok' : 'warn'}}">{{detail.noticeDraft.status === 'edited' ? '已确认' : '待确认'}}</text>
            <text class="pc-link" bindtap="editNoticeDraft">编辑通知</text>
          </view>
        </view>
        <text class="pc-draft">{{detail.noticeDraft.content}}</text>
      </view>

      <!-- 会议材料 -->
      <view class="prep-card">
        <view class="pc-head">
          <view>
            <text class="pc-title">会议材料</text>
            <text class="pc-desc">可选附件，没有材料也可以发送通知</text>
          </view>
          <view class="pc-head-actions">
            <text class="pc-sub">{{detail.materials ? detail.materials.length : 0}} 个文件</text>
            <text class="pc-link" bindtap="uploadMaterial">{{detail.materials && detail.materials.length ? '继续上传' : '上传'}}</text>
          </view>
        </view>
        <view wx:if="{{!detail.materials || !detail.materials.length}}" class="material-empty-inline">
          <text>暂无附件</text>
        </view>
        <block wx:else>
          <view class="pc-file" wx:for="{{detail.materials}}" wx:key="name" bindtap="previewMaterial" data-index="{{index}}">
            <text class="pf-ic">📄</text>
            <text class="pf-name">{{item.name}}</text>
            <text class="pf-size">{{item.sizeText || ''}}</text>
            <text class="pf-del" catchtap="removeMaterial" data-index="{{index}}">×</text>
          </view>
        </block>
      </view>

      <!-- 居委会见证 -->
      <view class="prep-card" wx:if="{{detail.record}}">
        <view class="pc-head">
          <view>
            <text class="pc-title">居委会见证</text>
            <text class="pc-desc">需要见证时，后续会议纪要会保留签字状态</text>
          </view>
          <switch checked="{{detail.record.hasMajorIssue}}" data-flag="hasMajorIssue" bindchange="toggleFlag" color="#FFA800" />
        </view>
        <view wx:if="{{detail.record.hasMajorIssue}}" class="juwei-prep-row">
          <text>见证人：{{detail.record.juweiName}}</text>
          <text class="fu-chip">会议中签字</text>
        </view>
      </view>

      <!-- 委员送达进度 -->
      <view class="prep-card" wx:if="{{detail.delivery}}">
        <view class="pc-head">
          <text class="pc-title">委员送达进度</text>
          <text wx:if="{{detail.delivery.total > 0}}" class="pc-sub link" bindtap="toggleDeliveryList">{{deliveryExpanded ? '收起名单' : '查看名单'}}</text>
        </view>
        <view wx:if="{{detail.delivery.total > 0}}" class="pc-progress">
          <view class="pp-col">
            <view class="pp-l"><text>已送达</text><text>{{detail.delivery.noticeDone}} / {{detail.delivery.total}}</text></view>
            <view class="pp-bar"><view class="pp-fill" style="width:{{detail.delivery.noticePct}}%"></view></view>
          </view>
          <view class="pp-col">
            <view class="pp-l"><text>已读</text><text>{{detail.delivery.readDone}} / {{detail.delivery.total}}</text></view>
            <view class="pp-bar"><view class="pp-fill read" style="width:{{detail.delivery.readPct}}%"></view></view>
          </view>
          <view class="pp-col" wx:if="{{detail.materials && detail.materials.length}}">
            <view class="pp-l"><text>材料</text><text>{{detail.delivery.materialDone}} / {{detail.delivery.total}}</text></view>
            <view class="pp-bar"><view class="pp-fill" style="width:{{detail.delivery.materialPct}}%"></view></view>
          </view>
        </view>
        <view wx:else class="pc-upload-empty">
          <text class="ue-txt">发送通知时选择应参会委员，名单将用于签到和会议纪要</text>
        </view>
        <view class="pc-members" wx:if="{{deliveryExpanded && detail.delivery.memberDeliveries}}">
          <view class="pcm-row" wx:for="{{detail.delivery.memberDeliveries}}" wx:key="userRoleId">
            <view class="pcm-main">
              <text class="pcm-name">{{item.name}}</text>
              <text class="pcm-role">{{item.role}}</text>
            </view>
            <view class="pcm-tags">
              <text class="pcm-tag {{item.noticeDelivered ? 'ok' : ''}}" bindtap="toggleDelivery" data-user-role-id="{{item.userRoleId}}" data-field="notice">{{item.noticeDelivered ? '通知✓' : '通知'}}</text>
              <text wx:if="{{item.noticeDelivered}}" class="pcm-tag read {{item.noticeRead ? 'ok' : ''}}">{{item.noticeRead ? '已读' : '未读'}}</text>
              <text wx:if="{{detail.materials && detail.materials.length}}" class="pcm-tag {{item.materialDelivered ? 'ok' : ''}}" bindtap="toggleDelivery" data-user-role-id="{{item.userRoleId}}" data-field="material">{{item.materialDelivered ? '材料✓' : '材料'}}</text>
            </view>
          </view>
        </view>
        <text class="pc-deadline">{{detail.delivery.noDate ? '请先设置会议日期' : (detail.delivery.daysLeft >= 0 ? '截止 ' + detail.delivery.deadlineStr + '（还剩 ' + detail.delivery.daysLeft + ' 天）' : '截止 ' + detail.delivery.deadlineStr + '（已逾期）')}}</text>
      </view>

    </block>

    <!-- 会议基本信息（结束阶段隐藏；主任准备阶段用上方卡片流替代） -->
    <view class="info-card" wx:if="{{detail.stage !== 'ended' && !(userView === 'chair' && detail.stage === 'preparing')}}">
      <view class="info-row"><text class="info-k">时间</text>{{detail.meetingDate}} {{detail.meetingTime}}</view>
      <view class="info-row"><text class="info-k">地点</text>{{detail.location}}</view>
      <view class="info-row" wx:if="{{detail.description}}"><text class="info-k">说明</text>{{detail.description}}</view>
    </view>

    <view class="notice-package-card" wx:if="{{noticePackageVisible}}">
      <view class="npc-head">
        <view>
          <text class="npc-title">会议通知与材料</text>
          <text class="npc-sub">{{detail.stage === 'ongoing' ? '会议已开始，仍可先查看会前送达内容' : '会前送达内容'}}</text>
        </view>
        <text class="npc-badge">已送达</text>
      </view>
      <view class="npc-section" wx:if="{{detail.noticeDraft}}">
        <text class="npc-section-title">会议通知</text>
        <text class="npc-content">{{detail.noticeDraft.content}}</text>
      </view>
      <view class="npc-section">
        <text class="npc-section-title">会议材料（{{detail.materials ? detail.materials.length : 0}}）</text>
        <view wx:if="{{detail.materials && detail.materials.length}}">
          <view wx:for="{{detail.materials}}" wx:key="name" class="mt-item" bindtap="previewMaterial" data-index="{{index}}">
            <text class="mt-name">{{item.name}}</text>
            <text class="mt-size">{{item.sizeText || ''}}</text>
            <text class="mt-arrow">›</text>
          </view>
        </view>
        <text wx:else class="npc-empty">暂无会议材料</text>
      </view>
    </view>

    <!-- 会议材料：委员仅在材料送达后可见（主任的材料卡在上方卡片流） -->
    <view class="materials-card" wx:if="{{!noticePackageVisible && detail.stage === 'preparing' && userView === 'member' && detail.myDelivery && detail.myDelivery.materialDelivered && detail.materials && detail.materials.length}}">
      <view class="mt-head-row">
        <text class="mt-title">会议材料（{{detail.materials ? detail.materials.length : 0}}）</text>
      </view>
      <view wx:if="{{detail.materials && detail.materials.length}}">
        <view wx:for="{{detail.materials}}" wx:key="name" class="mt-item" bindtap="previewMaterial" data-index="{{index}}">
          <text class="mt-name">{{item.name}}</text>
          <text class="mt-size">{{item.sizeText || ''}}</text>
          <text class="mt-arrow">›</text>
          <text wx:if="{{userView === 'chair'}}" class="mt-del" catchtap="removeMaterial" data-index="{{index}}">×</text>
        </view>
      </view>
      <view wx:else class="mt-empty">
        <text wx:if="{{userView === 'chair'}}">暂未上传材料，点击上方"上传材料"添加</text>
        <text wx:else>暂无会议材料</text>
      </view>
    </view>

    <!-- ══════════ 委员 和 主任/副主任 共用：个人操作 ══════════ -->
    <block wx:if="{{userView === 'member' || userView === 'chair'}}">
      <!-- 准备阶段：委员个人送达状态 -->
      <block wx:if="{{!noticePackageVisible && detail.stage === 'preparing' && detail.myDelivery}}">
        <!-- 通知已送达 → 显示通知草稿 -->
        <view class="my-delivery-card" wx:if="{{detail.myDelivery.noticeDelivered}}">
          <text class="mdc-title">📨 会议通知已送达</text>
          <text class="mdc-big {{detail.myDelivery.noticeRead ? 'ok' : ''}}">{{detail.myDelivery.noticeRead ? '你已确认阅读会议通知' : '会议通知已送达，请阅读后确认'}}</text>
          <button wx:if="{{!detail.myDelivery.noticeRead && !detail.noticeDraft}}" class="nd-confirm-btn" bindtap="confirmNoticeRead">我已阅读会议通知</button>
        </view>
        <view class="notice-draft-card" wx:if="{{detail.myDelivery.noticeDelivered && detail.noticeDraft}}">
          <view class="nd-head">
            <text class="nd-title">会议通知</text>
            <text class="nd-status ok">{{detail.myDelivery.noticeRead ? '已确认' : '已送达'}}</text>
          </view>
          <text class="nd-content">{{detail.noticeDraft.content}}</text>
          <button wx:if="{{!detail.myDelivery.noticeRead}}" class="nd-confirm-btn" bindtap="confirmNoticeRead">我已阅读会议通知</button>
        </view>
        <!-- 通知未送达 -->
        <view class="my-delivery-card" wx:else>
          <text class="mdc-title">会议通知</text>
          <text class="mdc-big">尚未送达，请等待主任发送通知</text>
        </view>
        <!-- 材料送达状态 -->
        <view class="my-delivery-card" wx:if="{{detail.myDelivery.noticeDelivered && detail.materials && detail.materials.length}}">
          <text class="mdc-title">📎 会议材料</text>
          <text class="mdc-big {{detail.myDelivery.materialDelivered ? 'ok' : ''}}">{{detail.myDelivery.materialDelivered ? '材料已送达' : '材料尚未送达'}}</text>
        </view>
      </block>

      <!-- 进行中：进入「会议进行」向导页 -->
      <block wx:if="{{detail.stage === 'ongoing' && detail.record}}">
        <view class="live-entry" bindtap="enterLive">
          <view class="live-entry-main">
            <text class="live-entry-title">会议进行中</text>
            <text class="live-entry-sub">确认参会 → 录音转写 → 确认表决</text>
          </view>
          <text class="live-entry-arrow">进入 ›</text>
        </view>
      </block>

    </block>

    <!-- ══════════ 结束阶段 ══════════ -->
    <block wx:if="{{detail.stage === 'ended'}}">
      <!-- 会议录音存档（委员/主任可见，外部无 record 自动隐藏）-->
      <view wx:if="{{detail.record && detail.record.recordingUrl}}" class="rec-archive-card">
        <view class="rac-head">
          <text class="rac-title">🎙 会议录音</text>
          <text class="rac-sub">{{recAudioPlaying ? '播放中…' : '会议全程录音存档'}}</text>
        </view>
        <view class="rac-actions">
          <button class="btn btn-outline" size="mini" bindtap="toggleRecording">{{recAudioPlaying ? '暂停' : '试听'}}</button>
          <button class="btn btn-ghost" size="mini" bindtap="downloadRecording">下载/转发</button>
        </view>
      </view>

      <!-- 委员：简洁结论 -->
      <block wx:if="{{userView === 'member'}}">
        <view class="ar-verdict {{detail.compliance}}">
          <view class="arv-icon">{{detail.compliance === 'valid' ? '✓' : detail.compliance === 'flawed' ? '!' : '✕'}}</view>
          <view class="arv-info">
            <text class="arv-title">{{detail.title}}</text>
            <text class="arv-meta">{{detail.meetingDate}} {{detail.meetingTime}} · {{detail.location}}</text>
            <text class="arv-result">{{detail.compliance === 'valid' ? '会议有效' : detail.compliance === 'flawed' ? '有效（带说明）' : '会议无效'}} · {{detail.publish && detail.publish.published ? '已公示归档' : detail._archived ? '已归档' : '待公示'}}</text>
            <text class="arv-reason" wx:if="{{detail.complianceReason}}">{{detail.complianceReason}}</text>
          </view>
        </view>
        <view class="flow-stats-card" wx:if="{{detail.flowStats}}">
          <view class="fsc-head">
            <text class="fsc-title">流程统计</text>
            <text class="fsc-sub">通知送达、参会确认和表决结果</text>
          </view>
          <view class="fss-row">
            <view class="fss-mark delivery">送</view>
            <view class="fss-main">
              <view class="fss-line"><text class="fss-name">通知与材料</text><text class="fss-num">{{detail.flowStats.delivery.noticeDone}}/{{detail.flowStats.delivery.total}}</text></view>
              <view class="fss-bar"><view class="fss-fill {{detail.flowStats.delivery.done ? 'ok' : 'warn'}}" style="width:{{detail.flowStats.delivery.pct}}%;"></view></view>
              <text class="fss-meta">通知 {{detail.flowStats.delivery.noticePct}}% · 材料 {{detail.flowStats.delivery.materialDone}}/{{detail.flowStats.delivery.total}}</text>
            </view>
            <text class="fss-status {{detail.flowStats.delivery.done ? 'ok' : 'warn'}}">{{detail.flowStats.delivery.done ? '已完成' : detail.flowStats.delivery.statusText}}</text>
          </view>
          <view class="fss-row">
            <view class="fss-mark attend">会</view>
            <view class="fss-main">
              <view class="fss-line"><text class="fss-name">确认参会</text><text class="fss-num">{{detail.flowStats.attendance.signedInCount}}/{{detail.flowStats.attendance.total}}</text></view>
              <view class="fss-bar"><view class="fss-fill {{detail.flowStats.attendance.done ? 'ok' : 'bad'}}" style="width:{{detail.flowStats.attendance.pct}}%;"></view></view>
              <text class="fss-meta">需≥{{detail.flowStats.attendance.need}} · {{detail.flowStats.attendance.pct}}%</text>
            </view>
            <text class="fss-status {{detail.flowStats.attendance.done ? 'ok' : 'bad'}}">{{detail.flowStats.attendance.statusText}}</text>
          </view>
          <view class="fss-row">
            <view class="fss-mark vote">票</view>
            <view class="fss-main">
              <view class="fss-line">
                <text class="fss-name">表决议题</text>
                <text class="fss-num" wx:if="{{detail.flowStats.vote.topicCount}}">{{detail.flowStats.vote.passedCount}}/{{detail.flowStats.vote.topicCount}}</text>
                <text class="fss-num" wx:else>无</text>
              </view>
              <view class="fss-bar"><view class="fss-fill {{detail.flowStats.vote.done ? 'ok' : 'warn'}}" style="width:{{detail.flowStats.vote.pct}}%;"></view></view>
              <text class="fss-meta">{{detail.flowStats.vote.metaText}}</text>
            </view>
            <text class="fss-status {{detail.flowStats.vote.done ? 'ok' : 'warn'}}">{{detail.flowStats.vote.statusText}}</text>
          </view>
        </view>
        <button class="btn btn-ghost" size="mini" bindtap="viewMinutes">查看会议纪要</button>
      </block>

      <!-- 主任：完整归档 -->
      <block wx:if="{{userView === 'chair'}}">
        <view class="ar-card {{detail.compliance}}">
          <view class="arc-head">
            <view class="arch-icon">{{detail.compliance === 'valid' ? '✓' : detail.compliance === 'flawed' ? '!' : '✕'}}</view>
            <view class="arch-info">
              <text class="arch-title">{{detail.title}}</text>
              <text class="arch-sub">{{detail.meetingDate}} {{detail.meetingTime}} · {{detail.location}}</text>
              <text class="arch-result">{{detail.compliance === 'valid' ? '会议有效' : detail.compliance === 'flawed' ? '有效（带说明）' : '会议无效'}} · {{detail.publish && detail.publish.published ? '已公示归档' : detail._archived ? '已归档' : '待公示'}}</text>
              <text class="arch-reason" wx:if="{{detail.complianceReason}}">{{detail.complianceReason}}</text>
            </view>
          </view>
          <view class="arc-fix">
            <text class="arcf-label">判定有误？</text>
            <text class="arcf-chip {{detail.compliance === 'valid' ? 'on' : ''}}" bindtap="markCompliance" data-status="valid">有效</text>
            <text class="arcf-chip {{detail.compliance === 'flawed' ? 'on' : ''}}" bindtap="markCompliance" data-status="flawed">瑕疵</text>
            <text class="arcf-chip {{detail.compliance === 'invalid' ? 'on' : ''}}" bindtap="markCompliance" data-status="invalid">无效</text>
          </view>
          <view class="flow-stats-panel" wx:if="{{detail.flowStats}}">
            <view class="fsc-head">
              <text class="fsc-title">流程统计</text>
              <text class="fsc-sub">通知送达、参会确认和表决结果</text>
            </view>
            <view class="fss-row">
              <view class="fss-mark delivery">送</view>
              <view class="fss-main">
                <view class="fss-line"><text class="fss-name">通知与材料</text><text class="fss-num">{{detail.flowStats.delivery.noticeDone}}/{{detail.flowStats.delivery.total}}</text></view>
                <view class="fss-bar"><view class="fss-fill {{detail.flowStats.delivery.done ? 'ok' : 'warn'}}" style="width:{{detail.flowStats.delivery.pct}}%;"></view></view>
                <text class="fss-meta">通知 {{detail.flowStats.delivery.noticePct}}% · 材料 {{detail.flowStats.delivery.materialDone}}/{{detail.flowStats.delivery.total}}</text>
              </view>
              <text class="fss-status {{detail.flowStats.delivery.done ? 'ok' : 'warn'}}">{{detail.flowStats.delivery.done ? '已完成' : detail.flowStats.delivery.statusText}}</text>
            </view>
            <view class="fss-row">
              <view class="fss-mark attend">会</view>
              <view class="fss-main">
                <view class="fss-line"><text class="fss-name">确认参会</text><text class="fss-num">{{detail.flowStats.attendance.signedInCount}}/{{detail.flowStats.attendance.total}}</text></view>
                <view class="fss-bar"><view class="fss-fill {{detail.flowStats.attendance.done ? 'ok' : 'bad'}}" style="width:{{detail.flowStats.attendance.pct}}%;"></view></view>
                <text class="fss-meta">需≥{{detail.flowStats.attendance.need}} · {{detail.flowStats.attendance.pct}}%</text>
              </view>
              <text class="fss-status {{detail.flowStats.attendance.done ? 'ok' : 'bad'}}">{{detail.flowStats.attendance.statusText}}</text>
            </view>
            <view class="fss-row">
              <view class="fss-mark vote">票</view>
              <view class="fss-main">
                <view class="fss-line">
                  <text class="fss-name">表决议题</text>
                  <text class="fss-num" wx:if="{{detail.flowStats.vote.topicCount}}">{{detail.flowStats.vote.passedCount}}/{{detail.flowStats.vote.topicCount}}</text>
                  <text class="fss-num" wx:else>无</text>
                </view>
                <view class="fss-bar"><view class="fss-fill {{detail.flowStats.vote.done ? 'ok' : 'warn'}}" style="width:{{detail.flowStats.vote.pct}}%;"></view></view>
                <text class="fss-meta">{{detail.flowStats.vote.metaText}}</text>
              </view>
              <text class="fss-status {{detail.flowStats.vote.done ? 'ok' : 'warn'}}">{{detail.flowStats.vote.statusText}}</text>
            </view>
          </view>
          <view class="arc-list">
            <view class="arcl-row" bindtap="viewNoticeDraft" wx:if="{{detail.noticeDraft}}">
              <view class="arcl-icon notice">📄</view><view class="arcl-info"><text class="arcl-name">会议通知</text><text class="arcl-meta">创建时自动生成</text></view><text class="arcl-arrow">›</text>
            </view>
            <view class="arcl-row" wx:if="{{detail.materials && detail.materials.length}}" bindtap="previewArchiveMaterials">
              <view class="arcl-icon mat">📎</view><view class="arcl-info"><text class="arcl-name">会议材料</text><text class="arcl-meta">{{detail.materials.length}} 份附件</text></view><text class="arcl-arrow">›</text>
            </view>
            <view class="arcl-row" wx:if="{{detail.record && detail.record.evidences && detail.record.evidences.length}}">
              <view class="arcl-icon ev">🖼️</view><view class="arcl-info"><text class="arcl-name">线下佐证</text><text class="arcl-meta">{{detail.record.evidences.length}} 张照片</text></view><text class="arcl-arrow">›</text>
            </view>
            <view class="arcl-row" bindtap="viewMinutes">
              <view class="arcl-icon min">📝</view><view class="arcl-info"><text class="arcl-name">会议纪要</text><text class="arcl-meta">含参会情况与决议结果，可查看导出</text></view><text class="arcl-arrow">›</text>
            </view>
            <view class="arcl-row" wx:for="{{detail.archiveExtras}}" wx:for-item="ae" wx:key="id" wx:if="{{detail.archiveExtras && detail.archiveExtras.length}}">
              <view class="arcl-icon extra">📎</view><view class="arcl-info"><text class="arcl-name">{{ae.fileName}}</text><text class="arcl-meta">归档后补充 · {{ae.reason || '补充资料'}}{{ae.addedBy ? ' · ' + ae.addedBy : ''}}</text></view><text class="arcl-arrow">留痕</text>
            </view>
          </view>
          <view class="arc-add" bindtap="addArchiveExtra"><text>+ 补充归档材料</text></view>
          <view class="arc-log" wx:if="{{detail.archiveLog && detail.archiveLog.length}}">
            <text class="arclog-title">操作记录</text>
            <view class="arclog-row" wx:for="{{detail.archiveLog}}" wx:for-item="lg" wx:key="id">
              <text class="arclog-action">{{lg.action}}</text>
              <text class="arclog-meta">{{lg.operator}} · {{lg.at}}</text>
              <text class="arclog-reason" wx:if="{{lg.reason}}">{{lg.reason}}</text>
            </view>
          </view>
        </view>
        <view class="ar-publish" wx:if="{{detail.compliance !== 'invalid'}}">
          <view wx:if="{{detail.publish && detail.publish.published}}" class="arp-done">
            <text class="arp-check">✓</text>
            <text>已于 {{detail.publish.publishDate}} 公示{{detail.publish.publishedBy ? '（' + detail.publish.publishedBy + '）' : ''}}，归档完成</text>
            <view class="arp-actions">
              <text class="ar-skip" bindtap="viewMinutesRevisions">版本历史</text>
              <text class="ar-skip danger" bindtap="withdrawPublish">撤回公示</text>
            </view>
          </view>
          <view wx:elif="{{detail.publish && detail.publish.withdrawn}}" class="arp-done withdrawn">
            <text>⚠ 公示已撤回{{detail.publish.withdrawnBy ? '（' + detail.publish.withdrawnBy + '）' : ''}}{{detail.publish.withdrawReason ? '：' + detail.publish.withdrawReason : ''}}</text>
            <button class="btn btn-primary" style="width:100%;margin-top:8px;" bindtap="publishNow">修订后重新公示</button>
            <text class="ar-skip" bindtap="viewMinutesRevisions">版本历史</text>
          </view>
          <view wx:elif="{{detail._archived}}" class="arp-done">
            <text class="arp-check">✓</text><text>已归档（未公示）</text>
            <view class="arp-actions">
              <text class="ar-skip danger" bindtap="revokeArchive">撤销归档</text>
            </view>
          </view>
          <block wx:else>
            <text class="ext-hint withdrawn" wx:if="{{detail.revokeArchiveReason}}">⚠ 归档已撤销：{{detail.revokeArchiveReason}}，请确认后重新归档</text>
            <button class="btn btn-primary" style="width:100%;" bindtap="publishNow">发起公示</button>
            <text class="ar-skip" bindtap="archiveDirect">直接归档，不公示</text>
          </block>
        </view>
        <view class="ar-publish invalid" wx:else><text>会议无效，无需公示，资料留档备查</text></view>
      </block>
    </block>

    <!-- 进行中（主任/委员）统一收敛到「会议进行」向导页（live-entry 入口），此处不再内联管理 -->

    <!-- ══════════ 外部视图 ══════════ -->
    <block wx:if="{{userView === 'owner' || userView === 'property'}}">
      <view class="ext-banner {{userView}}">
        <text>{{userView === 'owner' ? '🏠 业主视角·只读' : '🏢 物业视角·只读'}}</text>
        <text class="ext-sub">仅展示对外公开信息，不可操作</text>
      </view>
      <block wx:if="{{detail.stage === 'ended' && detail.compliance !== 'invalid' && detail.publish && detail.publish.published}}">
        <button class="btn btn-ghost" size="mini" bindtap="viewMinutes">查看公示纪要</button>
      </block>
      <block wx:elif="{{detail.publish && detail.publish.withdrawn}}">
        <text class="ext-hint withdrawn">⚠ 该会议纪要已撤回公示</text>
      </block>
      <block wx:elif="{{detail.compliance === 'invalid'}}">
        <text class="ext-hint withdrawn">⚠ 该会议已作废</text>
      </block>
      <block wx:else>
        <text class="ext-hint">会议结束公示后可查看会议纪要</text>
      </block>
    </block>
  </view>
</scroll-view>

<!-- 准备阶段（主任）：底部固定主操作 -->
<view class="prep-footer" wx:if="{{detail && userView === 'chair' && detail.stage === 'preparing'}}">
  <button wx:if="{{prepareMode === 'send'}}" class="pf-btn" bindtap="sendAll">选择通知对象并发送</button>
  <button wx:else class="pf-btn" bindtap="startMeeting">开始会议</button>
  <text class="pf-hint">{{prepareHint}}</text>
</view>

<!-- 发送通知时选择应参会人员 -->
<view wx:if="{{sendVisible}}" class="modal-mask" bindtap="closeSendDialog">
  <view class="form-sheet send-sheet" catchtap="noop">
    <view class="sheet-head">
      <text class="sheet-title">选择通知对象</text>
      <text class="sheet-close" bindtap="closeSendDialog">×</text>
    </view>
    <view class="send-summary">
      <text>已选 {{sendSelectedCount}} / {{sendMembers.length}}</text>
      <view class="send-actions">
        <text bindtap="selectAllSendMembers">全选</text>
        <text class="muted" bindtap="clearSendMembers">清空</text>
      </view>
    </view>
    <scroll-view scroll-y class="send-member-list">
      <view wx:for="{{sendMembers}}" wx:key="userRoleId" class="send-member {{item.checked ? 'on' : ''}}" bindtap="toggleSendMember" data-id="{{item.userRoleId}}">
        <view class="send-check">{{item.checked ? '✓' : ''}}</view>
        <view class="send-person">
          <text class="send-name">{{item.name}}</text>
          <text class="send-meta">{{item.role}}{{item.roomNumber ? ' · ' + item.roomNumber : ''}}</text>
        </view>
      </view>
      <view wx:if="{{!sendMembers.length}}" class="proxy-empty">暂无可通知的业委会成员</view>
    </scroll-view>
    <view class="sheet-actions">
      <button class="btn btn-ghost" bindtap="closeSendDialog">取消</button>
      <button class="btn btn-primary" loading="{{sendSubmitting}}" bindtap="confirmSendAll">发送通知</button>
    </view>
  </view>
</view>

<!-- 添加议题弹窗 -->
<view wx:if="{{addTopicVisible}}" class="modal-mask" bindtap="closeAddTopic">
  <view class="form-sheet" catchtap="noop" style="padding-bottom:calc(18px + env(safe-area-inset-bottom));">
    <view class="sheet-head">
      <text class="sheet-title">添加议题</text>
      <text class="sheet-close" bindtap="closeAddTopic">×</text>
    </view>

    <view class="form-group">
      <text class="form-label">议题名称</text>
      <input class="form-input large" value="{{newTopicForm.title}}" data-field="title" bindinput="onTopicFormInput" placeholder="输入议题名称" placeholder-class="input-placeholder" />
    </view>

    <view class="form-group">
      <text class="form-label">表决类型</text>
      <view class="type-row">
        <text class="type-chip {{newTopicForm.decisionType === 'simple' ? 'on' : ''}}" bindtap="pickDecisionType" data-type="simple">普通表决</text>
        <text class="type-chip {{newTopicForm.decisionType === 'multi_choice' ? 'on' : ''}}" bindtap="pickDecisionType" data-type="multi_choice">多选一</text>
      </view>
    </view>

    <view wx:if="{{newTopicForm.decisionType === 'multi_choice'}}" class="form-group">
      <text class="form-label">选项（每行一个，第一个为默认选项）</text>
      <textarea class="form-textarea" value="{{newTopicForm.optionsText}}" data-field="optionsText" bindinput="onTopicFormInput" placeholder="每行写一个选项，如：&#10;完全更换为智能门禁&#10;保留现有门禁，加装人脸识别&#10;暂不改造，维持现状" placeholder-class="input-placeholder" style="min-height:90px;height:90px;" />
    </view>

    <view class="form-group">
      <view class="realname-row" bindtap="toggleRealName">
        <view>
          <text class="form-label">实名表决</text>
          <text class="realname-hint">开启后将公开每位委员的投票选择，须在投票前确定</text>
        </view>
        <view class="rn-switch {{newTopicForm.realName ? 'on' : ''}}"><view class="rn-knob"></view></view>
      </view>
    </view>

    <view class="sheet-actions">
      <button class="btn btn-ghost" bindtap="closeAddTopic">取消</button>
      <button class="btn btn-primary" bindtap="submitAddTopic">确认添加</button>
    </view>
  </view>
</view>

<!-- 代录弹层 -->
<view wx:if="{{proxyVisible}}" class="modal-mask" bindtap="closeProxyRecorder">
  <view class="form-sheet proxy-sheet" catchtap="noop">
    <view class="sheet-head">
      <text class="sheet-title">会议代录</text>
      <text class="sheet-close" bindtap="closeProxyRecorder">×</text>
    </view>

    <view class="proxy-tabs">
      <text class="proxy-tab {{proxyAction === 'signIn' ? 'on' : ''}}" bindtap="pickProxyAction" data-action="signIn">代确认参会</text>
      <text class="proxy-tab {{proxyAction === 'vote' ? 'on' : ''}}" bindtap="pickProxyAction" data-action="vote">代投票</text>
    </view>

    <view wx:if="{{proxyAction === 'vote'}}" class="proxy-section">
      <text class="form-label">选择议题</text>
      <view class="proxy-topic-list">
        <text wx:for="{{detail.record.topics}}" wx:key="id" class="proxy-topic {{proxyTopicId == item.id ? 'on' : ''}}" bindtap="pickProxyTopic" data-topic-id="{{item.id}}">{{item.title}}</text>
      </view>
      <block wx:for="{{detail.record.topics}}" wx:for-item="topic" wx:key="id">
        <view wx:if="{{proxyTopicId == topic.id && topic.decisionType !== 'multi_choice'}}" class="proxy-choice-row">
          <text class="proxy-choice for {{proxyChoice === 'for_vote' ? 'on' : ''}}" bindtap="pickProxyChoice" data-choice="for_vote">赞成</text>
          <text class="proxy-choice ag {{proxyChoice === 'against' ? 'on' : ''}}" bindtap="pickProxyChoice" data-choice="against">反对</text>
          <text class="proxy-choice ab {{proxyChoice === 'abstain' ? 'on' : ''}}" bindtap="pickProxyChoice" data-choice="abstain">弃权</text>
        </view>
        <view wx:if="{{proxyTopicId == topic.id && topic.decisionType === 'multi_choice'}}" class="proxy-option-list">
          <view class="proxy-option {{proxySelectedId == opt.id ? 'on' : ''}}" wx:for="{{topic.options}}" wx:for-item="opt" wx:key="id" bindtap="pickProxyOption" data-selected-id="{{opt.id}}">
            <text>{{opt.label}}</text>
          </view>
        </view>
      </block>
    </view>

    <view class="proxy-section">
      <text class="form-label">选择代录对象</text>
      <input class="form-input" value="{{proxyKeyword}}" bindinput="onProxyKeywordInput" placeholder="搜索姓名或房号" placeholder-class="input-placeholder" />
      <scroll-view scroll-y class="proxy-target-list">
        <view wx:for="{{proxyTargets}}" wx:key="memberId" class="proxy-target {{item.checked ? 'on' : ''}} {{item.disabled ? 'disabled' : ''}}" bindtap="toggleProxyTarget" data-member-id="{{item.memberId}}">
          <view class="proxy-check">{{item.checked ? '✓' : ''}}</view>
          <view class="proxy-person">
            <text class="proxy-name">{{item.name}}</text>
            <text class="proxy-meta">{{item.role}}{{item.roomNumber ? ' · ' + item.roomNumber : ''}}</text>
          </view>
          <text wx:if="{{item.disabledText}}" class="proxy-state">{{item.disabledText}}</text>
        </view>
        <view wx:if="{{!proxyTargets.length}}" class="proxy-empty">没有匹配人员</view>
      </scroll-view>
    </view>

    <view class="proxy-section">
      <text class="form-label">代录凭证</text>
      <view class="proof-picker" bindtap="pickProxyProof">
        <text class="proof-main">{{proxyProofName || '上传现场照片、授权截图或纸质凭证'}}</text>
        <text class="proof-action">{{proxyProofName ? '重新选择' : '选择图片'}}</text>
      </view>
    </view>

    <view class="proxy-submit-row">
      <text class="proxy-count">已选 {{proxySelectedCount}} 人</text>
      <button class="btn btn-primary proxy-submit" loading="{{proxySubmitting}}" bindtap="submitProxyAction">提交代录</button>
    </view>
  </view>
</view>

<!-- 编辑会议弹窗 -->
<view wx:if="{{editVisible}}" class="modal-mask" bindtap="closeEdit">
  <view class="form-sheet" catchtap="noop" style="padding-bottom:calc(18px + env(safe-area-inset-bottom));">
    <view class="sheet-head">
      <text class="sheet-title">编辑会议</text>
      <text class="sheet-close" bindtap="closeEdit">×</text>
    </view>

    <view class="form-group">
      <text class="form-label">会议标题 *</text>
      <input class="form-input large" value="{{editForm.title}}" data-field="title" bindinput="onEditInput" placeholder="会议标题" placeholder-class="input-placeholder" />
    </view>

    <view class="form-row">
      <view class="form-group half">
        <text class="form-label">会议日期 *</text>
        <picker mode="date" value="{{editForm.meetingDate}}" bindchange="onEditDateChange">
          <view class="picker-field">{{editForm.meetingDate || '选择日期'}}</view>
        </picker>
      </view>
      <view class="form-group half">
        <text class="form-label">开始时间 *</text>
        <picker mode="time" value="{{editForm.meetingTime}}" bindchange="onEditTimeChange">
          <view class="picker-field">{{editForm.meetingTime || '选择时间'}}</view>
        </picker>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">会议地点</text>
      <input class="form-input" value="{{editForm.location}}" data-field="location" bindinput="onEditInput" placeholder="请输入会议地点" placeholder-class="input-placeholder" />
    </view>

    <view class="form-group">
      <text class="form-label">主要议题 / 补充说明</text>
      <textarea class="form-textarea" style="min-height:72px;height:72px;" value="{{editForm.description}}" data-field="description" bindinput="onEditInput" placeholder="主要议题或其他需要记录的事项" placeholder-class="input-placeholder" />
    </view>

    <view class="form-group">
      <text class="form-label">通知正文</text>
      <text class="form-hint">默认按上面信息自动生成；如需自定义措辞可在此直接编辑。</text>
      <textarea class="form-textarea" style="min-height:160px;height:160px;" value="{{editForm.content}}" data-field="content" bindinput="onEditInput" placeholder="通知正文" placeholder-class="input-placeholder" />
    </view>

    <view class="sheet-actions">
      <button class="btn btn-ghost" bindtap="closeEdit">取消</button>
      <button class="btn btn-primary" bindtap="submitEdit">保存修改</button>
    </view>
  </view>
</view>
