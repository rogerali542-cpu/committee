.main-page { min-height: 100vh; background: #f5f5f5; padding-bottom: 70px; }
.header {
  background: linear-gradient(160deg, #FFCC44, #FFA800);
  padding: 22px 20px 24px;
}
.header-title { font-size: 22px; font-weight: 700; color: #5C3D00; display: block; }
.header-sub { font-size: 12px; color: #7B5A00; margin-top: 4px; display: block; }

.stats-bar {
  margin: 0 12px;
  background: #FFFBF0;
  border-radius: 14px;
  padding: 14px 0;
  display: flex;
  border: 1px solid #FFE9A0;
  position: relative;
  top: -6px;
}
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-item:not(:last-child) { border-right: 1px solid #FFE9A0; }
.stat-num { font-size: 22px; font-weight: 700; color: #333; }
.stat-unit { font-size: 12px; font-weight: 400; color: #999; }
.stat-label { font-size: 11px; color: #999; margin-top: 2px; }

.menu-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16px 0;
  padding: 16px 12px;
  margin: 0 12px;
  background: #FFFBF0;
  border-radius: 14px;
  border: 1px solid #FFE9A0;
}
.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}
.mi-icon {
  width: 46px; height: 46px;
  border-radius: 14px;
  background: #FFF3DC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
}
.menu-item text { font-size: 12px; color: #555; }

/* ── 详情模式：分组 ── */
.detail-wrap { padding: 8px 0 16px; }
.grp { margin-bottom: 14px; }
.grp-title {
  display: block;
  font-size: 13px; font-weight: 700; color: #888;
  margin: 0 16px 8px;
}
.grp .menu-grid {
  margin: 0 12px;
  padding: 14px 8px;
  background: #fff;
  border: none;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  justify-items: center;
}

/* ── 简洁模式：任务列表 ── */
.s-list { padding: 10px 12px 16px; }
.s-row {
  display: flex; align-items: center;
  background: #fff; border-radius: 14px;
  padding: 14px; margin-bottom: 10px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.s-ico {
  width: 44px; height: 44px; border-radius: 13px;
  background: #FFF3DC;
  display: flex; align-items: center; justify-content: center;
  font-size: 23px; margin-right: 12px; flex-shrink: 0;
}
.s-body { flex: 1; min-width: 0; }
.s-title { font-size: 16px; font-weight: 600; color: #333; display: block; }
.s-sub { font-size: 12px; color: #999; margin-top: 3px; display: block; }
.s-right { display: flex; align-items: center; gap: 8px; margin-left: 8px; }
.s-num {
  min-width: 20px; height: 20px; padding: 0 6px; box-sizing: border-box;
  background: #FFA800; color: #fff; font-size: 12px; font-weight: 600;
  line-height: 20px; text-align: center; border-radius: 10px;
}
.s-num.red { background: #FF4D4F; }
.s-arrow { font-size: 18px; color: #ccc; }

/* ── 简洁/详情 切换 ── */
.mode-toggle {
  display: flex;
  margin: 8px 12px 0;
  background: #FFF3DC;
  border-radius: 12px;
  padding: 3px;
}
.mt-seg {
  flex: 1;
  text-align: center;
  font-size: 14px;
  color: #9a7b2e;
  padding: 7px 0;
  border-radius: 9px;
}
.mt-seg.on {
  background: #fff;
  color: #B8860B;
  font-weight: 700;
  box-shadow: 0 1px 4px rgba(0,0,0,0.08);
}

/* ── 简洁模式 ── */
.simple-wrap { padding: 4px 12px 16px; }
.simple-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.simple-card {
  background: #FFFBF0;
  border: 1px solid #FFE9A0;
  border-radius: 14px;
  padding: 18px 14px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.sc-icon {
  width: 48px; height: 48px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
  position: relative;
  margin-bottom: 10px;
}
.sc-badge {
  position: absolute;
  top: -6px; right: -6px;
  min-width: 18px; height: 18px;
  padding: 0 5px;
  box-sizing: border-box;
  background: #FF4D4F;
  color: #fff;
  font-size: 11px;
  line-height: 18px;
  text-align: center;
  border-radius: 9px;
}
.sc-title { font-size: 16px; font-weight: 700; color: #333; }
.sc-sub { font-size: 12px; color: #999; margin-top: 4px; }

.detail-toggle {
  text-align: center;
  font-size: 13px;
  color: #B8860B;
  padding: 16px 0 8px;
}
.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16px 0;
  padding: 16px 12px;
  background: #FFFBF0;
  border-radius: 14px;
  border: 1px solid #FFE9A0;
}
