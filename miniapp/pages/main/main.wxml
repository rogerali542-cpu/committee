<view class="main-page">
  <!-- Header -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <text class="header-title">业委专区</text>
    <text class="header-sub">{{activeRole.realName}} · {{activeRole.role}}</text>
  </view>

  <!-- Stats Bar -->
  <view class="stats-bar">
    <view class="stat-item" bindtap="goTodo">
      <text class="stat-num">{{stats.todo}}<text class="stat-unit"> 件</text></text>
      <text class="stat-label">今日待办 ›</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.done}}<text class="stat-unit"> 件</text></text>
      <text class="stat-label">已完成</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.overdue}}<text class="stat-unit"> 件</text></text>
      <text class="stat-label">已超期</text>
    </view>
  </view>

  <!-- 物业：固定工作台 -->
  <view wx:if="{{isProperty}}" class="simple-wrap">
    <view class="simple-grid">
      <view class="simple-card" bindtap="goPropertyTasks">
        <view class="sc-icon" style="background:#FFF3DC;">🛠️
          <view wx:if="{{propTodo > 0}}" class="sc-badge">{{propTodo > 99 ? '99+' : propTodo}}</view>
        </view>
        <text class="sc-title">物业工单</text>
        <text class="sc-sub">业委会转来的待处理诉求</text>
      </view>
      <view class="simple-card" bindtap="goNotifications">
        <view class="sc-icon" style="background:#FFF3DC;">🔔
          <view wx:if="{{unread > 0}}" class="sc-badge">{{unread > 99 ? '99+' : unread}}</view>
        </view>
        <text class="sc-title">我的通知</text>
        <text class="sc-sub">派单与反馈提醒</text>
      </view>
      <view class="simple-card" bindtap="goReception">
        <view class="sc-icon" style="background:#FFF3DC;">📋</view>
        <text class="sc-title">接待记录</text>
        <text class="sc-sub">查看接待制度与诉求台账</text>
      </view>
      <view class="simple-card" bindtap="goInfoPublic">
        <view class="sc-icon" style="background:#FFF3DC;">📢</view>
        <text class="sc-title">公示公告</text>
        <text class="sc-sub">小区公开信息</text>
      </view>
    </view>
  </view>

  <!-- 其余角色：简洁 / 详情 切换 -->
  <block wx:else>
    <view class="mode-toggle">
      <view class="mt-seg {{viewMode==='simple'?'on':''}}" bindtap="setViewMode" data-mode="simple">简洁</view>
      <view class="mt-seg {{viewMode==='detail'?'on':''}}" bindtap="setViewMode" data-mode="detail">详情</view>
    </view>

    <!-- 简洁模式：高频任务列表 -->
    <view wx:if="{{viewMode==='simple'}}" class="s-list">
      <view class="s-row" bindtap="goTodo">
        <view class="s-ico">✅</view>
        <view class="s-body"><text class="s-title">我要办理</text><text class="s-sub">需要我确认或表决</text></view>
        <view class="s-right">
          <text wx:if="{{stats.todo > 0}}" class="s-num">{{stats.todo}}</text>
          <text class="s-arrow">›</text>
        </view>
      </view>
      <view class="s-row" bindtap="goNotifications">
        <view class="s-ico">🔔</view>
        <view class="s-body"><text class="s-title">我的通知</text><text class="s-sub">会议、送达、公示提醒</text></view>
        <view class="s-right">
          <text wx:if="{{unread > 0}}" class="s-num red">{{unread}}</text>
          <text class="s-arrow">›</text>
        </view>
      </view>
      <view class="s-row" bindtap="goInfoPublic">
        <view class="s-ico">📢</view>
        <view class="s-body"><text class="s-title">公示公告</text><text class="s-sub">正在公示的纪要与决定</text></view>
        <view class="s-right"><text class="s-arrow">›</text></view>
      </view>
      <view class="s-row" bindtap="goPropertyBoard">
        <view class="s-ico">🏠</view>
        <view class="s-body"><text class="s-title">物业事项</text><text class="s-sub">物业问题处理进展</text></view>
        <view class="s-right"><text class="s-arrow">›</text></view>
      </view>
      <view wx:if="{{canViewInternal}}" class="s-row" bindtap="goLibrary">
        <view class="s-ico">📚</view>
        <view class="s-body"><text class="s-title">资料库</text><text class="s-sub">历史会议归档查阅</text></view>
        <view class="s-right"><text class="s-arrow">›</text></view>
      </view>
    </view>

    <!-- 详情模式：按类分组的全功能模块 -->
    <view wx:else class="detail-wrap">
      <view class="grp">
        <text class="grp-title">会议与事务</text>
        <view class="menu-grid">
          <view class="menu-item" bindtap="goCommittee">
            <view class="mi-icon">📋</view><text>业委会会议</text>
          </view>
          <view class="menu-item" bindtap="goReception">
            <view class="mi-icon">🤝</view><text>接待记录</text>
          </view>
          <view class="menu-item" bindtap="goLearning">
            <view class="mi-icon">📖</view><text>学习培训</text>
          </view>
        </view>
      </view>

      <view class="grp">
        <text class="grp-title">我的 · 公开</text>
        <view class="menu-grid">
          <view class="menu-item" bindtap="goTodo">
            <view class="mi-icon">✅</view><text>我要办理</text>
          </view>
          <view class="menu-item" bindtap="goNotifications">
            <view class="mi-icon">🔔</view><text>我的通知</text>
          </view>
          <view class="menu-item" bindtap="goInfoPublic">
            <view class="mi-icon">📢</view><text>信息公开</text>
          </view>
          <view wx:if="{{canViewInternal}}" class="menu-item" bindtap="goLibrary">
            <view class="mi-icon">📚</view><text>资料库</text>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
