<view class="home">
  <!-- 顶栏：标题 + 通知铃 -->
  <view class="hd" style="padding-top: {{statusBarHeight}}px;">
    <view class="hd-left">
      <text class="hd-title">业委专区</text>
      <text class="hd-sub">{{activeRole.realName}} · {{activeRole.role}}</text>
    </view>
    <view class="hd-bell" bindtap="goNotifications">
      <text class="hd-bell-ico">🔔</text>
      <view wx:if="{{unread > 0}}" class="hd-badge">{{unread > 99 ? '99+' : unread}}</view>
    </view>
  </view>

  <!-- ① 有进行中的会议：开会主线　② 否则：空闲态 -->
  <view wx:if="{{current}}" class="meet-card">
    <text class="meet-tag">正在开的会</text>
    <text class="meet-title">{{current.title}}</text>
    <text class="meet-meta">{{current.meetingDate}} {{current.meetingTime}} · {{current.location}}</text>

    <!-- 三步进度 -->
    <view class="steps">
      <block wx:for="{{current.steps}}" wx:key="no">
        <view wx:if="{{index > 0}}" class="step-line {{item.state === 'todo' ? 'todo' : 'done'}}"></view>
        <view class="step {{item.state}}">
          <view class="step-dot">
            <text wx:if="{{item.state === 'done'}}">✓</text>
            <text wx:else>{{item.no}}</text>
          </view>
          <text class="step-label">{{item.label}}</text>
        </view>
      </block>
    </view>

    <!-- 当前步主操作（大按钮） -->
    <view class="big-btn" bindtap="goCurrent">
      <text class="big-btn-ico">{{current.ctaIcon}}</text>
      <text class="big-btn-text">{{current.ctaLabel}}</text>
    </view>

    <!-- 删除会议（仅主任；清理测试数据用） -->
    <view wx:if="{{canCreate}}" class="meet-del" bindtap="removeCurrent">删除会议</view>
  </view>

  <block wx:else>
    <view wx:if="{{canCreate}}" class="idle">
      <text class="idle-hint">当前没有进行中的会议</text>
      <view class="big-btn primary" bindtap="goCreate">
        <text class="big-btn-ico">➕</text>
        <text class="big-btn-text">发起会议</text>
      </view>
    </view>
    <view wx:else class="idle">
      <text class="idle-emoji">☕</text>
      <text class="idle-hint">暂时没有需要您处理的会议</text>
      <text class="idle-sub">有新会议时，会在这里提醒您</text>
    </view>

    <!-- 最近一次会议 -->
    <view wx:if="{{recent}}" class="recent" bindtap="goRecent">
      <view class="recent-head">最近一次会议</view>
      <view class="recent-row">
        <view class="recent-body">
          <text class="recent-title">{{recent.title}}</text>
          <text class="recent-meta">{{recent.meetingDate}} · {{recent.status}}</text>
        </view>
        <text class="recent-arrow">›</text>
      </view>
    </view>
  </block>

  <!-- 更多功能（配角） -->
  <view class="more">
    <text class="more-title">更多功能</text>
    <view class="more-grid">
      <view class="more-item" bindtap="goReception">
        <text class="more-ico">🤝</text>
        <text class="more-label">接待记录</text>
      </view>
      <view class="more-item" bindtap="goLearning">
        <text class="more-ico">📖</text>
        <text class="more-label">学习培训</text>
      </view>
      <view wx:if="{{canViewInternal}}" class="more-item" bindtap="goLibrary">
        <text class="more-ico">📚</text>
        <text class="more-label">历史会议</text>
      </view>
    </view>
  </view>
</view>
