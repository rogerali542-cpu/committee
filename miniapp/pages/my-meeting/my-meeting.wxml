<view class="mm">
  <!-- 会议信息 -->
  <view class="mm-card">
    <text class="mm-title">{{title}}</text>
    <view class="mm-meta">
      <text class="mm-meta-row">🕒 {{dateText}}</text>
      <text class="mm-meta-row">📍 {{location}}</text>
    </view>
    <text wx:if="{{description}}" class="mm-desc">{{description}}</text>
  </view>

  <!-- 阶段主区：准备→确认参加 / 进行中→录音+材料 / 已结束→查看结果 -->
  <view wx:if="{{stage === 'preparing'}}" class="mm-card">
    <view wx:if="{{!signedIn}}" class="mm-big-btn" bindtap="confirmAttend">
      <text class="mm-big-ico">✅</text>
      <text class="mm-big-text">确认参加</text>
    </view>
    <view wx:else class="mm-done">
      <view class="mm-done-row">
        <text class="mm-done-ico">✓</text>
        <text class="mm-done-text">已确认参加</text>
      </view>
      <text class="mm-cancel" bindtap="cancelAttend">取消参加</text>
    </view>
  </view>

  <!-- 进行中：录音 + 材料 -->
  <view wx:if="{{stage === 'ongoing'}}" class="mm-card">
    <text class="mm-section-title">会议录音</text>
    <text class="mm-section-desc">录音用于帮助记录员整理会议内容，只保存不自动处理</text>

    <!-- 录音控件（需已签到） -->
    <view wx:if="{{signedIn}}">
      <view class="mm-recorder">
        <view class="mm-rec-dot {{recording ? 'on' : ''}}"></view>
        <text class="mm-rec-time">{{timeText}}</text>
        <text class="mm-rec-status">{{recording ? '录音中' : (tempFilePath ? '已保存，待上传' : (hasRecording ? '已暂停' : '尚未开始'))}}</text>
      </view>
      <button class="mm-rec-btn" bindtap="toggleRecord" disabled="{{uploading}}">
        {{recording ? '暂停录音' : (recorderStarted ? '继续录音' : (tempFilePath ? '重新录音' : '开始录音'))}}
      </button>
      <button class="mm-rec-btn ghost" bindtap="finishRecord" disabled="{{uploading}}">
        结束录音并上传
      </button>
      <view class="mm-divider"><text class="mm-divider-text">或</text></view>
      <button class="mm-rec-btn ghost" bindtap="chooseAudioFile" disabled="{{uploading}}">
        选择已有文件上传
      </button>
      <text wx:if="{{uploading}}" class="mm-uploading">上传中…</text>
    </view>
    <view wx:else class="mm-tip-block">
      <text class="mm-tip">确认参加后即可录制备份录音</text>
    </view>
  </view>

  <!-- 已结束 -->
  <view wx:if="{{stage === 'ended'}}" class="mm-card">
    <view class="mm-result">
      <text class="mm-result-ico">📋</text>
      <text class="mm-result-text">{{resultText}}</text>
    </view>
    <view wx:if="{{topics.length}}" class="mm-topics">
      <view class="mm-topic" wx:for="{{topics}}" wx:key="title">
        <text class="mm-topic-title">{{item.title}}</text>
        <text class="mm-topic-result">{{item.resultText}}</text>
      </view>
    </view>
    <view class="mm-big-btn" bindtap="viewResult">
      <text class="mm-big-ico">📄</text>
      <text class="mm-big-text">查看会议记录</text>
    </view>
  </view>

  <!-- 已上传录音列表（进行中+已结束阶段显示） -->
  <view wx:if="{{recordings.length}}" class="mm-card">
    <text class="mm-section-title">已上传录音（{{recordings.length}}）</text>
    <view class="mm-rec-item" wx:for="{{recordings}}" wx:key="id">
      <view class="mm-rec-item-left">
        <text class="mm-rec-item-name">{{item.uploaderName || '未知'}} · <text class="mm-rec-item-time">{{item.createdAt || ''}}</text></text>
        <text class="mm-rec-item-status">{{item.asrStatus === 'done' ? '已转写' : item.asrStatus === 'processing' ? '转写中' : '已保存'}}</text>
      </view>
      <text class="mm-rec-item-play" bindtap="togglePlay" data-index="{{index}}">{{playingIdx === index ? '⏸' : '▶'}}</text>
    </view>
  </view>

  <!-- 会议材料（各阶段可看） -->
  <view wx:if="{{hasMaterials}}" class="mm-mat" bindtap="viewMaterials">
    <text class="mm-mat-ico">📎</text>
    <text class="mm-mat-text">查看会议材料（{{materials.length}}）</text>
    <text class="mm-mat-arrow">›</text>
  </view>
</view>
