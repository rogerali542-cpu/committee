.page { min-height: 100vh; background: #f4f5f7; padding: 24rpx 24rpx 100rpx; box-sizing: border-box; }
.doc { background: #fff; border-radius: 24rpx; padding: 36rpx 32rpx; box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.06); }

.access-card { background: #fff; border-radius: 24rpx; padding: 64rpx 36rpx; box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.06); text-align: center; }
.access-icon { width: 96rpx; height: 96rpx; border-radius: 50%; background: #FFF3E0; color: #E67E22; display: flex; align-items: center; justify-content: center; margin: 0 auto 24rpx; font-size: 52rpx; font-weight: 700; }
.access-title { display: block; font-size: 38rpx; color: #1f2329; font-weight: 700; margin-bottom: 14rpx; }
.access-text { display: block; font-size: 30rpx; color: #666; line-height: 1.7; }

.draft-banner, .info-banner, .ok-banner { font-size: 28rpx; font-weight: 600; text-align: center; padding: 18rpx 20rpx; border-radius: 14rpx; margin-bottom: 28rpx; }
.draft-banner { background: #FFF3E0; color: #E67E22; }
.info-banner { background: #EEF4FF; color: #2D6CDF; }
.ok-banner { background: #EAF7EF; color: #27AE60; }

.doc-title { font-size: 42rpx; font-weight: 700; text-align: center; display: block; margin-bottom: 16rpx; color: #1f2329; line-height: 1.4; }
.doc-meta { text-align: center; margin-bottom: 24rpx; }
.dm-line { display: block; font-size: 28rpx; color: #666; line-height: 1.7; }

.doc-body { display: block; font-size: 34rpx; color: #33373d; line-height: 1.9; white-space: pre-wrap; padding: 28rpx 0; border-top: 2rpx solid #f0f0f0; }

.minutes-actions { margin-top: 16rpx; }
.copy-btn { width: 100%; }
.btn-primary { background: #FFA800; color: #fff; border-radius: 18rpx; font-size: 34rpx; font-weight: 600; height: 96rpx; line-height: 96rpx; }
.btn-primary::after { border: none; }

.doc-foot { display: block; text-align: center; font-size: 26rpx; color: #999; margin-top: 24rpx; }

.empty-state { text-align: center; color: #666; font-size: 32rpx; padding: 80rpx 0; }
