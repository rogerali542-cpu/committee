<scroll-view scroll-y class="page">
  <view wx:if="{{loading}}" class="empty-state"><text>加载中...</text></view>

  <view wx:elif="{{!reportText}}" class="access-card">
    <view class="access-icon">!</view>
    <text class="access-title">暂无内部议题报告</text>
    <text class="access-text">{{emptyText}}</text>
  </view>

  <view wx:else class="doc">
    <view class="info-banner">内部资料 · 详细版议题报告，仅供业委会内部查看</view>
    <text class="doc-title">{{title}}</text>

    <view class="doc-sec">
      <text class="sec-title">AI 议题报告</text>
      <text class="doc-body">{{reportText}}</text>
    </view>

    <view class="doc-sec" wx:if="{{todoText}}">
      <text class="sec-title">待办事项</text>
      <text class="doc-body">{{todoText}}</text>
    </view>

    <view class="minutes-actions">
      <button class="btn-primary copy-btn" bindtap="copyReport">复制报告全文</button>
    </view>
  </view>
</scroll-view>
