<scroll-view scroll-y class="page">
  <view wx:if="{{accessDenied}}" class="access-card">
    <view class="access-icon">!</view>
    <text class="access-title">{{accessTitle}}</text>
    <text class="access-text">{{accessText}}</text>
  </view>

  <!-- 业主大会纪要（纯文本） -->
  <view wx:elif="{{isOwner && plainText}}" class="doc">
    <text class="doc-title">业主大会会议纪要</text>
    <text style="display:block;font-size:13px;color:#555;line-height:1.7;white-space:pre-wrap;padding:12px 0;">{{plainText}}</text>
    <view wx:if="{{editMode}}" class="edit-block">
      <textarea class="edit-textarea" value="{{editText}}" bindinput="onEditTextInput" placeholder="编辑纪要全文..." placeholder-class="input-placeholder" maxlength="-1" />
      <view class="edit-actions">
        <button class="btn btn-ghost" size="mini" bindtap="cancelEdit">取消</button>
        <button class="btn btn-primary" size="mini" bindtap="saveEdit">保存纪要</button>
      </view>
    </view>
    <view class="minutes-actions">
      <button class="btn-primary copy-btn" bindtap="copyText">复制纪要全文</button>
      <button wx:if="{{canEditMinutes}}" class="btn btn-outline edit-minutes-btn" bindtap="startEdit">编辑纪要</button>
    </view>
  </view>

  <!-- 业委会纪要：优先展示后端保存的大模型/人工编辑正文 -->
  <view wx:elif="{{!isOwner && hasServerMinutes && plainText}}" class="doc">
    <view wx:if="{{minutes && minutes.draft}}" class="draft-banner">草稿 · 会议进行中，结束后定稿</view>
    <text class="doc-title">业主委员会会议纪要</text>
    <text style="display:block;font-size:13px;color:#555;line-height:1.7;white-space:pre-wrap;padding:12px 0;">{{plainText}}</text>
    <view wx:if="{{editMode}}" class="edit-block">
      <text wx:if="{{reviseMode}}" class="revise-hint">修订模式：原归档版本将保留，本次修改作为新版本生效，提交时需填写修订原因。</text>
      <textarea class="edit-textarea" value="{{editText}}" bindinput="onEditTextInput" placeholder="编辑纪要全文..." placeholder-class="input-placeholder" maxlength="-1" />
      <view class="edit-actions">
        <button class="btn btn-ghost" size="mini" bindtap="cancelEdit">取消</button>
        <button class="btn btn-primary" size="mini" bindtap="saveEdit">{{reviseMode ? '提交修订' : '保存纪要'}}</button>
      </view>
    </view>
    <view class="minutes-actions">
      <button class="btn-primary copy-btn" bindtap="copyText">复制纪要全文</button>
      <button wx:if="{{canEditMinutes}}" class="btn btn-outline edit-minutes-btn" bindtap="startEdit">编辑纪要</button>
      <button wx:if="{{canReviseMinutes}}" class="btn btn-outline edit-minutes-btn" bindtap="startRevise">发起修订</button>
      <button wx:if="{{canReviseMinutes}}" class="btn btn-ghost edit-minutes-btn" bindtap="viewRevisions">修订历史</button>
    </view>
  </view>

  <!-- 委员会纪要（结构化） -->
  <view wx:elif="{{minutes && !isOwner}}" class="doc">
    <!-- 草稿标识 -->
    <view wx:if="{{minutes.draft}}" class="draft-banner">草稿 · 会议进行中，结束后定稿</view>

    <!-- 标题 -->
    <text class="doc-title">业主委员会会议纪要</text>

    <!-- 头部信息 -->
    <view class="doc-head">
      <view class="dh-row"><text class="dh-key">会议名称</text><text class="dh-val">{{minutes.meetingTitle}}</text></view>
      <view class="dh-row"><text class="dh-key">会议时间</text><text class="dh-val">{{minutes.meetingDate}} {{minutes.meetingTime}}</text></view>
      <view class="dh-row"><text class="dh-key">会议地点</text><text class="dh-val">{{minutes.location}}</text></view>
      <view class="dh-row"><text class="dh-key">主持人</text><text class="dh-val">{{minutes.host}}</text></view>
      <view class="dh-row"><text class="dh-key">记录人</text><text class="dh-val">秘书小李</text></view>
    </view>

    <!-- 一、参会情况 -->
    <view class="doc-sec">
      <text class="sec-title">一、参会情况</text>
      <text class="sec-text">应到委员 <text class="b">{{minutes.totalMembers}}</text> 人，实到 <text class="b">{{minutes.presentCount}}</text> 人，<text class="{{minutes.quorumMet ? 'tag-ok' : 'tag-no'}}">{{minutes.quorumMet ? '已过半，达到法定人数' : '未过半，未达法定人数'}}</text>。</text>
      <text class="sec-text"><text class="sec-k">出席：</text>{{minutes.presentNames}}</text>
      <text class="sec-text" wx:if="{{minutes.absentNames}}"><text class="sec-k">缺席：</text>{{minutes.absentNames}}</text>
      <text class="sec-text" wx:if="{{minutes.juweiName}}"><text class="sec-k">列席：</text>{{minutes.juweiName}}（居委会委员）</text>
    </view>

    <!-- 二、会议议题 -->
    <view class="doc-sec">
      <text class="sec-title">二、会议议题</text>
      <text class="sec-text">{{minutes.description || '（无）'}}</text>
    </view>

    <!-- 三、表决情况 -->
    <view class="doc-sec" wx:if="{{minutes.topics && minutes.topics.length}}">
      <text class="sec-title">三、表决情况</text>
      <view class="topic-item" wx:for="{{minutes.topics}}" wx:key="id">
        <text class="ti-title">{{index+1}}. <text class="ti-tag {{item.type === 'major' ? 'major' : ''}}">{{item.type === 'major' ? '重大事项' : '决定事项'}}</text> {{item.title}}</text>
        <text class="ti-result">赞成 <text class="b">{{item.forVotes}}</text> · 反对 <text class="b">{{item.agVotes}}</text> · 弃权 <text class="b">{{item.abVotes}}</text>（赞成需≥{{item.need}}）</text>
        <text class="ti-conclusion {{item.passed ? 'pass' : 'fail'}}">表决结果：{{item.text}}</text>
      </view>
    </view>

    <!-- 四、参会确认 -->
    <view class="doc-sec">
      <text class="sec-title">{{minutes.topics.length ? '四' : '三'}}、参会确认</text>
      <text class="sec-text">本次会议经 <text class="b">{{minutes.presentCount}}/{{minutes.totalMembers}}</text> 名委员确认参会。</text>
      <text class="sec-text" wx:if="{{minutes.juweiName}}">重大事项 <text class="{{minutes.juweiSigned ? 'tag-ok' : 'tag-no'}}">{{minutes.juweiSigned ? '已' : '尚未'}}</text> 由居委会委员（{{minutes.juweiName}}）签字。</text>
    </view>

    <!-- 五、会议结论 -->
    <view class="doc-sec">
      <text class="sec-title">{{minutes.topics.length ? '五' : '四'}}、会议结论</text>
      <view class="conclusion-box {{minutes.conclusionLevel}}">
        <text class="cb-text">{{minutes.conclusionText}}</text>
      </view>
      <view class="check-grid">
        <view class="cg-row"><text class="cg-label">会议有效性</text><text class="cg-value {{minutes.meetingValid ? 'ok' : 'bad'}}">{{minutes.meetingValid ? '会议有效' : '会议无效'}}</text></view>
        <view class="cg-row"><text class="cg-label">记录完整性</text><text class="cg-value {{minutes.recordLevel === 'complete' ? 'ok' : minutes.recordLevel === 'minor' ? 'warn' : 'bad'}}">{{minutes.recordText}}</text></view>
        <view class="cg-row"><text class="cg-label">决议有效性</text><text class="cg-value {{minutes.resolutionLevel === 'passed' || minutes.resolutionLevel === 'none' ? 'ok' : minutes.resolutionLevel === 'invalid' ? 'bad' : 'warn'}}">{{minutes.resolutionText}}</text></view>
      </view>
      <view wx:if="{{minutes.notes && minutes.notes.length}}" class="notes-list">
        <text wx:for="{{minutes.notes}}" wx:key="*this" class="note-item">· {{item}}</text>
      </view>
    </view>

    <!-- 附：线下佐证 -->
    <view class="doc-sec" wx:if="{{minutes.evidences && minutes.evidences.length}}">
      <text class="sec-title">附：线下佐证</text>
      <text class="sec-text" wx:for="{{minutes.evidences}}" wx:key="id">{{index+1}}. {{item.fileName}}</text>
    </view>

    <!-- 底部 -->
    <text class="doc-foot">本纪要由系统根据会议记录自动生成 · {{minutes.draft ? '草稿' : '已定稿'}}</text>

    <!-- 编辑模式 -->
    <view wx:if="{{editMode}}" class="edit-block">
      <text wx:if="{{reviseMode}}" class="revise-hint">修订模式：原归档版本将保留，本次修改作为新版本生效，提交时需填写修订原因。</text>
      <textarea class="edit-textarea" value="{{editText}}" bindinput="onEditTextInput" placeholder="编辑纪要全文..." placeholder-class="input-placeholder" maxlength="-1" />
      <view class="edit-actions">
        <button class="btn btn-ghost" size="mini" bindtap="cancelEdit">取消</button>
        <button class="btn btn-primary" size="mini" bindtap="saveEdit">{{reviseMode ? '提交修订' : '保存纪要'}}</button>
      </view>
    </view>

    <view class="minutes-actions">
      <button class="btn-primary copy-btn" bindtap="copyText">复制纪要全文</button>
      <button wx:if="{{canEditMinutes}}" class="btn btn-outline edit-minutes-btn" bindtap="startEdit">编辑纪要</button>
      <button wx:if="{{canReviseMinutes}}" class="btn btn-outline edit-minutes-btn" bindtap="startRevise">发起修订</button>
      <button wx:if="{{canReviseMinutes}}" class="btn btn-ghost edit-minutes-btn" bindtap="viewRevisions">修订历史</button>
    </view>
  </view>

  <view wx:else class="empty-state"><text>加载中...</text></view>
</scroll-view>
