<scroll-view scroll-y class="page">
  <view wx:if="{{loading}}" class="empty-state"><text>加载中...</text></view>

  <view wx:elif="{{emptyText}}" class="access-card">
    <view class="access-icon">✓</view>
    <text class="access-title">暂无待办</text>
    <text class="access-text">{{emptyText}}</text>
  </view>

  <block wx:else>
    <view class="info-banner">内部资料 · 会议待办事项，仅供业委会内部跟踪</view>

    <view class="todo-card" wx:for="{{cards}}" wx:key="index">
      <view class="todo-top">
        <text class="todo-idx">{{index + 1}}</text>
        <text class="todo-title">{{item.title}}</text>
      </view>
      <view class="todo-meta" wx:if="{{item.owner || item.due}}">
        <view class="meta-item" wx:if="{{item.owner}}"><text class="meta-label">负责人</text><text class="meta-val">{{item.owner}}</text></view>
        <view class="meta-item" wx:if="{{item.due}}"><text class="meta-label">截止</text><text class="meta-val">{{item.due}}</text></view>
      </view>
      <text class="todo-source" wx:if="{{item.source}}">来源 · {{item.source}}</text>
      <text class="todo-status status-{{item.statusType}}" wx:if="{{item.status}}">{{item.status}}</text>
    </view>

    <!-- 解析失败兜底：整段原文 -->
    <view class="doc" wx:if="{{rawText}}">
      <text class="doc-body">{{rawText}}</text>
    </view>

    <view class="actions">
      <button class="btn-primary copy-btn" bindtap="copyTodos">复制待办全文</button>
    </view>
  </block>
</scroll-view>
