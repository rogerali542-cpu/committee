# ============================================================
# 业委会 demo 部署环境变量（示例）。复制成同目录 .env 填真实值。
# ⚠️ .env 含密钥，切勿提交到仓库（已在 .gitignore）。平台部署时把这些填到「环境变量」。
# 真实密钥从哪拷：
#   - 豆包 ASR / LLM：backend/src/main/resources/application.yml（本地 gitignore 版）
#   - ARK / VOLC 实时语音：ocr-asr-service/.env（本地 gitignore 版）
#   - OCR_SERVICE_TOKEN：三方共享的内网令牌，自定义一串即可（后端、语音服务、入口 nginx 用同一个）
# ============================================================

# ── 数据库（外部云 MySQL，不再打包 DB 镜像）──
DB_HOST=你的云数据库地址
DB_PORT=3306
DB_NAME=ywh_db
DB_USER=数据库用户名
DB_PASSWORD=数据库密码
# 云库若强制 SSL，把 docker-compose.yml 里 backend 的 DB_URL 末尾 useSSL=false 改成 useSSL=true

# ── JWT（后端签发登录 token；随便一串 ≥32 字符）──
JWT_SECRET=请改成至少32位的随机字符串

# ── 内网令牌（后端 ↔ 语音服务 ↔ 入口 nginx 三方共享，自定义）──
OCR_SERVICE_TOKEN=请自定义一串内网令牌

# ── 豆包·录音识别 ASR（火山 openspeech，长录音转写用）──
DOUBAO_ASR_ENABLED=true
DOUBAO_ASR_APP_KEY=
DOUBAO_ASR_ACCESS_TOKEN=
DOUBAO_ASR_SECRET_KEY=

# ── 豆包·大模型 LLM（方舟 Ark，纪要/润色/新闻）──
DOUBAO_LLM_ENABLED=true
DOUBAO_LLM_API_KEY=
DOUBAO_LLM_MODEL=doubao-seed-2-0-pro-260215

# ── OCR/纪要服务内部用的方舟 Ark（ocr-asr-service）──
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_ID=
OCR_VISION_MODEL_ID=doubao-1-5-vision-pro-32k-250115

# ── 实时流式语音 ASR（火山 sauc WebSocket，议题意见"边说边出字"）──
VOLC_ASR_ENABLED=true
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_TOKEN=
VOLC_ASR_SECRET_KEY=
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# ── 音频存储：local=容器内磁盘（短录音够用）；tos=火山对象存储（长录音必用，方案C）──
STORAGE_AUDIO_TYPE=tos
DOUBAO_OCR_ENABLED=true
# TOS（type=tos 时必填）：⚠ 用 S3 兼容域名 tos-s3-<region> + signing-service=s3；对象上传自动打 public-read
STORAGE_TOS_ENDPOINT=https://tos-s3-cn-shanghai.volces.com
STORAGE_TOS_REGION=cn-shanghai
STORAGE_TOS_BUCKET=committee
STORAGE_TOS_ACCESS_KEY=
STORAGE_TOS_SECRET_KEY=
STORAGE_TOS_SIGNING_SERVICE=s3

# 演示假识别开关：true=固定素材走查(不依赖容器连豆包OCR)；false=真实OCR
DEMO_PREFILL_ENABLED=true
