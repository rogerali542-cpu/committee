<scroll-view scroll-y class="page">
  <view class="page-head">
    <view>
      <text class="page-title">接待记录</text>
      <text class="page-sub">登记诉求、处理结果和反馈闭环</text>
    </view>
    <button wx:if="{{canManage}}" class="head-btn" size="mini" bindtap="openCreate">登记</button>
  </view>

  <!-- 接待制度公示 -->
  <view class="recep-system {{sys.published ? '' : 'unpub'}}">
    <view class="rs-head">
      <text class="rs-title">📍 接待制度公示</text>
      <text wx:if="{{canManage}}" class="rs-edit" bindtap="openSysEditor">编辑</text>
    </view>
    <view class="rs-rows">
      <view class="rs-row"><text class="rs-key">定时</text><text class="rs-val">{{sys.timeDesc}}</text></view>
      <view class="rs-row"><text class="rs-key">定点</text><text class="rs-val">{{sys.place}}</text></view>
      <view class="rs-row"><text class="rs-key">定人</text><text class="rs-val">{{sys.person}}</text></view>
    </view>
    <view class="rs-pub-row">
      <text class="rs-pub-label">向全体业主公开接待信息</text>
      <block wx:if="{{sys.published}}">
        <text class="rs-pub-ok">✓ 已公示</text>
        <text wx:if="{{canManage}}" class="rs-edit unpub" bindtap="togglePublish" style="color:#bbb;">取消公示</text>
      </block>
      <text wx:if="{{!sys.published && canManage}}" class="rs-publish-btn" bindtap="togglePublish">◯ 标记已公示</text>
      <text wx:if="{{!sys.published && !canManage}}" class="rs-pub-ok" style="color:#E67E22;">未公示</text>
    </view>
  </view>

  <!-- 月度统计 -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-num">{{stats.monthCount}}<text class="stat-unit"> 次</text></text>
      <text class="stat-label">{{stats.monthLabel}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.pending}}<text class="stat-unit"> 件</text></text>
      <text class="stat-label">待办</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.yearCount}}<text class="stat-unit"> 次</text></text>
      <text class="stat-label">年度已接待</text>
    </view>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-tabs">
    <view class="f-tab {{filter==='all'?'active':''}}" bindtap="switchFilter" data-filter="all">全部 <text class="f-count">{{stats.total}}</text></view>
    <view class="f-tab {{filter==='pending'?'active':''}}" bindtap="switchFilter" data-filter="pending">待跟进 <text class="f-count">{{stats.pending}}</text></view>
    <view class="f-tab {{filter==='done'?'active':''}}" bindtap="switchFilter" data-filter="done">已办结 <text class="f-count">{{stats.done}}</text></view>
  </view>

  <!-- 接待记录列表 -->
  <view class="record-list">
    <block wx:if="{{records.length}}">
      <view class="recep-card" wx:for="{{records}}" wx:key="id">
        <view class="rc-header">
          <text class="rc-visitor">{{item.visitorName}}{{item.room ? ' · '+item.room : ''}}</text>
          <text class="stage-pill {{item.done ? 'ended' : 'preparing'}}">{{item.done ? '已办结' : '待跟进'}}</text>
        </view>
        <!-- 下一步指引：补齐闭环断点 -->
        <view wx:if="{{item.nextAction}}" class="rc-next {{item.nextAction.action ? '' : 'info'}}">
          <text class="rc-next-text">👉 {{item.nextAction.text}}</text>
          <text wx:if="{{item.nextAction.action}}" class="rc-next-btn" bindtap="doNextAction" data-action="{{item.nextAction.action}}" data-id="{{item.id}}">{{item.nextAction.cta}}</text>
        </view>
        <view class="rc-meta">
          <text>📅 {{item.date}} {{item.time}}</text>
          <text wx:if="{{item.receiver}}" class="rc-receiver">🧑 接待人：{{item.receiver}}</text>
          <text class="rc-cat {{item.category}}">{{item.categoryLabel}}</text>
        </view>
        <view class="rc-content">{{item.content}}</view>
        <view class="rc-resolution" wx:if="{{item.resolution}}">
          <text class="rc-res-label">处理/解决：</text>
          <text>{{item.resolution}}</text>
        </view>
        <view class="rc-prop-reply" wx:if="{{item.propertyReply}}">
          <text class="rc-res-label">物业反馈：</text>
          <text>{{item.propertyReply}}</text>
          <text wx:if="{{item.propertyRepliedBy}}" class="rc-prop-by">— {{item.propertyRepliedBy}} {{item.propertyRepliedAt}}</text>
        </view>
        <view class="rc-followup">
          <text class="rc-fu-title">后续工作</text>
          <view class="rc-fu-item">
            <text class="rc-fu-label">物业处理</text>
            <block wx:if="{{!item.needsPropertyFeedback}}">
              <text class="rc-fu-na">非物业类·不适用</text>
            </block>
            <block wx:elif="{{item.propertyStatus === 'pending_dispatch'}}">
              <text wx:if="{{canManage}}" class="fu-chip" bindtap="dispatchProperty" data-id="{{item.id}}">转物业处理</text>
              <text wx:else class="rc-fu-na">待派单</text>
            </block>
            <block wx:else>
              <text class="rc-fu-na {{item.propertyStatus==='replied'?'ok':''}}">{{item.propertyStatusLabel}}</text>
            </block>
          </view>
          <view class="rc-fu-item">
            <text class="rc-fu-label">向业主反馈诉求解决情况</text>
            <block wx:if="{{canManage}}">
              <text class="fu-chip {{item.fedOwner?'on':''}}" bindtap="toggleFollow" data-id="{{item.id}}" data-field="fedOwner">{{item.fedOwner ? '已反馈' : '反馈'}}</text>
            </block>
            <block wx:else>
              <text class="rc-fu-na">{{item.fedOwner ? '已反馈' : '待反馈'}}</text>
            </block>
          </view>
        </view>
        <!-- 佐证材料 -->
        <view class="rc-evidence">
          <view class="rc-ev-head">
            <text class="rc-ev-title">📎 佐证材料（{{item.evidences ? item.evidences.length : 0}}）</text>
            <text wx:if="{{canManage}}" class="add-link" bindtap="addEvidence" data-id="{{item.id}}">+ 上传</text>
          </view>
          <view wx:if="{{item.evidences && item.evidences.length}}" class="rc-ev-list">
            <view wx:for="{{item.evidences}}" wx:for-item="ev" wx:key="id" class="rc-ev-item">
              <text class="rc-ev-name">{{ev.fileName}}</text>
              <text wx:if="{{canManage}}" class="tp-del" bindtap="removeEvidence" data-rid="{{item.id}}" data-ev-id="{{ev.id}}">×</text>
            </view>
          </view>
          <text wx:else class="rc-ev-empty">可上传现场照片、处理凭证、反馈截图等</text>
        </view>

        <view wx:if="{{canManage}}" class="rc-actions">
          <button class="btn btn-outline" size="mini" bindtap="openResolutionEditor" data-id="{{item.id}}">{{item.resolution ? '修改处理结果' : '填写处理结果'}}</button>
          <button class="btn btn-ghost" size="mini" bindtap="removeRecord" data-id="{{item.id}}">删除</button>
        </view>
      </view>
    </block>
    <view wx:else class="empty-state"><text>暂无接待记录</text></view>
  </view>

  <view wx:if="{{createVisible}}" class="modal-mask" bindtap="closeCreate">
    <view class="form-sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">新增接待记录</text>
        <text class="sheet-close" bindtap="closeCreate">×</text>
      </view>

      <!-- 分类 -->
      <text class="form-label">诉求分类</text>
      <view class="type-row">
        <text class="type-chip {{createForm.category === 'property' ? 'on' : ''}}" bindtap="pickCategory" data-category="property">物业类</text>
        <text class="type-chip {{createForm.category === 'public_affairs' ? 'on' : ''}}" bindtap="pickCategory" data-category="public_affairs">公共事务</text>
        <text class="type-chip {{createForm.category === 'neighbor' ? 'on' : ''}}" bindtap="pickCategory" data-category="neighbor">邻里纠纷</text>
      </view>

      <!-- 日期时间 -->
      <view class="form-row">
        <view class="form-group half">
          <text class="form-label">接待日期 *</text>
          <picker mode="date" value="{{createForm.date}}" bindchange="onDateChange">
            <view class="picker-field">{{createForm.date || '选择日期'}}</view>
          </picker>
        </view>
        <view class="form-group half">
          <text class="form-label">时间</text>
          <picker mode="time" value="{{createForm.time}}" bindchange="onTimeChange">
            <view class="picker-field">{{createForm.time || '选择时间'}}</view>
          </picker>
        </view>
      </view>

      <!-- 来访业主 + 房号 -->
      <view class="form-row">
        <view class="form-group half">
          <text class="form-label">来访业主 *</text>
          <input class="form-input" value="{{createForm.visitorName}}" data-field="visitorName" bindinput="onCreateInput" placeholder="姓名" placeholder-class="input-placeholder" />
        </view>
        <view class="form-group half">
          <text class="form-label">房号</text>
          <input class="form-input" value="{{createForm.room}}" data-field="room" bindinput="onCreateInput" placeholder="如 5号楼302" placeholder-class="input-placeholder" />
        </view>
      </view>

      <!-- 接待人 -->
      <view class="form-group">
        <text class="form-label">接待人</text>
        <input class="form-input" value="{{createForm.receiver}}" data-field="receiver" bindinput="onCreateInput" placeholder="如 张建国（主任）" placeholder-class="input-placeholder" />
      </view>

      <!-- 诉求内容 -->
      <view class="form-group">
        <text class="form-label">诉求内容 *</text>
        <textarea class="form-textarea" value="{{createForm.content}}" data-field="content" bindinput="onCreateInput" placeholder="简述业主反映的问题或建议" placeholder-class="input-placeholder" />
      </view>

      <view class="sheet-actions">
        <button class="btn btn-ghost" bindtap="closeCreate">取消</button>
        <button class="btn btn-primary" bindtap="submitCreate">确认登记</button>
      </view>
    </view>
  </view>

  <!-- 填写处理结果面板 -->
  <view wx:if="{{resolutionVisible}}" class="modal-mask" bindtap="closeResolutionEditor">
    <view class="form-sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">处理结果</text>
        <text class="sheet-close" bindtap="closeResolutionEditor">×</text>
      </view>
      <view class="form-group">
        <text class="form-label">记录处理/解决情况</text>
        <textarea class="form-textarea" style="min-height:140px;height:140px;" value="{{editingResolution}}" bindinput="onResolutionInput" placeholder="例如：&#10;1. 已联系物业公司，约定7月20日前完成清理&#10;2. 物业已出具整改通知书&#10;3. 业主表示满意处理结果" placeholder-class="input-placeholder" />
      </view>
      <view class="sheet-actions">
        <button class="btn btn-ghost" bindtap="closeResolutionEditor">取消</button>
        <button class="btn btn-primary" bindtap="submitResolution">保存结果</button>
      </view>
    </view>
  </view>
</scroll-view>
