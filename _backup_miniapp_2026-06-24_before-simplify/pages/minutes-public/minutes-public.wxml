<scroll-view scroll-y class="page">
  <view wx:if="{{loading}}" class="empty-state"><text>加载中...</text></view>

  <view wx:elif="{{!plainText}}" class="access-card">
    <view class="access-icon">!</view>
    <text class="access-title">暂无公开纪要</text>
    <text class="access-text">{{emptyText}}</text>
  </view>

  <view wx:else class="doc">
    <view wx:if="{{isDraft}}" class="draft-banner">草稿 · 会议尚未结束，内容可能调整</view>
    <view wx:elif="{{!isPublished}}" class="info-banner">正式纪要 · 尚未公示</view>
    <view wx:else class="ok-banner">已公示 · 正式公开文件</view>

    <text class="doc-title">{{title}}</text>
    <view class="doc-meta" wx:if="{{meetingDate || location}}">
      <text class="dm-line" wx:if="{{meetingDate}}">{{meetingDate}} {{meetingTime}}</text>
      <text class="dm-line" wx:if="{{location}}">{{location}}</text>
    </view>

    <text class="doc-body">{{plainText}}</text>

    <view class="minutes-actions">
      <button class="btn-primary copy-btn" bindtap="copyText">复制纪要全文</button>
    </view>
    <text class="doc-foot">本页为面向公众的公开纪要展示版</text>
  </view>
</scroll-view>
