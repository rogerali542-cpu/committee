.page { min-height:100vh; background:#f5f5f5; padding:12px; padding-bottom:60px; }
.doc { background:#fff; border-radius:14px; padding:20px 16px; box-shadow:0 2px 8px rgba(0,0,0,0.05); }

.access-card { background:#fff; border-radius:14px; padding:28px 18px; box-shadow:0 2px 8px rgba(0,0,0,0.05); text-align:center; }
.access-icon { width:38px; height:38px; border-radius:50%; background:#FFF3E0; color:#E67E22; display:flex; align-items:center; justify-content:center; margin:0 auto 12px; font-size:20px; font-weight:700; }
.access-title { display:block; font-size:16px; color:#333; font-weight:700; margin-bottom:8px; }
.access-text { display:block; font-size:13px; color:#888; line-height:1.7; }

.info-banner { background:#F1EEFB; color:#6B4FBB; font-size:12px; font-weight:600; text-align:center; padding:8px 12px; border-radius:8px; margin-bottom:16px; }

.doc-title { font-size:18px; font-weight:700; text-align:center; display:block; margin-bottom:14px; color:#333; }
.doc-sec { margin-bottom:16px; padding-top:12px; border-top:1px solid #f0f0f0; }
.sec-title { font-size:14px; font-weight:700; color:#333; display:block; margin-bottom:10px; }
.doc-body { display:block; font-size:13px; color:#555; line-height:1.8; white-space:pre-wrap; word-break:break-word; }

.minutes-actions { margin-top:8px; }
.copy-btn { width:100%; }
.btn-primary { background:#6B4FBB; color:#fff; border-radius:10px; font-size:14px; }

.empty-state { text-align:center; color:#999; font-size:13px; padding:40px 0; }
