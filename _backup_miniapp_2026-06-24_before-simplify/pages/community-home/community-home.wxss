.page { min-height:100vh; background:#f5f5f5; }
.header { background:linear-gradient(160deg,#4A90D9,#2980B9); padding:30px 20px 24px; }
.header-title { font-size:22px; font-weight:700; color:#fff; display:block; }
.header-sub { font-size:13px; color:rgba(255,255,255,0.7); margin-top:4px; display:block; }

.notice-card { margin:12px; background:#fff; border-radius:14px; padding:14px; }
.notice-title { font-size:15px; font-weight:600; display:block; margin-bottom:8px; }
.notice-item { font-size:13px; color:#666; display:block; padding:4px 0; }

.menu-grid { display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:16px 0; margin:0 12px; padding:16px 12px; background:#fff; border-radius:14px; }
.m-item { display:flex; flex-direction:column; align-items:center; gap:6px; font-size:12px; color:#555; }
.m-icon { font-size:28px; }
