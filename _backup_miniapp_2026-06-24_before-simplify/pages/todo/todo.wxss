.page { min-height: 100vh; background: #f5f5f5; padding: 12px; }
.intro { font-size: 12px; color: #aaa; display: block; margin-bottom: 12px; text-align: center; }

.todo-section { margin-bottom: 18px; }
.section-head { display: flex; align-items: center; gap: 8px; margin: 0 2px 8px; }
.section-title { font-size: 14px; font-weight: 700; color: #333; }
.section-count {
  font-size: 11px; color: #B8860B; background: #FFF3DC;
  border-radius: 9px; padding: 1px 8px;
}

.todo-card {
  background: #fff; border-radius: 14px; padding: 14px;
  margin-bottom: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.tc-head { display: flex; justify-content: space-between; align-items: center; }
.tc-tag { font-size: 10px; background: #FFF3DC; color: #B8860B; padding: 2px 8px; border-radius: 8px; }
.tc-status { font-size: 12px; color: #FF8C00; font-weight: 600; }
.tc-status.active { color: #2E86DE; }
.tc-title { font-size: 15px; font-weight: 600; display: block; margin: 8px 0; color: #333; }
.tc-meta { font-size: 12px; color: #888; display: flex; flex-direction: column; gap: 2px; }
.tc-sub { color: #aaa; }

.empty-state {
  display: flex; flex-direction: column; align-items: center;
  color: #bbb; font-size: 14px; padding-top: 80px;
}
.empty-emoji { font-size: 40px; margin-bottom: 12px; }
