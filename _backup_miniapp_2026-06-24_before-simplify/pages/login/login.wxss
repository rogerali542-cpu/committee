.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFCC44 0%, #FFA800 40%, #f5f5f5 40%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80px;
}
.login-logo {
  width: 80px; height: 80px;
  background: rgba(255,255,255,0.4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-icon { font-size: 40px; }
.login-title { font-size: 24px; font-weight: 700; color: #5C3D00; margin-top: 12px; }
.login-sub { font-size: 14px; color: #8B6914; margin-top: 4px; margin-bottom: 30px; }

.login-card {
  width: 85%;
  background: #fff;
  border-radius: 18px;
  padding: 20px 16px;
  box-shadow: 0 8px 30px rgba(0,0,0,0.1);
}
.login-opt {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 8px;
  border-bottom: 1px solid #f5f5f5;
}
.login-opt:last-child { border-bottom: none; }
.login-avatar {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: #FFF3DC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 600;
  color: #FFA800;
}
.login-avatar.rec { background: #F5EEF8; color: #9B59B6; }

.login-info { flex: 1; }
.login-name { font-size: 15px; font-weight: 600; color: #333; }
.login-role-tag {
  font-size: 10px;
  background: #f0f0f0;
  padding: 1px 6px;
  border-radius: 6px;
  margin-left: 8px;
  color: #888;
}
.login-desc { font-size: 12px; color: #bbb; margin-top: 2px; }
.login-arrow { font-size: 22px; color: #ccc; }
