.page { min-height: 100vh; background: #f5f5f5; padding: 12px; }
.intro { font-size: 12px; color: #aaa; display: block; margin-bottom: 12px; text-align: center; }

.filter-tabs { display: flex; gap: 8px; margin-bottom: 12px; }
.f-tab {
  flex: 1; text-align: center; font-size: 13px; color: #666;
  background: #fff; border-radius: 10px; padding: 8px 0; border: 1px solid #eee;
}
.f-tab.active { background: #FFF3DC; color: #B8860B; border-color: #FFCC44; font-weight: 600; }
.f-count { font-size: 11px; color: #bbb; }
.f-tab.active .f-count { color: #B8860B; }

.task-card {
  background: #fff; border-radius: 14px; padding: 14px;
  margin-bottom: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.tc-header { display: flex; justify-content: space-between; align-items: center; }
.tc-visitor { font-size: 15px; font-weight: 600; color: #333; }
.status-pill { font-size: 11px; padding: 2px 9px; border-radius: 10px; }
.status-pill.dispatched { background: #FDECEA; color: #E74C3C; }
.status-pill.processing { background: #FFF3DC; color: #E67E22; }
.status-pill.replied { background: #E8F7EE; color: #27AE60; }
.tc-meta { font-size: 12px; color: #888; margin: 6px 0; }
.tc-content { font-size: 14px; color: #444; line-height: 1.6; }

.tc-ev { margin-top: 10px; background: #fafafa; border: 1px solid #f0f0f0; border-radius: 10px; padding: 8px 10px; }
.tc-ev-title { font-size: 12px; color: #888; }
.tc-ev-list { display: flex; flex-direction: column; gap: 2px; margin-top: 4px; }
.tc-ev-name { font-size: 12px; color: #555; }

.ev-edit-list { margin-bottom: 8px; }
.ev-edit-item { display: flex; justify-content: space-between; align-items: center; padding: 4px 0; }
.ev-edit-name { font-size: 13px; color: #555; }
.ev-del { font-size: 18px; color: #ccc; padding: 0 6px; }
.ev-empty { font-size: 12px; color: #bbb; }
.btn-outline { background: #fff; color: #B8860B; border: 1px solid #FFCC44; }

.tc-reply {
  font-size: 13px; color: #444; line-height: 1.6;
  background: #E8F7EE; border-radius: 8px; padding: 9px 11px; margin-top: 10px;
  border-left: 3px solid #2ECC71;
}
.tc-reply-label { font-weight: 600; color: #27AE60; }
.tc-reply-time { display: block; font-size: 11px; color: #aaa; margin-top: 4px; }

.tc-actions { margin-top: 12px; display: flex; justify-content: flex-end; }
.tc-next { margin-top: 12px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.tc-hint { font-size: 12px; color: #B8500B; }
.btn { font-size: 13px; border-radius: 18px; }
.btn-primary { background: #FFA800; color: #fff; }
.btn-ghost { background: #f2f2f2; color: #666; }

.empty-state {
  display: flex; flex-direction: column; align-items: center;
  color: #bbb; font-size: 14px; padding-top: 80px;
}
.empty-emoji { font-size: 40px; margin-bottom: 12px; }

/* 回填面板 */
.modal-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.45);
  display: flex; align-items: flex-end; z-index: 100;
}
.form-sheet {
  width: 100%; background: #fff; border-radius: 18px 18px 0 0; padding: 18px 16px 24px;
}
.sheet-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
.sheet-title { font-size: 16px; font-weight: 700; }
.sheet-close { font-size: 22px; color: #bbb; }
.form-group { margin-bottom: 14px; }
.form-label { font-size: 13px; color: #666; display: block; margin-bottom: 6px; }
.form-textarea {
  width: 100%; box-sizing: border-box; min-height: 120px;
  background: #f7f7f7; border-radius: 10px; padding: 10px; font-size: 14px;
}
.input-placeholder { color: #bbb; }
.sheet-actions { display: flex; gap: 10px; }
.sheet-actions .btn { flex: 1; }
