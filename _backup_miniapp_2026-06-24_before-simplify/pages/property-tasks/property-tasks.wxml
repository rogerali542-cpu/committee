<view class="page">
  <text class="intro">业委会转来的物业类诉求，请处理后上传佐证并回填结果。</text>

  <!-- 筛选 -->
  <view class="filter-tabs">
    <view class="f-tab {{filter==='pending'?'active':''}}" bindtap="switchFilter" data-filter="pending">待处理 <text class="f-count">{{counts.pending}}</text></view>
    <view class="f-tab {{filter==='replied'?'active':''}}" bindtap="switchFilter" data-filter="replied">已完成 <text class="f-count">{{counts.replied}}</text></view>
    <view class="f-tab {{filter==='all'?'active':''}}" bindtap="switchFilter" data-filter="all">全部 <text class="f-count">{{counts.all}}</text></view>
  </view>

  <view class="task-list">
    <block wx:if="{{items.length}}">
      <view class="task-card" wx:for="{{items}}" wx:key="id">
        <view class="tc-header">
          <text class="tc-visitor">{{item.visitorName}}{{item.room ? ' · '+item.room : ''}}</text>
          <text class="status-pill {{item.propertyStatus}}">{{item.propertyStatusLabel}}</text>
        </view>
        <view class="tc-meta"><text>📅 {{item.date}} {{item.time}}</text></view>
        <view class="tc-content">{{item.content}}</view>

        <!-- 佐证（处理中/已完成可见） -->
        <view class="tc-ev" wx:if="{{item.evidences.length}}">
          <text class="tc-ev-title">📎 处理佐证（{{item.evidences.length}}）</text>
          <view class="tc-ev-list">
            <text wx:for="{{item.evidences}}" wx:for-item="ev" wx:key="id" class="tc-ev-name">{{ev.fileName}}</text>
          </view>
        </view>

        <view class="tc-reply" wx:if="{{item.propertyReply}}">
          <text class="tc-reply-label">处理结果：</text>
          <text>{{item.propertyReply}}</text>
          <text wx:if="{{item.propertyRepliedAt}}" class="tc-reply-time">{{item.propertyRepliedBy}} · {{item.propertyRepliedAt}}</text>
        </view>

        <!-- 操作 -->
        <view class="tc-next" wx:if="{{item.propertyStatus === 'dispatched'}}">
          <text class="tc-hint">👉 待你受理</text>
          <button class="btn btn-primary" size="mini" bindtap="startTask" data-id="{{item.id}}">开始处理</button>
        </view>
        <view class="tc-next" wx:elif="{{item.propertyStatus === 'processing'}}">
          <text class="tc-hint">👉 待你回填：上传佐证后提交</text>
          <button class="btn btn-primary" size="mini" bindtap="openReply" data-id="{{item.id}}">填写结果并完成</button>
        </view>
      </view>
    </block>
    <view wx:elif="{{!loading}}" class="empty-state">
      <text class="empty-emoji">🛠️</text>
      <text>{{filter === 'pending' ? '暂无待处理工单' : '暂无工单'}}</text>
    </view>
  </view>

  <!-- 完成面板：上传佐证 + 填写结果 -->
  <view wx:if="{{replyVisible}}" class="modal-mask" bindtap="closeReply">
    <view class="form-sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">完成处理</text>
        <text class="sheet-close" bindtap="closeReply">×</text>
      </view>

      <view class="form-group">
        <text class="form-label">处理佐证（必传）</text>
        <view class="ev-edit-list">
          <view wx:for="{{replyEvidences}}" wx:for-item="ev" wx:key="id" class="ev-edit-item">
            <text class="ev-edit-name">{{ev.fileName}}</text>
            <text class="ev-del" bindtap="removeEvidence" data-rid="{{replyId}}" data-ev-id="{{ev.id}}">×</text>
          </view>
          <text class="ev-empty" wx:if="{{!replyEvidences.length}}">尚未上传，请上传现场照片/处理凭证</text>
        </view>
        <button class="btn btn-outline" size="mini" bindtap="addEvidence" data-id="{{replyId}}">+ 上传佐证</button>
      </view>

      <view class="form-group">
        <text class="form-label">处理/解决情况</text>
        <textarea class="form-textarea" value="{{replyText}}" bindinput="onReplyInput" placeholder="例如：已安排维修人员于X月X日完成处理，并恢复正常。" placeholder-class="input-placeholder" />
      </view>

      <view class="sheet-actions">
        <button class="btn btn-ghost" bindtap="closeReply">取消</button>
        <button class="btn btn-primary" bindtap="submitReply" disabled="{{submitting}}">提交完成</button>
      </view>
    </view>
  </view>
</view>
