<scroll-view scroll-y class="page">
  <view class="head-bar" wx:if="{{list.length}}">
    <text class="hb-title">{{unread > 0 ? '未读 ' + unread + ' 条' : '全部已读'}}</text>
    <text class="hb-action" wx:if="{{unread > 0}}" bindtap="markAllRead">全部已读</text>
  </view>

  <view wx:if="{{list.length}}">
    <view wx:for="{{list}}" wx:key="id" class="noti-item {{item.read ? '' : 'unread'}}" bindtap="openMeeting" data-meeting-id="{{item.meetingId}}" data-id="{{item.id}}" data-type="{{item.type}}">
      <view class="ni-dot" wx:if="{{!item.read}}"></view>
      <view class="ni-body">
        <view class="ni-head">
          <text class="ni-type {{item.type}}">{{item.type === 'notice' ? '会议通知' : item.type === 'owner_notice' ? '已停用通知' : item.type === 'reception' ? '接待事项' : '会议材料'}}</text>
          <text class="ni-time">{{item._time}}</text>
        </view>
        <text class="ni-title">{{item.title}}</text>
        <text class="ni-content">{{item.content}}</text>
      </view>
      <text class="ni-arrow">›</text>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text wx:if="{{!loading}}">暂无通知</text>
    <text wx:else>加载中...</text>
  </view>
</scroll-view>
