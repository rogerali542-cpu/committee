.page { min-height: 100vh; background: #f5f5f5; padding: 12px; }
.intro { font-size: 12px; color: #aaa; display: block; margin-bottom: 12px; text-align: center; }
.info-card {
  background: #fff; border-radius: 14px; padding: 14px;
  margin-bottom: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.ic-tag { font-size: 10px; background: #E8F7EE; color: #27AE60; padding: 2px 8px; border-radius: 8px; }
.ic-title { font-size: 15px; font-weight: 600; display: block; margin: 8px 0; }
.ic-meta { font-size: 12px; color: #888; display: flex; gap: 12px; margin-bottom: 8px; }
.ic-desc { font-size: 12px; color: #aaa; }
