.page { padding: 16px 12px; background: #f5f5f5; min-height: 100vh; }
.hub-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.mt-card {
  background: #fff; border-radius: 18px; padding: 22px 14px;
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06); position: relative;
}
.mt-icon { width: 58px; height: 58px; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 28px; }
.mt-title { font-size: 14px; font-weight: 600; color: #333; }
.mt-desc { font-size: 11px; color: #aaa; text-align: center; }
.mt-badge {
  position: absolute; top: 10px; right: 10px;
  background: #FFA800; color: #fff;
  font-size: 10px; font-weight: 700; padding: 1px 7px; border-radius: 10px;
}
.hub-tip {
  margin-top: 16px; background: #FFFBF0; border-radius: 12px; padding: 12px 14px;
  border: 1px solid #FFE9A0; font-size: 12px; color: #B8860B; line-height: 1.6;
}
