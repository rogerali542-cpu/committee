<view class="page">
  <!-- 顶部分类切换 -->
  <view class="tabs">
    <view class="tab {{tab==='committee'?'active':''}}" bindtap="switchTab" data-tab="committee">业委会会议 <text class="tab-count">{{counts.committee}}</text></view>
    <view class="tab {{tab==='learning'?'active':''}}" bindtap="switchTab" data-tab="learning">学习培训 <text class="tab-count">{{counts.learning}}</text></view>
  </view>

  <view class="list">
    <block wx:if="{{items.length}}">
      <view class="lib-card" wx:for="{{items}}" wx:key="id"
            bindtap="openDetail" data-id="{{item.id}}" data-kind="{{item.kind}}">
        <view class="lc-main">
          <text class="lc-title">{{item.title}}</text>
          <view class="lc-meta">
            <text wx:if="{{item.date}}">{{item.date}}</text>
            <text class="lc-dot" wx:if="{{item.date && item.metaText}}">·</text>
            <text wx:if="{{item.metaText}}">{{item.metaText}}</text>
          </view>
        </view>
        <view class="lc-right">
          <text class="lc-status">{{item.statusText}}</text>
          <text class="lc-arrow">›</text>
        </view>
      </view>
    </block>
    <view wx:elif="{{!loading}}" class="empty-state">
      <text class="empty-emoji">📚</text>
      <text>该分类暂无归档</text>
    </view>
  </view>
</view>
