.page { min-height:100vh; background:#f5f5f5; padding:12px; }
.card { background:#fff; border-radius:14px; padding:14px; margin-bottom:10px; box-shadow:0 2px 8px rgba(0,0,0,0.05); }
.user-head { display:flex; align-items:center; gap:10px; }
.uh-name { font-size:15px; font-weight:600; color:#333; }
.uh-role { font-size:12px; background:#FFF6E5; color:#FFA800; padding:2px 10px; border-radius:8px; }
.uh-arrow { margin-left:auto; font-size:14px; color:#ccc; }

.perm-panel { margin-top:10px; padding-top:10px; border-top:1px solid #f0f0f0; }
.perm-note { font-size:11px; color:#bbb; display:block; margin-bottom:8px; }
.perm-list { display:flex; flex-direction:column; gap:2px; }
.perm-item { display:flex; align-items:center; justify-content:space-between; padding:8px 0; border-bottom:1px solid #fafafa; }
.pi-name { font-size:13px; color:#555; }
.perm-actions { margin-top:10px; text-align:center; }
