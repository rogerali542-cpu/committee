.profile-scroll { min-height: 100vh; background: #f5f5f5; }

/* Header */
.profile-header {
  padding: 50px 20px 30px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ph-avatar {
  width: 80px; height: 80px;
  border-radius: 50%;
  background: rgba(255,255,255,0.35);
  font-size: 32px; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 12px;
  border: 3px solid rgba(255,255,255,0.6);
}
.ph-name { font-size: 20px; font-weight: 700; margin-bottom: 6px; }
.ph-role-chip {
  font-size: 12px; font-weight: 600;
  padding: 3px 14px; border-radius: 20px;
}
.ph-desc { font-size: 12px; margin-top: 6px; }

/* Stats */
.stats-row {
  display: flex;
  margin: -16px 12px 0;
  background: #fff; border-radius: 14px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  overflow: hidden;
  position: relative; z-index: 2;
}
.stat-item {
  flex: 1;
  display: flex; flex-direction: column; align-items: center;
  padding: 14px 0; gap: 3px;
}
.stat-item:not(:last-child) { border-right: 1px solid #f0f0f0; }
.stat-num { font-size: 20px; font-weight: 700; color: #333; }
.stat-label { font-size: 11px; color: #999; }

/* Section */
.section-header {
  font-size: 12px; color: #aaa; font-weight: 500;
  padding: 16px 16px 4px; letter-spacing: 0.3px;
}
.section {
  margin: 0 12px;
  background: #fff; border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
}

/* Basic info row */
.s-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 13px 16px;
  border-top: 1px solid #f5f5f5;
}
.s-row:first-child { border-top: none; }
.s-label { font-size: 14px; color: #555; }
.s-value { font-size: 14px; color: #333; font-weight: 500; }
.role-tag { color: #FFA800; font-weight: 600; }
.role-tag.recorder { color: #9B59B6; }

/* Menu row */
.menu-row {
  display: flex; align-items: center; gap: 12px;
  padding: 14px 16px;
  border-top: 1px solid #f5f5f5;
}
.menu-row:first-child { border-top: none; }
.menu-row.active { background: #FFFBF0; }
.menu-icon {
  width: 36px; height: 36px; border-radius: 10px;
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px;
}
.menu-label { flex: 1; font-size: 14px; color: #333; }
.menu-value { font-size: 13px; color: #bbb; }
.menu-arrow { font-size: 18px; color: #ccc; }
.menu-check { font-size: 16px; color: #FFA800; font-weight: 700; }

/* Identity group */
.menu-role-tag { font-size: 10px; padding: 2px 7px; border-radius: 6px; background: #f0f0f0; color: #888; }
.menu-role-tag.chair { background: #FFF3DC; color: #FFA800; }
.menu-role-tag.recorder { background: #F5EEF8; color: #9B59B6; }

/* ID avatar colors */
.id-avatar-chair { background: linear-gradient(135deg,#FFCC44,#FFA800); color: #fff; }
.id-avatar-member { background: linear-gradient(135deg,#FFCC44,#FFA800); color: #fff; }
.id-avatar-recorder { background: linear-gradient(135deg,#BB8FCE,#9B59B6); color: #fff; }

/* Logout */
.logout-btn {
  margin: 16px 12px 24px;
  width: calc(100% - 24px);
  padding: 14px;
  background: #fff; border-radius: 14px;
  color: #E74C3C; font-size: 15px; font-weight: 600;
  text-align: center;
  border: none;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
}

/* 通知未读红点 */
.badge {
  min-width: 20px; height: 20px; line-height: 20px; text-align: center;
  background: #E74C3C; color: #fff; font-size: 11px; font-weight: 700;
  border-radius: 10px; padding: 0 6px; margin-right: 4px;
}
